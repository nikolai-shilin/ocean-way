# Copy to .env.local (or run `vercel env pull`). Never commit real values.
NEXT_PUBLIC_SITE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Shared with the database (Vault: revalidate_secret); lets it refresh pages after edits. Optional locally.
REVALIDATE_SECRET=
# Scripts only (import_theory.py, data loads); never used by the site.
SUPABASE_SERVICE_ROLE_KEY=
