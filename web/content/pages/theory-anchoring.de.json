0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/de\" aria-label=\"Ocean Way, Startseite\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Hauptmenü\">\n      <a class=\"navl\" href=\"/de#courses\">Kurse</a>\n      <a class=\"navl\" href=\"/de#passages\">Törns</a>\n      <a class=\"navl on\" href=\"/de/theory\">Theorie</a>\n      <a class=\"navl\" href=\"/de#fleet\">Flotte</a>\n      <a class=\"navl\" href=\"#\">Preise</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Sprache: Deutsch\">DE</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/anchoring\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/anchoring\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/anchoring\" hreflang=\"de\" lang=\"de\" aria-current=\"true\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/anchoring\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Farbschema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Gemerkt\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Konto\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Navigationspfad\"><ol><li><a href=\"/de\">Startseite</a></li><li><a href=\"/de/theory\">Theorie</a></li><li aria-current=\"page\">Hafen und Ankerplatz</li></ol></nav>\n        <h1 class=\"display\">Ankern: Platz, Kettenlänge, Halt</h1>\n        <p class=\"lead\">Ein sicherer Ankerplatz hängt von drei Entscheidungen ab: wo du den Anker fallen lässt, wie viel Kette du steckst und ob der Anker wirklich eingegraben ist. Dieser Leitfaden geht jede davon durch.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ausbilder von Ocean Way</span><span class=\"meta\">Aktualisiert am 1. Nov. 2026</span><span class=\"meta\">6 Min. Lesezeit</span><span class=\"lvl\">Bareboat Skipper</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>Auf dieser Seite<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#choose-bay\">Die Bucht wählen</a></li><li><a href=\"#scope\">Kettenlänge</a></li><li><a href=\"#set\">Anker eingraben</a></li><li><a href=\"#secure\">Für die Nacht sichern</a></li><li><a href=\"#shore-lines\">Landleinen</a></li><li><a href=\"#weigh\">Anker auf</a></li><li><a href=\"#practise\">Selbst üben</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Kurz gesagt</span><ul><li>Wähl eine Bucht, die vor dem angesagten Wind geschützt ist, mit Sand oder Schlick und genug Raum zum Schwojen.</li><li>Steck mindestens das 4- bis 5-Fache der Wassertiefe an Kette, mehr, wenn Wind kommt.</li><li>Anker absenken, bei Rückwärtsfahrt Kette stecken, dann mit Rückwärtsschub eindampfen und mit einer Deckpeilung prüfen.</li><li>Einen Snubber anbringen, einen Ankeralarm setzen und, wenn möglich, über den Anker schnorcheln und nachsehen.</li></ul></div>\n          <section id=\"choose-bay\">\n<h2>Die Bucht wählen</h2>\n<p>Eine gute Nacht vor Anker entscheidet sich, bevor du irgendetwas absenkst. Fang mit dem Wetterbericht an, nicht mit der Aussicht. Schau dir den Wind an, der über Nacht und morgen früh erwartet wird, und such dann eine Bucht, die in andere Richtungen offen sein darf, aber zu dieser Richtung hin geschlossen ist.</p>\n<ul>\n<li><b>Schutz.</b> Zwischen dir und dem angesagten Wind sollte Land liegen. Achte auf Winde, die im Lauf der Nacht drehen. In der Ägäis kann ein Meltemi (der starke Nordwind im Sommer) kräftig in eine Bucht wehen, die mittags noch ruhig aussah, und nachts können Fallböen von hohem Land herabkommen.</li>\n<li><b>Ankergrund.</b> Sand und Schlick halten gut. Kraut, auch die im Mittelmeer verbreiteten Seegraswiesen, hält schlecht, weil der Anker darüber rutscht. Fels bietet keinen verlässlichen Halt und kann den Anker einklemmen. In manchen Gebieten ist das Ankern im Seegras eingeschränkt, prüf also die örtlichen Regeln.</li>\n<li><b>Tiefe.</b> Etwa 4 bis 12 Meter passen für die meisten Charteryachten. Zu flach, und du setzt bei Niedrigwasser oder beim Schwojen vielleicht auf. Zu tief, und die Kette reicht nicht.</li>\n<li><b>Schwojraum.</b> Um deinen Anker brauchst du einen freien Kreis, mindestens so groß wie deine Kettenlänge plus die Bootslänge.</li>\n</ul>\n<p>Seekarte und ein gutes Hafenhandbuch zeigen Grundbeschaffenheit und Tiefen. Deine Augen und das Echolot bestätigen sie.</p>\n</section>\n<section id=\"scope\">\n<h2>Kettenlänge: wie viel Kette</h2>\n<p><b>Kettenlänge</b> ist die Länge der gesteckten Kette im Verhältnis zur Wassertiefe. Bei reinem Kettenvorlauf (die Verbindung zwischen Anker und Boot) nimm <b>mindestens das 4- bis 5-Fache der Tiefe</b> bei ruhigem Wetter und mehr, wenn Wind angesagt ist. Miss die Tiefe ab der Bugrolle, rechne also etwa einen Meter zur Anzeige des Echolots dazu. Der Tidenhub ist im größten Teil des Mittelmeers gering, wo er größer ist, nimm die Tiefe bei Hochwasser.</p>\n<p>In der Tabelle bedeutet Tiefe die Echolottiefe plus die Höhe der Bugrolle.</p>\n<table class=\"tbl\">\n<thead><tr><th>Tiefe</th><th>Kette, ruhig</th><th>Kette, windig</th></tr></thead>\n<tbody>\n<tr><td>3 m</td><td>15 m</td><td>20–25 m</td></tr>\n<tr><td>5 m</td><td>25 m</td><td>35 m</td></tr>\n<tr><td>8 m</td><td>40 m</td><td>50–55 m</td></tr>\n<tr><td>10 m</td><td>50 m</td><td>60–70 m</td></tr>\n<tr><td>15 m</td><td>60–75 m</td><td>alles, was du hast</td></tr>\n</tbody>\n</table>\n<p>Charteryachten haben meist 50 bis 80 Meter Kette, das ist unterschiedlich, also finde vor dem Ablegen heraus, wie viel du hast. Die Kette ist meist alle 10 Meter mit Farbe oder farbigen Markern gekennzeichnet. Lerne den Code auf deinem Boot.</p>\n<p>Mehr Kettenlänge zählt, weil der Anker am besten hält, wenn der Zug waagerecht ist. Das Gewicht der Kette auf dem Grund hält den Zugwinkel flach und dämpft das Einrucken, wenn sich das Boot bewegt.</p>\n</section>\n<section id=\"set\">\n<h2>Anker absenken und eingraben</h2>\n<ol>\n<li>Fahr langsam in die Bucht und such dir den Platz aus. Bedenke, wo das Boot liegen wird, wenn die Kette gesteckt ist.</li>\n<li>Fahr mit dem Bug in den Wind an und stopp das Boot über dem Platz.</li>\n<li><b>Fiere</b> den Anker mit der Ankerwinsch bis zum Grund ab. Lass ihn nicht frei fallen. Ein Haufen Kette auf dem Anker kann ihn unklar machen.</li>\n<li>Während das Boot zurücktreibt oder du langsam rückwärts fährst, steck gleichmäßig Kette, damit sie in einer Linie auf dem Grund liegt und sich nicht auftürmt.</li>\n<li>Wenn die geplante Kettenlänge draußen ist, halt die Kette fest und lass das Boot in die Kette einrucken. Du spürst, wie der Bug zum Anker herumschwenkt.</li>\n<li>Grab ihn mit Rückwärtsschub ein: Steigere langsam auf kräftige Rückwärtsfahrt und halte sie 20 bis 30 Sekunden. Bewegt sich das Boot weiter, slippt der Anker. Hol ihn hoch und versuch es noch einmal.</li>\n</ol>\n<p>Prüf mit einer <b>Deckpeilung</b>, ob er hält: zwei feste Objekte an Land, die in Linie stehen, etwa ein Felsen vor einem Gebäude, ungefähr querab (rechtwinklig zum Boot). Bleiben sie bei Rückwärtsschub in Linie, bewegst du dich nicht. Eine Kompasspeilung auf einen festen Punkt geht auch. Prüf nach einer Weile noch einmal und immer, wenn der Wind zunimmt.</p>\n</section>\n<section id=\"secure\">\n<h2>Für die Nacht sichern</h2>\n<p>Wenn der Anker eingegraben ist, bring einen <b>Snubber</b> an: ein Stück dehnbare Leine, das in die Kette gehakt und auf einer Bugklampe belegt wird. Steck noch etwas Kette nach, damit der Snubber die Last trägt. Er entlastet die Ankerwinsch und verhindert, dass die Kette ruckartig am Boot reißt. Katamarane nutzen eine <b>Hahnepot</b>, einen Snubber mit zwei Armen zu beiden Bugen.</p>\n<p>Setz einen <b>Ankeralarm</b>. Bei den meisten Kartenplottern und vielen Handy-Apps kannst du die Ankerposition markieren und einen Alarm auslösen lassen, wenn das Boot einen festgelegten Radius verlässt. Stell den Radius auf etwa Kettenlänge plus Bootslänge, damit normales Schwojen ihn nicht auslöst.</p>\n<p>Schau dir die Boote um dich herum an. Yachten an Kette schwojen anders als Boote an Leine, und Katamarane bewegen sich anders als Einrumpfboote. Ankerst du zu nah, triffst du dich vielleicht um 3 Uhr nachts nach einer Winddrehung. Nach altem Brauch hat das zuerst angekommene Boot den stärkeren Anspruch auf seinen Platz. Bist du der Neuankömmling, liegt es an dir, Raum zu lassen.</p>\n<aside class=\"note\"><b>Tipp</b><p>Im klaren Mittelmeerwasser ist Hinschauen die beste Kontrolle überhaupt. Setz Maske und Schnorchel auf und schwimm über den Anker. Du siehst, ob er sich eingegraben hat, auf der Seite liegt oder sich in einem Krautfeld verfangen hat. Ein paar Minuten im Wasser können dir eine schlaflose Nacht ersparen.</p></aside>\n</section>\n<section id=\"shore-lines\">\n<h2>Landleinen in der Türkei und in Griechenland</h2>\n<p>In vielen kleinen Buchten an der Lykischen Küste, rund um Göcek und in Teilen Griechenlands ist kein Platz zum Schwojen. Stattdessen lässt du den Anker fallen, fährst rückwärts aufs Ufer zu und bringst eine Leine vom Heck zu einem Felsen, Baum oder Ring an Land. In manchen Buchten gibt es dafür feste Poller oder Ringe.</p>\n<ul>\n<li>Lass den Anker weit draußen fallen, wie beim römisch-katholischen Anlegen, damit genug Kette draußen ist, wenn du stoppst.</li>\n<li>Ein Crewmitglied bringt die Landleine mit dem Beiboot an Land oder schwimmt damit hin. Führ sie um den Baum oder Felsen und zurück zum Boot, damit du sie von Bord aus lösen kannst.</li>\n<li>Schütz Bäume mit einem Scheuerschutz oder einem Bandschlingen-Strop. Mach nichts fest, was sich losreißen könnte.</li>\n<li>Denk an die Windrichtung. Eine Landleine funktioniert am besten bei ablandigem Wind. Ist Wind von der Seite angesagt, nimm zwei Landleinen oder such dir eine andere Bucht.</li>\n</ul>\n</section>\n<section id=\"weigh\">\n<h2>Anker auf</h2>\n<p>Zum Ankeraufgehen bedient ein Crewmitglied die Ankerwinsch und gibt dem Rudergänger Zeichen. Fahr langsam auf die Kette zu, damit die Winsch nicht das Boot zieht. Zeig mit dem Arm die Richtung der Kette an. Steht die Kette senkrecht auf und nieder, sollte der Anker ausbrechen. Hol ihn langsam ein, spül den Schlick ab, bevor er an Bord kommt, und sichere ihn, bevor du Fahrt aufnimmst.</p>\n<p>Fahr nie über deine eigene Kette, und halte Finger und Füße von der laufenden Ankerwinsch fern.</p>\n</section>\n<section id=\"practise\">\n<h2>Auf dem Wasser üben</h2>\n<p>In unseren Kursen übst du das jeden Tag in anderen Buchten: Platz wählen, Kettenlänge berechnen und den Anker mit Motorkraft eingraben. Du bringst auch Landleinen in engen Buchten aus und schnorchelst über den Anker, um zu sehen, wie gut er sitzt.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Üben im Kurs</span><div class=\"card-title\">International Bareboat Skipper</div><p>Lerne das auf dem Wasser mit einem Ausbilder, in einer Woche an Bord.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/de/courses/bareboat-skipper\">Zum Kurs</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"Auf dieser Seite\"><span class=\"kicker\">Auf dieser Seite</span><ol class=\"toc-list\"><li><a href=\"#choose-bay\">Die Bucht wählen</a></li><li><a href=\"#scope\">Kettenlänge</a></li><li><a href=\"#set\">Anker eingraben</a></li><li><a href=\"#secure\">Für die Nacht sichern</a></li><li><a href=\"#shore-lines\">Landleinen</a></li><li><a href=\"#weigh\">Anker auf</a></li><li><a href=\"#practise\">Selbst üben</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Üben im Kurs</span><div class=\"card-title\">International Bareboat Skipper</div><p>Lerne das auf dem Wasser mit einem Ausbilder, in einer Woche an Bord.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/de/courses/bareboat-skipper\">Zum Kurs</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theorie</span><h2 class=\"h2\" style=\"margin-top:12px\">Weiterlesen</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/de/theory\">Alle Artikel</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Mehr Theorie\"><a class=\"card\" href=\"/de/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Hafenstadt im Abendlicht über dem Meer\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Römisch-katholisch anlegen, Schritt für Schritt</span><span class=\"card-meta\">Römisch-katholisch anlegen im Mittelmeer, an Mooringleinen oder am eigenen Anker: Crew-Briefing, Radeffekt, Anfahrt, gekreuzte Anker und Ablegen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/berthing-alongside\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1533105079780-92b9be482077?w=900&q=80&auto=format&fit=crop\" alt=\"Weiß getünchte Stufen hinunter zum Meer\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Längsseits anlegen und mit Springs ablegen</span><span class=\"card-meta\">Wie du längsseits an einem Kai oder Steg anlegst: Fender, Leinen und Springs, Anfahrtswinkel, Wind und Radeffekt, die erste Leine an Land, Ablegen mit der Spring und Päckchen liegen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Segelyacht hoch am Wind auf offenem Wasser\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Kurse zum Wind: Wie eine Yacht hoch am Wind segelt</span><span class=\"card-meta\">Die Kurse zum Wind von hoch am Wind bis vor dem Wind: der tote Winkel, Segeltrimm auf jedem Kurs, Wende und Halse, scheinbarer Wind und Windfäden lesen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Ein Schoner mit allen Segeln gesetzt\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Sechs Knoten, die jedes Crewmitglied braucht</span><span class=\"card-meta\">Sechs Segelknoten, die jedes Crewmitglied braucht: Palstek, Webeleinstek, Rundtörn mit zwei halben Schlägen, Klampenschlag, Achtknoten und Kreuzknoten, Schritt für Schritt.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Segler am Steuerrad unter Segeln\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Wende und Halse, Schritt für Schritt</span><span class=\"card-meta\">Wie du mit einer Segelyacht wendest und halst: Kommandos, Aufgaben der Crew, Winschen ohne Überläufer, die kontrollierte Halse, was tun, wenn das Boot im Wind steht, und Tipps für Katamarane.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Crewmitglieder arbeiten bei frischer Brise am Mast\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Reffen: wann und wie du die Segelfläche verkleinerst</span><span class=\"card-meta\">Wann und wie du auf einer Segelyacht reffst: Anzeichen, dass es Zeit ist, Bindereff Schritt für Schritt, Rollgroß, Genua einrollen, Segelbalance und Ausreffen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout-Prototyp. Preise, Termine und Personen sind Beispielinhalte. Fotos über Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Über uns</a><a href=\"#\">Telegram</a><a href=\"#\">Datenschutz</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}