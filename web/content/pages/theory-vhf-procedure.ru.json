bol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/vhf-procedure\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/vhf-procedure\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/vhf-procedure\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/vhf-procedure\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Радиосвязь и безопасность</li></ol></nav>\n        <h1 class=\"display\">Радио VHF: Mayday, Pan-Pan и обычные вызовы</h1>\n        <p class=\"lead\">Радиостанция VHF — ваша связь со спасательными службами, маринами и другими судами. Выучите каналы, фонетический алфавит и точные слова для Mayday, Pan-Pan, Sécurité и обычного вызова марины.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">5 минут чтения</span><span class=\"lvl\">Весь экипаж</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#channels\">Каналы и двойное прослушивание</a></li><li><a href=\"#phonetic\">Фонетический алфавит</a></li><li><a href=\"#dsc\">Кнопка бедствия DSC</a></li><li><a href=\"#mayday\">Mayday</a></li><li><a href=\"#pan-pan\">Pan-Pan</a></li><li><a href=\"#securite\">Sécurité</a></li><li><a href=\"#everyday\">Вызов марины</a></li><li><a href=\"#prowords\">Процедурные слова</a></li><li><a href=\"#licence\">Лицензии</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Канал 16 — для бедствия, безопасности и вызова; разговаривайте на рабочем канале.</li><li>Красная кнопка DSC автоматически передаёт ваш MMSI и координаты.</li><li>Mayday — при серьёзной и непосредственной опасности, Pan-Pan — в срочных случаях.</li><li>Чтобы работать на радиостанции, нужен SRC; яхте нужна лицензия судовой радиостанции.</li></ul></div>\n          <section id=\"channels\">\n<h2>Канал 16 и рабочие каналы</h2>\n<p>Морская радиостанция VHF работает в пределах прямой видимости, поэтому дальность связи между судами обычно 20–30 миль, а до береговой станции с высокой антенной — больше. Каналов много, но один важнее всех.</p>\n<p><b>Канал 16</b> предназначен для вызовов при бедствии, срочности и безопасности, а также для вызова другой станции. Каждое судно с VHF должно слушать его в море. На нём устанавливают связь, а затем переходят на рабочий канал, чтобы поговорить.</p>\n<ul>\n<li><b>Рабочие каналы.</b> Переговоры между судами ведут на каналах связи судно — судно, например 6, 8, 72 или 77. У каждой марины и порта свой канал, он указан в лоции.</li>\n<li><b>Канал 70</b> используется только для цифровых вызовов DSC. Голосом на нём не говорят никогда.</li>\n<li><b>Двойное прослушивание.</b> Этот режим позволяет радиостанции одновременно слушать канал 16 и ещё один канал. Он полезен при подходе к марине, но не выключайте прослушивание 16-го.</li>\n<li><b>Мощность.</b> Для близких станций, например марины, используйте малую мощность (1 Вт), а для дальней связи — большую (25 Вт).</li>\n</ul>\n</section>\n<section id=\"phonetic\">\n<h2>Фонетический алфавит</h2>\n<p>В треске эфира буквы легко спутать, поэтому слова передают по буквам с помощью международного фонетического алфавита. Числа называйте по цифрам: «one five» вместо 15.</p>\n<table class=\"tbl\"><thead><tr><th>Буква</th><th>Слово</th><th>Буква</th><th>Слово</th></tr></thead><tbody>\n<tr><td>А</td><td>Alfa</td><td>N</td><td>November</td></tr>\n<tr><td>B</td><td>Bravo</td><td>O</td><td>Oscar</td></tr>\n<tr><td>C</td><td>Charlie</td><td>P</td><td>Papa</td></tr>\n<tr><td>D</td><td>Delta</td><td>Q</td><td>Quebec</td></tr>\n<tr><td>E</td><td>Echo</td><td>R</td><td>Romeo</td></tr>\n<tr><td>F</td><td>Foxtrot</td><td>S</td><td>Sierra</td></tr>\n<tr><td>G</td><td>Golf</td><td>T</td><td>Tango</td></tr>\n<tr><td>H</td><td>Hotel</td><td>U</td><td>Uniform</td></tr>\n<tr><td>I</td><td>India</td><td>V</td><td>Victor</td></tr>\n<tr><td>J</td><td>Juliett</td><td>W</td><td>Whiskey</td></tr>\n<tr><td>K</td><td>Kilo</td><td>X</td><td>X-ray</td></tr>\n<tr><td>L</td><td>Lima</td><td>Y</td><td>Yankee</td></tr>\n<tr><td>M</td><td>Mike</td><td>Z</td><td>Zulu</td></tr>\n</tbody></table>\n</section>\n<section id=\"dsc\">\n<h2>Кнопка бедствия DSC</h2>\n<p>На большинстве современных радиостанций есть DSC (цифровой избирательный вызов). У каждого судна есть MMSI (идентификатор морской подвижной службы) — девятизначный номер, запрограммированный в радиостанцию. Если радиостанция подключена к GPS, она знает координаты судна.</p>\n<p>Чтобы подать сигнал бедствия, поднимите крышку над красной кнопкой DISTRESS и удерживайте кнопку (обычно около пяти секунд), пока радиостанция не начнёт передачу. Если есть время, сначала выберите в меню характер бедствия, например пожар или затопление. Сигнал содержит ваш MMSI, координаты и время.</p>\n<p>Что происходит дальше:</p>\n<ol>\n<li>Сигнал уходит на канале 70, а радиостанция сама переключается на канал 16.</li>\n<li>Радиостанция повторяет сигнал каждые несколько минут, пока какая-либо станция не подтвердит приём.</li>\n<li>Береговая станция или спасательный центр подтверждает приём по DSC.</li>\n<li>Затем вы передаёте голосовой вызов Mayday на канале 16 и продолжаете слушать.</li>\n</ol>\n</section>\n<section id=\"mayday\">\n<h2>Mayday</h2>\n<p>Mayday подают при <b>серьёзной и непосредственной опасности</b> для судна или человека, когда нужна немедленная помощь: неконтролируемый пожар, затопление, человек за бортом, которого вы не можете поднять. Говорите медленно и чётко на канале 16, на большой мощности. Формат:</p>\n<ol>\n<li>MAYDAY, MAYDAY, MAYDAY</li>\n<li>THIS IS и трижды название яхты</li>\n<li>Позывной и MMSI</li>\n<li>MAYDAY и название яхты</li>\n<li>Местоположение</li>\n<li>Характер бедствия</li>\n<li>Какая помощь нужна</li>\n<li>Число людей на борту</li>\n<li>Другая полезная информация</li>\n<li>OVER</li>\n</ol>\n<p>Полный пример (в эфире он звучит на английском):</p>\n<p><em>«Mayday, Mayday, Mayday. This is sailing yacht Kalimera, Kalimera, Kalimera. Call sign Sierra Victor Alfa Two, MMSI two three nine one two three four five six. Mayday Kalimera. My position two miles south of Cape Sounion. Fire in the engine compartment, out of control. I require immediate assistance. Six persons on board. We are preparing to abandon to the liferaft. Over.»</em></p>\n<p>Затем ждите. Если никто не отвечает, повторите вызов. Местоположение давайте широтой и долготой с GPS или пеленгом и расстоянием от ориентира на карте.</p>\n</section>\n<section id=\"pan-pan\">\n<h2>Pan-Pan</h2>\n<p>Pan-Pan — вызов срочности. Используйте его, когда безопасность судна или человека под угрозой, но опасность не непосредственная: отказ двигателя у подветренного берега, когда ещё есть время, серьёзная травма, сломанный руль. Структура как у Mayday, вызов адресован всем станциям.</p>\n<p><em>«Pan-Pan, Pan-Pan, Pan-Pan. All stations, all stations, all stations. This is sailing yacht Kalimera, Kalimera, Kalimera. Call sign Sierra Victor Alfa Two, MMSI two three nine one two three four five six. My position two miles south of Kalymnos. Engine failure and torn mainsail, drifting slowly, no immediate danger. I require a tow. Four persons on board. Over.»</em></p>\n</section>\n<section id=\"securite\">\n<h2>Sécurité</h2>\n<p>Sécurité (произносится «секюритэ») — вызов безопасности, для навигационных и метеорологических предупреждений. Береговые станции передают так штормовые предупреждения. Вы можете использовать его, чтобы предупредить других о плавающем контейнере или неосвещённом буе. Объявите на канале 16: «Sécurité, Sécurité, Sécurité, all stations, this is…», назовите рабочий канал, затем перейдите на него и передайте сообщение.</p>\n</section>\n<section id=\"everyday\">\n<h2>Вызов марины</h2>\n<p>Большая часть радиопереговоров — обычные. Чтобы вызвать марину, включите малую мощность и рабочий канал марины:</p>\n<p><em>«Kos Marina, Kos Marina, this is sailing yacht Kalimera, Kalimera. Over.»</em></p>\n<p>Когда вам ответят, скажите, что вам нужно: <em>«Good afternoon. We are a 12-metre yacht, beam four metres, draft two metres, requesting a berth for two nights. We are 15 minutes away. Over.»</em> Вам назначат место и часто попросят подождать снаружи маринеро (помощника по швартовке). Пока ждёте, подготовьте швартовы и кранцы.</p>\n</section>\n<section id=\"prowords\">\n<h2>Процедурные слова</h2>\n<ul>\n<li><b>Over:</b> я закончил, жду ответа.</li>\n<li><b>Out:</b> разговор окончен. Никогда не говорите «over and out».</li>\n<li><b>Say again:</b> повторите, пожалуйста.</li>\n<li><b>Received:</b> ваше сообщение принято.</li>\n<li><b>This is:</b> перед названием своего судна.</li>\n<li><b>Correction:</b> я ошибся, вот правильный вариант.</li>\n<li><b>Seelonce Mayday:</b> режим молчания. Объявляется станцией, которая руководит операцией по бедствию. Прекратите передачу на этом канале, пока не услышите <b>Seelonce Fini</b>.</li>\n</ul>\n</section>\n<section id=\"licence\">\n<h2>Лицензии</h2>\n<p>Чтобы работать на морской радиостанции VHF с DSC, нужен сертификат оператора, обычно Short Range Certificate (SRC) или равноценный. Кроме того, яхте нужна лицензия судовой радиостанции от государства флага, где указаны её позывной и MMSI. Чартерные яхты уже лицензированы, но сертификат оператора личный, и это ваша ответственность.</p>\n<aside class=\"note warn\"><b>Осторожно</b><p>Никогда не проверяйте Mayday пробной передачей — ни голосом, ни нажатием красной кнопки. Ложный сигнал может запустить настоящую спасательную операцию. Вместо этого используйте тестовый вызов DSC на своей радиостанции. Если вы подали сигнал бедствия по ошибке, не выключайте станцию. Отмените сигнал на радиостанции, затем передайте на канале 16: «All stations, all stations, all stations, this is (название яхты ×3), MMSI…, position…, cancel my distress alert of (время). Over.»</p></aside>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На наших курсах вы сначала отрабатываете каждый вызов на учебных радиостанциях, пока форматы не начнут получаться без подсказок. А на переходе уже сами ведёте настоящие повседневные переговоры: вызываете марины и другие суда на рабочих каналах.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">VHF Radio Operator</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#channels\">Каналы и двойное прослушивание</a></li><li><a href=\"#phonetic\">Фонетический алфавит</a></li><li><a href=\"#dsc\">Кнопка бедствия DSC</a></li><li><a href=\"#mayday\">Mayday</a></li><li><a href=\"#pan-pan\">Pan-Pan</a></li><li><a href=\"#securite\">Sécurité</a></li><li><a href=\"#everyday\">Вызов марины</a></li><li><a href=\"#prowords\">Процедурные слова</a></li><li><a href=\"#licence\">Лицензии</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">VHF Radio Operator</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/man-overboard\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1732267994253-4b9e4fd70a41?w=900&q=80&auto=format&fit=crop\" alt=\"Экипаж в яхтенных куртках на палубе в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Весь экипаж</span><span class=\"card-title\">Человек за бортом: как вернуть человека на борт</span><span class=\"card-meta\">Человек за бортом для экипажей яхт: профилактика, первые секунды, когда подавать Mayday, подход под мотором или под парусами и как безопасно поднять человека на борт.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/safety-on-board\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1542405242-8217b4c9e34c?w=900&q=80&auto=format&fit=crop\" alt=\"Экипаж в спасательных жилетах на палубе\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Весь экипаж</span><span class=\"card-title\">Безопасность на борту: снаряжение и инструктаж</span><span class=\"card-meta\">Безопасность на яхте для экипажа: инструктаж шкипера, спасательные жилеты 150N и страховочные обвязки, спасательный плот и аварийная сумка, EPIRB и PLB, сигнальные ракеты, пожар, газ и забортные клапаны.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Двое яхтсменов за штурвалом под парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Повороты оверштаг и фордевинд, шаг за шагом</span><span class=\"card-meta\">Как делать повороты оверштаг и фордевинд на парусной яхте: команды, обязанности экипажа, работа с лебёдкой без захлёстов, управляемый фордевинд, выход из левентика и советы для катамаранов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Двое из экипажа работают у мачты на свежем ветру\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Рифы: когда и как уменьшать парусность</span><span class=\"card-meta\">Когда и как брать рифы на парусной яхте: признаки, что пора, слаб-риф шаг за шагом, грот на закрутке в мачту, закрутка генуи, баланс парусов и отдача рифов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}