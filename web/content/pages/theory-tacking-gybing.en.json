=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/tacking-gybing\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/tacking-gybing\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/tacking-gybing\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/tacking-gybing\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Sailing basics</li></ol></nav>\n        <h1 class=\"display\">Tacking and gybing, step by step</h1>\n        <p class=\"lead\">Tacking and gybing are how a yacht changes tack, and both go smoothly when everyone knows the calls and their job. Here is each manoeuvre from the first call to the final trim.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Beginner</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#calls\">The calls</a></li><li><a href=\"#crew\">Who does what</a></li><li><a href=\"#tack\">How to tack</a></li><li><a href=\"#winches\">Winch handling</a></li><li><a href=\"#irons\">In irons</a></li><li><a href=\"#gybe\">How to gybe</a></li><li><a href=\"#risk\">Tack or gybe: the risk</a></li><li><a href=\"#catamaran\">On a catamaran</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>The helm leads with clear calls and waits until every crew member answers \"Ready\".</li><li>In a tack, release the old sheet as the headsail backs, then pull the new one in fast.</li><li>In a gybe, bring the boom to the centre first, so it crosses only a short way.</li><li>Catamarans lose speed in a tack, so build speed first and turn firmly.</li></ul></div>\n          <section id=\"calls\">\n<h2>The calls and what they mean</h2>\n<p>The helm (the person steering) leads every tack and gybe with a short set of calls, so the whole crew knows what is about to happen. Some skippers use slightly different words, so listen to the briefing.</p>\n<table class=\"tbl\"><thead><tr><th>Call</th><th>When it is said</th><th>What it means</th></tr></thead><tbody>\n<tr><td>\"Ready about\"</td><td>Before a tack</td><td>Get into position and prepare the sheets.</td></tr>\n<tr><td>\"Lee-oh\" or \"Helm's a-lee\"</td><td>As the helm starts to turn</td><td>The bow is turning through the wind now.</td></tr>\n<tr><td>\"Ready to gybe\"</td><td>Before a gybe</td><td>Prepare the sheets and centre the mainsail.</td></tr>\n<tr><td>\"Gybe-oh\"</td><td>As the stern turns through the wind</td><td>The boom is coming across now.</td></tr>\n</tbody></table>\n<p>After the first call, each crew member answers \"Ready\" once in place, and the helm waits for everyone. Before calling, the helm looks all round, including behind the headsail.</p>\n</section>\n<section id=\"crew\">\n<h2>Who does what</h2>\n<ul>\n<li><b>On the helm.</b> Gives the calls, keeps the lookout and steers through the turn at a steady rate.</li>\n<li><b>On the old sheet.</b> Releases the working sheet, the headsail sheet holding the sail now, on the leeward side (away from the wind).</li>\n<li><b>On the new sheet.</b> Pulls in the lazy sheet, the unused one on the windward side, as the sail comes across.</li>\n<li><b>On the mainsheet.</b> Handles the mainsheet and the traveller (the sliding car it is attached to). This job matters most in a gybe.</li>\n</ul>\n<p>With a small crew, one person covers several jobs. Everyone else stays clear of the sheets and below the path of the boom.</p>\n</section>\n<section id=\"tack\">\n<h2>How to tack, step by step</h2>\n<p>A tack takes you from close-hauled on one tack to close-hauled on the other, turning the bow through about 90° on most cruising yachts. Start with good speed, so the boat carries her way through the wind.</p>\n<ol>\n<li>The helm checks all round and calls \"Ready about\".</li>\n<li>Put two or three turns of the new sheet clockwise round the windward winch, pull out the slack and keep the handle within reach.</li>\n<li>Take the old sheet out of the self-tailer (the jaws on top of the winch) or off its cleat, keeping the turns on and the tail in your hand. Answer \"Ready\".</li>\n<li>The helm calls \"Lee-oh\" and turns steadily towards the wind.</li>\n<li>As the headsail starts to back (fill from the wrong side), release the old sheet. Lift the tail so the turns spin off the drum.</li>\n<li>Pull the new sheet in hand over hand while the sail crosses, before the wind loads it, then winch in the last part.</li>\n</ol>\n<p><b>Do not over-steer.</b> Stop turning on the new close-hauled course. If you carry on onto a reach, the headsail fills hard before it is in, and the crew cannot winch the last part. Turning too slowly is the opposite fault: the boat stops head to wind.</p>\n</section>\n<section id=\"winches\">\n<h2>Winches without riding turns</h2>\n<p>A riding turn is when the loaded part of the sheet climbs over the turns on the winch and jams them.</p>\n<ul>\n<li><b>Wrap clockwise.</b> Almost all yacht winches turn clockwise.</li>\n<li><b>Keep tension on the tail.</b> Slack turns under load are the usual cause. If you need both hands for the handle, use the self-tailer.</li>\n<li><b>Add turns as the load builds.</b> Two or three to pull in slack fast, three or four under full load.</li>\n<li><b>Check the lead.</b> The sheet should come onto the drum from slightly below.</li>\n</ul>\n<aside class=\"note warn\"><b>Watch out</b><p>Keep fingers clear of the drum and of the point where the sheet goes onto it. To ease a loaded sheet, hold the turns with the flat of your hand and let them slip. If you get a riding turn, stop winching and tell the skipper: the usual fix is to take the load off with another line.</p></aside>\n</section>\n<section id=\"irons\">\n<h2>If the tack stalls: in irons</h2>\n<p>Sometimes the boat stops head to wind, sails flapping, with no steering. This is being in irons. It usually follows a slow approach, a slow turn or a short chop that stops the bow.</p>\n<ol>\n<li>Hold the headsail out on the side opposite to where you want the bow to go. The wind backs it and pushes the bow away.</li>\n<li>Ease the mainsheet, so the mainsail does not push the bow back into the wind.</li>\n<li>As the boat drifts backwards, the steering works in reverse: turn the wheel the opposite way to where you want the bow to go.</li>\n<li>Once on a close reach, sheet the headsail in on the leeward side, centre the wheel and build speed.</li>\n</ol>\n<p>If you start the engine to help, first check that no lines are trailing in the water.</p>\n</section>\n<section id=\"gybe\">\n<h2>How to gybe under control</h2>\n<p>A controlled gybe keeps the swing of the boom short by bringing it to the centre first.</p>\n<ol>\n<li>From a broad reach, the helm checks all round and calls \"Ready to gybe\".</li>\n<li>Release the preventer (a line holding the boom forward) if one is rigged. Gybing against it can break the boom.</li>\n<li>The helm bears away slowly to a run while the mainsheet is pulled in until the boom is near the centreline. Everyone keeps their head low and answers \"Ready\".</li>\n<li>The helm calls \"Gybe-oh\" and turns the stern gently through the wind. The boom crosses a short distance.</li>\n<li>Ease the mainsheet out steadily on the new side, with turns kept on the winch. The helm meets the boat with a little opposite wheel, as she tends to round up (turn sharply towards the wind).</li>\n<li>Release the headsail on the old side and sheet it in on the new one.</li>\n</ol>\n<p>Keep the kicker (the vang, which holds the boom down) on throughout, so the boom cannot lift.</p>\n</section>\n<section id=\"risk\">\n<h2>Why a gybe needs more care</h2>\n<table class=\"tbl\"><thead><tr><th>What changes</th><th>In a tack</th><th>In a gybe</th></tr></thead><tbody>\n<tr><td>Passes through the wind</td><td>The bow</td><td>The stern</td></tr>\n<tr><td>Boom movement</td><td>A short way, sail empty</td><td>Right across, sail full</td></tr>\n<tr><td>Boat speed</td><td>Drops, can stall</td><td>Kept up</td></tr>\n<tr><td>Main risk</td><td>Getting stuck in irons</td><td>Injury or rig damage from the boom</td></tr>\n</tbody></table>\n<p>In a tack the sails empty as the bow passes through the wind. In a gybe they stay full, so the load hits the boom at once. The worst case is the accidental gybe described in our points of sail guide. In a strong breeze, many skippers tack round instead, turning the long way.</p>\n</section>\n<section id=\"catamaran\">\n<h2>Tacking and gybing a catamaran</h2>\n<ul>\n<li><b>Tacks are slower.</b> A catamaran is light, with no heavy keel to carry her through the wind, so she loses speed fast and stalls easily in a chop.</li>\n<li><b>Keep the speed up.</b> Sail a little freer than close-hauled to build speed, then turn firmly. Let the headsail back a moment longer to push the bows round.</li>\n<li><b>Use an engine if needed.</b> In light wind and waves, a short burst on one engine helps the bows through.</li>\n<li><b>Gybes feel calmer, but the boom is big.</b> She hardly rolls or heels, but the mainsail is large and the traveller runs on a wide track. Centre both before you turn.</li>\n</ul>\n<p>Some catamarans have a self-tacking jib, which crosses on its own track with no sheet work.</p>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On the Introduction to Yachting course you tack and gybe many times a day, taking a turn at the helm, the headsail sheets and the mainsheet. We also put the boat in irons on purpose, so you know how to sail out of it.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Introduction to Yachting</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#calls\">The calls</a></li><li><a href=\"#crew\">Who does what</a></li><li><a href=\"#tack\">How to tack</a></li><li><a href=\"#winches\">Winch handling</a></li><li><a href=\"#irons\">In irons</a></li><li><a href=\"#gybe\">How to gybe</a></li><li><a href=\"#risk\">Tack or gybe: the risk</a></li><li><a href=\"#catamaran\">On a catamaran</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Introduction to Yachting</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Two crew working at the mast in a fresh breeze\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reefing: when and how to shorten sail</span><span class=\"card-meta\">When and how to reef a sailing yacht: signs it is time, slab reefing step by step, in-mast furling mains, rolling in the genoa, sail balance and shaking out.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"A motor yacht crossing open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Right of way at sea: the rules skippers use daily</span><span class=\"card-meta\">The COLREGs a yacht skipper uses daily: lookout, safe speed, risk of collision, give-way rules for sail and power, overtaking, motorsailing and channels.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"A yacht under a starry night sky\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Navigation lights and day shapes</span><span class=\"card-meta\">Masthead, side and stern lights, tricolour, anchor light and day shapes under COLREG Part C, plus how to read fishing boats, tows and ships at night.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"A skipper at the wheel leaving harbour\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Buoys and marks: the IALA system</span><span class=\"card-meta\">Lateral, cardinal, isolated danger, safe water and special marks in IALA Region A: colours, topmarks, light rhythms and how to read a light on the chart.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}