"/><circle cx=\"12\" cy=\"12\" r=\"1.5\"/><path d=\"M12 2v4M12 18v4M2 12h4M18 12h4M4.9 4.9l2.9 2.9M16.2 16.2l2.9 2.9M19.1 4.9l-2.9 2.9M7.8 16.2l-2.9 2.9\"/></symbol>\n  <symbol id=\"i-chart\" viewBox=\"0 0 24 24\"><path d=\"M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3zM9 3v15M15 6v15\"/></symbol>\n  <symbol id=\"i-light\" viewBox=\"0 0 24 24\"><path d=\"M9 21h6M10 18h4M12 3a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/de\" aria-label=\"Ocean Way, Startseite\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Hauptmenü\">\n      <a class=\"navl\" href=\"/de#courses\">Kurse</a>\n      <a class=\"navl\" href=\"/de#passages\">Törns</a>\n      <a class=\"navl on\" href=\"/de/theory\">Theorie</a>\n      <a class=\"navl\" href=\"/de#fleet\">Flotte</a>\n      <a class=\"navl\" href=\"#\">Preise</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Sprache: Deutsch\">DE</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory\" hreflang=\"de\" lang=\"de\" aria-current=\"true\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Farbschema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Gemerkt\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Konto\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <section class=\"th-hero\">\n      <nav class=\"crumbs\" aria-label=\"Navigationspfad\"><ol><li><a href=\"/de\">Startseite</a></li><li aria-current=\"page\">Theorie</li></ol></nav>\n      <h1 class=\"display\">Segeltheorie in einfachen Worten</h1>\n      <p class=\"lead\">Was unsere Ausbilder an Bord vermitteln, aufgeschrieben: wie eine Yacht segelt, wer ausweicht, wie man anlegt, ankert, das Wetter liest und den Funk benutzt. Lies es vor einem Kurs, schlag es danach nach.</p>\n      <nav class=\"topics\" aria-label=\"Themen\"><a href=\"#basics\"><span class=\"chip\">Segelgrundlagen</span></a><a href=\"#rules\"><span class=\"chip\">Ausweichregeln</span></a><a href=\"#harbour\"><span class=\"chip\">Hafen und Ankerplatz</span></a><a href=\"#weather\"><span class=\"chip\">Wetter und Navigation</span></a><a href=\"#radio\"><span class=\"chip\">Funk und Sicherheit</span></a></nav>\n    </section>\n\n    <section class=\"sec th-topic\" id=\"basics\">\n      <div class=\"th-topic-head\"><span class=\"kicker\">4 Artikel</span><h2 class=\"h2\">Segelgrundlagen</h2><p class=\"sec-lead\">Wie sich eine Yacht bewegt, und die paar Knoten, die du jeden Tag brauchst.</p></div>\n      <div class=\"th-grid\"><a class=\"card th-card\" href=\"/de/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Segelyacht hoch am Wind auf offenem Wasser\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Kurse zum Wind: Wie eine Yacht hoch am Wind segelt</span><span class=\"card-meta\">Die Kurse zum Wind von hoch am Wind bis vor dem Wind: der tote Winkel, Segeltrimm auf jedem Kurs, Wende und Halse, scheinbarer Wind und Windfäden lesen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Ein Schoner mit allen Segeln gesetzt\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Sechs Knoten, die jedes Crewmitglied braucht</span><span class=\"card-meta\">Sechs Segelknoten, die jedes Crewmitglied braucht: Palstek, Webeleinstek, Rundtörn mit zwei halben Schlägen, Klampenschlag, Achtknoten und Kreuzknoten, Schritt für Schritt.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Segler am Steuerrad unter Segeln\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Wende und Halse, Schritt für Schritt</span><span class=\"card-meta\">Wie du mit einer Segelyacht wendest und halst: Kommandos, Aufgaben der Crew, Winschen ohne Überläufer, die kontrollierte Halse, was tun, wenn das Boot im Wind steht, und Tipps für Katamarane.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Crewmitglieder arbeiten bei frischer Brise am Mast\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Reffen: wann und wie du die Segelfläche verkleinerst</span><span class=\"card-meta\">Wann und wie du auf einer Segelyacht reffst: Anzeichen, dass es Zeit ist, Bindereff Schritt für Schritt, Rollgroß, Genua einrollen, Segelbalance und Ausreffen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n    <section class=\"sec th-topic\" id=\"rules\">\n      <div class=\"th-topic-head\"><span class=\"kicker\">3 Artikel</span><h2 class=\"h2\">Ausweichregeln</h2><p class=\"sec-lead\">Wer ausweicht, was dir die Lichter in der Nacht sagen und wie du Tonnen liest.</p></div>\n      <div class=\"th-grid\"><a class=\"card th-card\" href=\"/de/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Motoryacht auf offenem Wasser\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Ausweichregeln auf See: was Skipper täglich anwenden</span><span class=\"card-meta\">Die KVR, die ein Yachtskipper täglich anwendet: Ausguck, sichere Geschwindigkeit, Kollisionsgefahr, Ausweichregeln für Segel- und Maschinenfahrzeuge, Überholen, Motorsegeln und Fahrwasser.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Yacht unter einem Sternenhimmel\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Lichterführung und Signalkörper</span><span class=\"card-meta\">Topplicht, Seitenlichter und Hecklicht, Dreifarbenlaterne, Ankerlicht und Signalkörper nach KVR Teil C, dazu wie du Fischer, Schleppverbände und Schiffe nachts erkennst.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"Ein Skipper am Steuerrad beim Auslaufen aus dem Hafen\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Tonnen und Seezeichen: das IALA-System</span><span class=\"card-meta\">Lateral-, Kardinal-, Einzelgefahren-, Ansteuerungs- und Sonderzeichen in der IALA-Region A: Farben, Toppzeichen, Kennungen und wie du ein Feuer in der Seekarte liest.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n    <section class=\"sec th-topic\" id=\"harbour\">\n      <div class=\"th-topic-head\"><span class=\"kicker\">3 Artikel</span><h2 class=\"h2\">Hafen und Ankerplatz</h2><p class=\"sec-lead\">Einlaufen, festmachen und sicher liegen für die Nacht.</p></div>\n      <div class=\"th-grid\"><a class=\"card th-card\" href=\"/de/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Hafenstadt im Abendlicht über dem Meer\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Römisch-katholisch anlegen, Schritt für Schritt</span><span class=\"card-meta\">Römisch-katholisch anlegen im Mittelmeer, an Mooringleinen oder am eigenen Anker: Crew-Briefing, Radeffekt, Anfahrt, gekreuzte Anker und Ablegen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/berthing-alongside\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1533105079780-92b9be482077?w=900&q=80&auto=format&fit=crop\" alt=\"Weiß getünchte Stufen hinunter zum Meer\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Längsseits anlegen und mit Springs ablegen</span><span class=\"card-meta\">Wie du längsseits an einem Kai oder Steg anlegst: Fender, Leinen und Springs, Anfahrtswinkel, Wind und Radeffekt, die erste Leine an Land, Ablegen mit der Spring und Päckchen liegen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/anchoring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=900&q=80&auto=format&fit=crop\" alt=\"Boote vor Anker in einer türkisfarbenen Bucht\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Ankern: Platz, Kettenlänge, Halt</span><span class=\"card-meta\">Wie du eine Yacht ankerst: eine geschützte Bucht mit gutem Haltegrund wählen, wie viel Kette du steckst, den Anker eingraben, prüfen, ob er hält, und Landleinen ausbringen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n    <section class=\"sec th-topic\" id=\"weather\">\n      <div class=\"th-topic-head\"><span class=\"kicker\">4 Artikel</span><h2 class=\"h2\">Wetter und Navigation</h2><p class=\"sec-lead\">Wissen, was der Wind vorhat und wo du bist.</p></div>\n      <div class=\"th-grid\"><a class=\"card th-card\" href=\"/de/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Welle bricht in klarem Wasser\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Wetter lesen: Beaufort, Wetterberichte, Meltemi</span><span class=\"card-meta\">Die Beaufort-Skala, wo du Segelwetterberichte fürs Mittelmeer bekommst, wie du Böen erkennst und wie Meltemi, Scirocco und Bora eine 40-Fuß-Yacht beeinflussen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/position-fixing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534008897995-27a23e859048?w=900&q=80&auto=format&fit=crop\" alt=\"Boote in einer Bucht zwischen Klippen\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Coastal Skipper</span><span class=\"card-title\">Wo sind wir? Standortbestimmung und Koppelnavigation</span><span class=\"card-meta\">Wie du den Standort einer Yacht auf der Papierkarte bestimmst: Breite und Länge, Koppelnavigation, gegisster Ort, Kreuzpeilung, Deckpeilungen und Kompassfehler.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/tides\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1505118380757-91f5f5632de0?w=900&q=80&auto=format&fit=crop\" alt=\"Wellen treffen auf einen Sandstrand, von oben\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Coastal Skipper</span><span class=\"card-title\">Gezeiten: Höhen, Ströme und die Zwölftelregel</span><span class=\"card-meta\">Wie Gezeiten für Segler funktionieren: Spring- und Nippzeit, Kartennull, trockenfallende Höhen, Gezeitentafeln, die Zwölftelregel, Wasser unter dem Kiel und Gezeitenströme.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/passage-planning\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1764726411645-744d48aa4497?w=900&q=80&auto=format&fit=crop\" alt=\"Sextant, Uhr und Stechzirkel auf einer Seekarte\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Coastal Skipper</span><span class=\"card-title\">Einen Törn planen</span><span class=\"card-meta\">Wie du einen Törn mit der Yacht planst: Seekarten und Hafenhandbücher, Route und Wegpunkte, Sicherheitspeilungen, Timing für Tageslicht und Meltemi, Ausweichhäfen und das stündliche Logbuch.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n    <section class=\"sec th-topic\" id=\"radio\">\n      <div class=\"th-topic-head\"><span class=\"kicker\">3 Artikel</span><h2 class=\"h2\">Funk und Sicherheit</h2><p class=\"sec-lead\">Was du am Funk sagst, welche Sicherheitsausrüstung an Bord ist und was zu tun ist, wenn jemand über Bord geht.</p></div>\n      <div class=\"th-grid\"><a class=\"card th-card\" href=\"/de/theory/vhf-procedure\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1528154291023-a6525fabe5b4?w=900&q=80&auto=format&fit=crop\" alt=\"Ein Boot von oben auf dunklem Wasser\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Ganze Crew</span><span class=\"card-title\">VHF-Funk: Mayday, Pan-Pan und Alltagsanrufe</span><span class=\"card-meta\">Seefunk auf VHF in einfachen Worten: Kanal 16, DSC-Notalarm, das Buchstabieralphabet, Mayday- und Pan-Pan-Meldungen mit Beispielen und Anrufe bei der Marina.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>5 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/man-overboard\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1732267994253-4b9e4fd70a41?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Crew in Segeljacken an Deck auf offener See\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Ganze Crew</span><span class=\"card-title\">Mensch über Bord: jemanden zurückholen</span><span class=\"card-meta\">Mensch über Bord für Yachtcrews: Vorbeugung, die ersten Sekunden, wann du Mayday sendest, Bergung unter Motor oder Segeln und wie du die Person sicher zurück an Bord holst.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card th-card\" href=\"/de/theory/safety-on-board\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1542405242-8217b4c9e34c?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Crew mit Rettungswesten an Deck\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Ganze Crew</span><span class=\"card-title\">Sicherheit an Bord: Ausrüstung und Einweisung</span><span class=\"card-meta\">Yachtsicherheit für die Crew: die Sicherheitseinweisung des Skippers, 150-N-Rettungswesten und Lifebelts, Rettungsinsel und Notfalltasche, EPIRB und PLB, Seenotsignale, Feuer, Gas und Seeventile.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n    <section class=\"band tgband\" style=\"margin-top:96px\">\n      <div><span class=\"kicker\">Auf dem Wasser</span><h2 class=\"h2\" style=\"margin:12px 0 12px\">Theorie bleibt hängen, wenn du sie übst</h2><p>Jeder Artikel endet damit, wo du das Gelernte übst. Das meiste gehört zur Bareboat-Skipper-Woche: ein Skipperschein in sieben Tagen an Bord.</p></div>\n      <div><a class=\"pill pill-primary\" href=\"/de/courses/bareboat-skipper\">Zum Bareboat-Skipper-Kurs</a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout-Prototyp. Preise, Termine und Personen sind Beispielinhalte. Fotos über Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Über uns</a><a href=\"#\">Telegram</a><a href=\"#\">Datenschutz</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}