8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/es\" aria-label=\"Ocean Way, inicio\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Principal\">\n      <a class=\"navl\" href=\"/es#courses\">Cursos</a>\n      <a class=\"navl\" href=\"/es#passages\">Travesías</a>\n      <a class=\"navl on\" href=\"/es/theory\">Teoría</a>\n      <a class=\"navl\" href=\"/es#fleet\">Flota</a>\n      <a class=\"navl\" href=\"#\">Precios</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Idioma: Español\">ES</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/points-of-sail\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/points-of-sail\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/points-of-sail\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/points-of-sail\" hreflang=\"es\" lang=\"es\" aria-current=\"true\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Tema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Guardados\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Cuenta\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Ruta de navegación\"><ol><li><a href=\"/es\">Inicio</a></li><li><a href=\"/es/theory\">Teoría</a></li><li aria-current=\"page\">Nociones básicas de vela</li></ol></nav>\n        <h1 class=\"display\">Rumbos: cómo navega un velero cerca del viento</h1>\n        <p class=\"lead\">Un velero no puede navegar directo contra el viento, pero sí en casi cualquier otro ángulo. Aquí tienes los rumbos, cómo trimar en cada uno y en qué se diferencia la virada por avante de la trasluchada.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Instructores de Ocean Way</span><span class=\"meta\">Actualizado el 1 nov 2026</span><span class=\"meta\">6 min de lectura</span><span class=\"lvl\">Iniciación</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>En esta página<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#wind\">El viento y la zona muerta</a></li><li><a href=\"#points\">Los rumbos</a></li><li><a href=\"#trim\">Orzar y arribar</a></li><li><a href=\"#tacking-gybing\">Virada por avante y trasluchada</a></li><li><a href=\"#apparent-wind\">Viento real y viento aparente</a></li><li><a href=\"#telltales\">Leer los catavientos</a></li><li><a href=\"#practise\">Practícalo en el agua</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">En resumen</span><ul><li>Ninguna vela trabaja a menos de unos 45° del viento: esa es la zona muerta.</li><li>Al orzar, caza; al arribar, lasca.</li><li>En la virada por avante la proa pasa por el viento; en la trasluchada pasa la popa, y la botavara cruza de una banda a otra.</li><li>Los catavientos muestran el flujo de aire: trima o gobierna hasta que los dos fluyan hacia atrás.</li></ul></div>\n          <section id=\"wind\">\n<h2>De dónde viene el viento</h2>\n<p>En un velero todo empieza por la dirección del viento. Antes de tocar una escota (el cabo que controla una vela), averigua de dónde viene. Siéntelo en la cara y en las orejas, mira la veleta del tope del palo y observa las ondas en el agua.</p>\n<p>Una vela no puede impulsar un velero directamente contra el viento. Hay un sector, de unos 45° a cada lado del viento, en el que las velas simplemente flamean y el barco pierde velocidad. Es la zona muerta. El ángulo exacto varía según el barco y el mar: un velero de crucero moderno en agua plana puede ceñir algo más, mientras que un barco pesado con mar corta no ceñirá tanto. Si entras en la zona muerta y te paras, te quedas «aproado»: clavado proa al viento y sin gobierno.</p>\n<p>Todas las demás direcciones están abiertas. Los ángulos entre tu rumbo y el viento tienen nombre: son los rumbos.</p>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 480\" role=\"img\" aria-label=\"Rumbos alrededor del viento, con la zona muerta a unos 45 grados a cada lado del viento\"><path class=\"dg-nogo\" d=\"M320,250 L187.4,117.4 A187.5,187.5 0 0 1 452.6,117.4 Z\"/><text class=\"dg-label dg-muted\" x=\"320\" y=\"94\" text-anchor=\"middle\">Zona muerta</text><circle class=\"dg-ring\" cx=\"320\" cy=\"250\" r=\"150\"/><g class=\"dg-boat \" transform=\"translate(426.1 143.9) rotate(45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"2.1\" y2=\"9.9\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"123.9\" text-anchor=\"start\">Ceñida</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 143.9) rotate(-45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-2.1\" y2=\"9.9\"/></g><g class=\"dg-boat \" transform=\"translate(455.9 186.6) rotate(65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"6.3\" y2=\"8.6\"/></g><text class=\"dg-label\" x=\"486.8\" y=\"176.2\" text-anchor=\"start\">Descuartelar</text><g class=\"dg-boat dg-faint\" transform=\"translate(184.1 186.6) rotate(-65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-6.3\" y2=\"8.6\"/></g><g class=\"dg-boat \" transform=\"translate(470.0 250.0) rotate(90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"10.6\" y2=\"5.6\"/></g><text class=\"dg-label\" x=\"504.0\" y=\"254.0\" text-anchor=\"start\">Través</text><g class=\"dg-boat dg-faint\" transform=\"translate(170.0 250.0) rotate(-90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-10.6\" y2=\"5.6\"/></g><g class=\"dg-boat \" transform=\"translate(426.1 356.1) rotate(135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"13.6\" y2=\"1.3\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"384.1\" text-anchor=\"start\">Largo</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 356.1) rotate(-135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-13.6\" y2=\"1.3\"/></g><g class=\"dg-boat \" transform=\"translate(320.0 400.0) rotate(180)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"14.9\" y2=\"-3.7\"/></g><text class=\"dg-label\" x=\"320.0\" y=\"456.0\" text-anchor=\"middle\">Popa</text><line class=\"dg-wind\" x1=\"320\" y1=\"18\" x2=\"320\" y2=\"64\"/><path class=\"dg-windhead\" d=\"M313,56 L320,70 L327,56Z\"/><text class=\"dg-label\" x=\"332\" y=\"34\">Viento</text><text class=\"dg-label dg-muted\" x=\"496\" y=\"290\" text-anchor=\"start\">Amura de babor</text><text class=\"dg-label dg-muted\" x=\"144\" y=\"290\" text-anchor=\"end\">Amura de estribor</text></svg></div><figcaption class=\"disclaimer\">Rumbos con el viento desde arriba. Ningún velero puede navegar dentro de la zona muerta, unos 45° a cada lado del viento; los barcos de la derecha reciben el viento por babor (amura de babor) y los más tenues de la izquierda van amurados a estribor.</figcaption></figure>\n</section>\n<section id=\"points\">\n<h2>Los rumbos</h2>\n<p>Cada rumbo describe el ángulo entre la proa (la parte delantera del barco) y el viento. También importa por qué banda entra el viento: con el viento por estribor (derecha) navegas amurado a estribor, y con el viento por babor (izquierda), amurado a babor. Los nombres que siguen valen para las dos amuras.</p>\n<h3>Ceñida</h3>\n<p>Unos 45° respecto al viento, justo fuera de la zona muerta. Las dos velas van bien cazadas, cerca del eje del barco. En este rumbo el velero escora (se inclina) más, el movimiento es más vivo y puede entrar espray por proa. Se gobierna con movimientos pequeños, manteniendo las velas justo llenas.</p>\n<h3>Descuartelar</h3>\n<p>Unos 60° respecto al viento. Lasca (suelta) un poco las escotas respecto a la ceñida. El barco escora menos y normalmente gana velocidad.</p>\n<h3>Través</h3>\n<p>El viento entra a 90°, perpendicular al costado del barco. Las velas van lascadas más o menos a medias. Para la mayoría de los veleros de crucero es un rumbo rápido y cómodo, y uno bueno para aprender.</p>\n<h3>Largo</h3>\n<p>Unos 135°, con el viento entrando por detrás del través, por la aleta del barco. Las velas van bien abiertas. El barco navega más adrizado y el viento parece más flojo de lo que es. Con mar de fondo puede empezar a balancearse.</p>\n<h3>Popa</h3>\n<p>El viento entra directamente por detrás, a unos 180°. La mayor va lascada del todo y la vela de proa (la vela delantera) a menudo cuelga sin fuerza a su sombra. Puedes abrir la vela de proa por la banda contraria a la mayor: es navegar a orejas de burro. En popa es donde más fácil es una trasluchada involuntaria, por eso muchos patrones prefieren un largo y cambiar de dirección por etapas.</p>\n<table class=\"tbl\"><thead><tr><th>Rumbo</th><th>Ángulo con el viento</th><th>Velas</th><th>Sensación</th></tr></thead><tbody>\n<tr><td>Ceñida</td><td>Unos 45°</td><td>Bien cazadas</td><td>Escorado, vivo, mojado</td></tr>\n<tr><td>Descuartelar</td><td>Unos 60°</td><td>Un poco lascadas</td><td>Rápido, menos escora</td></tr>\n<tr><td>Través</td><td>90°</td><td>Lascadas a medias</td><td>Estable, cómodo</td></tr>\n<tr><td>Largo</td><td>Unos 135°</td><td>Bien abiertas</td><td>Adrizado, puede balancearse</td></tr>\n<tr><td>Popa</td><td>Unos 180°</td><td>Abiertas del todo</td><td>Calma en cubierta, balanceo</td></tr>\n</tbody></table>\n</section>\n<section id=\"trim\">\n<h2>Orzar y arribar</h2>\n<p>Girar hacia el viento se llama orzar. Alejarse de él es arribar. El trimado sigue una regla sencilla: al orzar, caza; al arribar, lasca. Cada cambio de rumbo pide un cambio de trimado.</p>\n<p>Una prueba fiable es lascar la escota hasta que el grátil (el borde delantero de la vela) empiece a flamear y luego cazarla justo hasta que deje de hacerlo. Ese es, más o menos, el reglaje adecuado para tu rumbo.</p>\n<p>Hay dos errores habituales. Las escotas demasiado cazadas a un descuartelar o de través hacen que el barco escore y pierda velocidad, aunque la vela parezca llena y tranquila. Las escotas demasiado lascadas dejan flamear la vela, lo que cuesta velocidad y desgasta la tela. En un largo o en popa, comprueba también que la botavara no apoye contra los obenques (los cables que sujetan el palo por los costados).</p>\n</section>\n<section id=\"tacking-gybing\">\n<h2>Virada por avante y trasluchada</h2>\n<p>Para pasar de una amura a la otra, haces pasar por el viento la proa o la popa.</p>\n<p><b>Virar por avante</b> es pasar la proa por el viento. Sirve para ganar barlovento, zigzagueando de ceñida en una amura a ceñida en la otra. La escota de la vela de proa se larga en la banda antigua y se caza en la nueva. La botavara apenas se mueve, porque la mayor ya va cazada. El timonel (quien gobierna) avisa «Listos para virar», la tripulación responde «Listos» y el timonel dice «Viramos» al empezar a girar.</p>\n<p><b>Trasluchar</b> es pasar la popa (la parte trasera del barco) por el viento. Se usa navegando con viento de popa. Esta vez el viento se mete detrás de la mayor y lleva la botavara de una banda a otra, a lo ancho de todo el barco. En una trasluchada controlada, el timonel avisa «Listos para trasluchar», la tripulación caza la escota de mayor para llevar la botavara al centro, el timonel gira y la escota de mayor se vuelve a lascar en la nueva banda.</p>\n<aside class=\"note warn\"><b>Atención</b><p>Una trasluchada involuntaria ocurre cuando arribas demasiado y el viento coge la mayor por detrás. Entonces la botavara cruza de golpe y sin avisar. Puede herir gravemente a quien esté en su camino y dañar la jarcia. En popa, mantén la cabeza por debajo del recorrido de la botavara, lleva el viento un poco por la banda contraria a la botavara y arma una retenida (un cabo que sujeta la botavara hacia proa) cuando el patrón lo pida.</p></aside>\n</section>\n<section id=\"apparent-wind\">\n<h2>Viento real y viento aparente</h2>\n<p>El viento real es el que notas parado en el muelle. En cuanto el barco se mueve, su propia velocidad crea una brisa, y las dos se combinan en el viento aparente: el que notas en cubierta y el que de verdad usan las velas. Navegando contra el viento, el aparente se nota más fuerte y viene más de proa que el real. Navegando a favor, se nota más flojo. Por eso un largo suave puede convertirse en una ceñida dura cuando orzas. La veleta y los catavientos siempre muestran el viento aparente.</p>\n</section>\n<section id=\"telltales\">\n<h2>Leer los catavientos</h2>\n<p>Los catavientos son tiras cortas de lana o cinta a ambos lados de la vela de proa, un poco detrás del grátil. Muestran cómo fluye el aire sobre la vela y reaccionan mucho antes de que la propia vela empiece a flamear.</p>\n<ul>\n<li><b>Los dos fluyen rectos hacia atrás:</b> la vela está bien trimada. Sigue así.</li>\n<li><b>El de barlovento se levanta o gira</b> (en la banda por la que entra el viento): la vela está demasiado abierta para tu rumbo. Caza, o arriba un poco.</li>\n<li><b>El de sotavento se levanta o gira</b> (en la banda contraria al viento): la vela está demasiado cazada. Lasca la escota, u orza un poco.</li>\n</ul>\n<p>En ceñida la escota ya va cazada a fondo, así que corriges con el timón: arriba cuando se levante el cataviento de barlovento y orza cuando lo haga el de sotavento. A un descuartelar o de través, mantén el rumbo y trima la escota. Muchas mayores también llevan catavientos en la baluma (el borde de atrás). Cuando fluyen hacia atrás, la mayor no está demasiado cazada.</p>\n</section>\n<section id=\"practise\">\n<h2>Practícalo en el agua</h2>\n<p>En el curso Introduction to Yachting navegas en todos los rumbos, turnándote al timón y en las escotas hasta que trimar por los catavientos se vuelve un hábito. Practicas viradas y trasluchadas controladas muchas veces con viento moderado antes de hacerlas con más viento.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">Introduction to Yachting</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es#courses\">Ver los cursos</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"En esta página\"><span class=\"kicker\">En esta página</span><ol class=\"toc-list\"><li><a href=\"#wind\">El viento y la zona muerta</a></li><li><a href=\"#points\">Los rumbos</a></li><li><a href=\"#trim\">Orzar y arribar</a></li><li><a href=\"#tacking-gybing\">Virada por avante y trasluchada</a></li><li><a href=\"#apparent-wind\">Viento real y viento aparente</a></li><li><a href=\"#telltales\">Leer los catavientos</a></li><li><a href=\"#practise\">Practícalo en el agua</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">Introduction to Yachting</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es#courses\">Ver los cursos</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Teoría</span><h2 class=\"h2\" style=\"margin-top:12px\">Sigue leyendo</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/es/theory\">Toda la teoría</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Más teoría\"><a class=\"card\" href=\"/es/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Una goleta con todas las velas izadas\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Seis nudos que usa todo tripulante</span><span class=\"card-meta\">Seis nudos que necesita todo tripulante: as de guía, ballestrinque, vuelta redonda y dos medios cotes, nudo de cornamusa, nudo de ocho y nudo llano, paso a paso.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Dos navegantes al timón navegando a vela\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Virada por avante y trasluchada, paso a paso</span><span class=\"card-meta\">Cómo virar por avante y trasluchar en un velero: las voces, el trabajo de cada tripulante, winches sin vueltas montadas, la trasluchada controlada, cómo salir si te quedas aproado y consejos para catamaranes.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Dos tripulantes trabajan junto al mástil con brisa fresca\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Rizos: cuándo y cómo reducir vela</span><span class=\"card-meta\">Cuándo y cómo tomar rizos en un velero: las señales de que ha llegado el momento, rizos de faja paso a paso, mayor enrollable en el mástil, enrollar el génova, equilibrio de velas y largar rizos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Un yate a motor cruzando mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Quién tiene preferencia en el mar: las reglas que un patrón usa a diario</span><span class=\"card-meta\">El RIPA que un patrón de velero aplica a diario: vigilancia, velocidad de seguridad, riesgo de abordaje, quién cede el paso a vela y a motor, alcance, navegar a vela y motor, y canales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Un velero bajo un cielo estrellado\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Luces de navegación y marcas diurnas</span><span class=\"card-meta\">Luces de tope, de costado y de alcance, tricolor, luz de fondeo y marcas diurnas según la Parte C del RIPA, y cómo reconocer de noche pesqueros, remolques y buques.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"Un patrón al timón saliendo del puerto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Boyas y marcas: el sistema IALA</span><span class=\"card-meta\">Marcas laterales, cardinales, de peligro aislado, de aguas navegables y especiales en la Región A de la IALA: colores, marcas de tope, ritmos de luz y cómo leer una luz en la carta.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Prototipo de diseño. Los precios, las fechas y las personas son contenido de ejemplo. Fotos vía Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Quiénes somos</a><a href=\"#\">Telegram</a><a href=\"#\">Privacidad</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) l