n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/position-fixing\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/position-fixing\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/position-fixing\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/position-fixing\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Погода и навигация</li></ol></nav>\n        <h1 class=\"display\">Где мы? Определение места и счисление</h1>\n        <p class=\"lead\">Картплоттер показывает, где вы, пока не перестанет. В этом руководстве — карта, счисление, определение места по пеленгам, створы и поправки компаса, чтобы вы всегда могли найти своё место на бумаге.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Прибрежный шкипер</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#chart-basics\">Основы работы с картой</a></li><li><a href=\"#why-paper\">Зачем по-прежнему нужна бумага</a></li><li><a href=\"#dead-reckoning\">Счисление</a></li><li><a href=\"#estimated-position\">Место с учётом сноса</a></li><li><a href=\"#bearing-fix\">Определение по трём пеленгам</a></li><li><a href=\"#transits-depth\">Створы и глубины</a></li><li><a href=\"#compass\">Склонение и девиация</a></li><li><a href=\"#methods\">Выбор способа</a></li><li><a href=\"#logbook\">Ведение судового журнала</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Одна минута широты — одна морская миля; измеряйте по боковой рамке.</li><li>Счисление (DR) ведут по курсу и расстоянию по лагу; EP добавляет дрейф и течение.</li><li>Маленький треугольник погрешностей — хорошая обсервация.</li><li>Истинный, склонение, магнитный, девиация, компасный: западное прибавлять, восточное вычитать.</li></ul></div>\n          <section id=\"chart-basics\">\n<h2>Основы работы с картой</h2>\n<p>Любое место на карте задаётся двумя числами. <b>Широта</b> показывает, насколько вы севернее или южнее экватора, от 0° до 90°. <b>Долгота</b> показывает, насколько вы восточнее или западнее Гринвича, от 0° до 180°. Каждый градус делится на 60 минут. Большая часть Средиземного моря лежит примерно между 30° и 46° северной широты.</p>\n<p>Одна минута широты равна одной морской миле (1852 метра). Поэтому расстояние измеряйте по шкале широт на левой или правой рамке карты, на уровне того места, где измеряете. Никогда не пользуйтесь шкалой долгот вверху и внизу: минута долготы становится короче по мере удаления от экватора.</p>\n<p><b>Нуль глубин</b> — это уровень малой воды, от которого отсчитаны глубины на карте. В большей части Средиземного моря приливы почти незаметны, так что глубины на карте близки к реальным. Проверьте также примечание о том, в какой системе координат (датуме) составлена карта. Современные карты используют WGS84, как и GPS, но некоторые старые — нет, и тогда координаты могут быть смещены.</p>\n</section>\n<section id=\"why-paper\">\n<h2>Зачем по-прежнему нужна бумага</h2>\n<p>Картплоттер — превосходный инструмент, и пользоваться им нужно. Но он зависит от питания, сухого экрана, спутникового сигнала и правильной карты. Любое из этого может отказать. Аккумуляторы садятся. Некоторые отдалённые бухты нанесены на карты по старым промерам, и электронная карта может быть смещена относительно реальности. Сигнал GPS также можно заглушить или подменить, и в последние годы о помехах неоднократно сообщали в разных частях восточного Средиземноморья.</p>\n<p>Бумажная карта, на которой место отмечается каждый час, означает, что если экран погаснет, вы знаете, где вы и где опасности. Это ещё и лучший способ понять, что показывает плоттер.</p>\n</section>\n<section id=\"dead-reckoning\">\n<h2>Счисление</h2>\n<p>Счисление (DR) — это определение места по тому, где вы были, каким курсом шли и сколько прошли. Нужны три вещи:</p>\n<ul>\n<li>последнее известное место (обсервация) со временем;</li>\n<li>курс, которым вы шли, переведённый в истинный;</li>\n<li>пройденное расстояние по лагу (прибору, который измеряет расстояние относительно воды).</li>\n</ul>\n<p>Пример: в 10:00 вы определились у Гидры, лаг показывал 12,4, а шли вы истинным курсом 090°. В 11:00 лаг показывает 18,4, значит, вы прошли 6 миль. Проведите от обсервации линию по 090°, отложите 6 миль по шкале широт и отметьте точку со временем. Это ваше счислимое место.</p>\n</section>\n<section id=\"estimated-position\">\n<h2>Место с учётом сноса</h2>\n<p>Счисление не учитывает всё, что смещает яхту вбок. Место с учётом сноса (EP) добавляет это. Отметьте его маленьким треугольником и временем.</p>\n<p><b>Дрейф</b> — это боковое смещение яхты под действием ветра. В бейдевинд (как можно круче к ветру) при свежем ветре крейсерская яхта может иметь дрейф 5–10°. При попутном ветре он близок к нулю. Чтобы оценить его, смотрите на угол между кильватерной струёй и диаметральной плоскостью. Дрейф учитывают в сторону от ветра: если ветер с левого борта, прибавляйте дрейф к курсу; если с правого — вычитайте.</p>\n<p><b>Течение.</b> Приливные течения в большей части Средиземного моря слабые, но вода всё равно движется. Течения идут через проливы и каналы, а мельтеми, дующий несколько дней, создаёт поверхностный дрейф. Обычно они слабее узла, но местами сильнее. Сверьтесь с лоцией. Если известны направление и скорость течения, отложите его от линии пути относительно воды за прошедшее время.</p>\n</section>\n<section id=\"bearing-fix\">\n<h2>Определение места по трём пеленгам</h2>\n<p>Обсервация — это место, которое вы измерили, а не оценили. Классический способ — с помощью ручного пеленгационного компаса, небольшого компаса, который подносят к глазу.</p>\n<ol>\n<li>Выберите три объекта, которые есть на карте и легко опознаются: маяк, церковь, оконечность мыса. Они должны быть хорошо разнесены, в идеале на 60° и больше друг от друга.</li>\n<li>Берите пеленги быстро. Сначала объекты впереди или позади, а объекты на траверзе (сбоку) — последними, потому что их пеленги меняются быстрее всего.</li>\n<li>Запишите время и показание лага.</li>\n<li>Переведите каждый пеленг в истинный, учтя склонение.</li>\n<li>Проложите каждую линию на карте в сторону объекта.</li>\n</ol>\n<p>Три линии почти никогда не пересекаются в одной точке. Они образуют маленький треугольник, который называют <b>треугольником погрешностей</b>. Маленький треугольник означает хорошую обсервацию. Большой — ошибку: неверно опознанный объект или неправильно прочитанный пеленг. Возьмите пеленги заново. Для безопасности считайте, что вы в той вершине треугольника, которая ближе всего к опасности.</p>\n</section>\n<section id=\"transits-depth\">\n<h2>Створы и изобаты</h2>\n<p><b>Створ</b> — это два нанесённых на карту объекта на одной линии, например знак и часовня. Когда они совмещаются, вы находитесь точно на линии, проходящей через них. Компас не нужен, значит, нет и ошибки компаса. Во многих гаванях для этого установлены створные знаки или огни. Створ — ещё и быстрый способ проверить путевой компас.</p>\n<p><b>Глубина</b> — полезная перекрёстная проверка. Если по обсервации вы на 20-метровой изобате, а эхолот показывает 45 метров, что-то не так. Знайте, что показывает ваш эхолот: глубину под датчиком, под килем или от поверхности.</p>\n</section>\n<section id=\"compass\">\n<h2>Склонение и девиация</h2>\n<p>Карты строятся относительно истинного севера. Компас указывает на магнитный север, к тому же его отклоняют металл и электрика самой яхты. Поэтому поправки вносят в два шага:</p>\n<ul>\n<li><b>Склонение</b> — это разница между истинным и магнитным севером. Оно зависит от места и года и указано на компасной розе карты. В Эгейском море оно небольшое и восточное, около 5°, и медленно меняется.</li>\n<li><b>Девиация</b> — это ошибка, которую вносит сама яхта. Она меняется с курсом яхты и указана в таблице девиации.</li>\n</ul>\n<p>Запомните порядок: <b>Истинный, склонение, магнитный, девиация, компасный</b> (по-английски его запоминают фразой «True Virgins Make Dull Companions»). При переходе от истинного курса к компасному западное прибавляют, восточное вычитают.</p>\n<p>Разберём пример: вы хотите идти истинным курсом 045°. Склонение 5° вост., значит, вычитаем: магнитный 040°. По таблице девиации на этом курсе 3° зап., значит, прибавляем: компасный 043°. Вы держите 043 по компасу. В обратную сторону, от компасного к истинному, знаки меняются.</p>\n</section>\n<section id=\"methods\">\n<h2>Выбор способа</h2>\n<table class=\"tbl\"><thead><tr><th>Способ</th><th>Что нужно</th><th>Точность</th><th>Лучше всего для</th></tr></thead><tbody>\n<tr><td>GPS</td><td>Питание, спутниковый сигнал</td><td>Метры, если карта верна</td><td>Повседневная навигация</td></tr>\n<tr><td>По трём пеленгам</td><td>Пеленгационный компас, три объекта с карты</td><td>Хорошая у берега; хуже с удалением</td><td>Прибрежное плавание, проверка GPS</td></tr>\n<tr><td>Створ</td><td>Два объекта с карты на одной линии</td><td>Очень высокая вдоль линии</td><td>Подходы к гавани, проверка компаса</td></tr>\n<tr><td>Изобата</td><td>Эхолот, карта</td><td>Только примерная линия</td><td>Перекрёстная проверка, плохая видимость</td></tr>\n<tr><td>Счисление (DR / EP)</td><td>Лаг, компас, последняя обсервация</td><td>Падает со временем</td><td>Между обсервациями, открытое море</td></tr>\n</tbody></table>\n</section>\n<section id=\"logbook\">\n<h2>Заполняйте судовой журнал каждый час</h2>\n<p>В море заполняйте журнал каждый час, а также при каждой смене курса или парусов. Записывайте время, показание лага, курс, скорость, направление и силу ветра, давление по барометру и своё место с указанием, как оно получено (GPS, обсервация или EP). Отмечайте и события: взятие рифов, запуск двигателя, замеченные объекты.</p>\n<p>Если вся электроника откажет, последняя запись в журнале станет начальной точкой нового счисления. Кроме того, это официальный документ яхты о переходе.</p>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На наших курсах вы ведёте счисление и учитываете снос на бумаге параллельно с картплоттером, определяетесь по трём пеленгам вдоль берега и сравниваете результат с GPS. Каждый час вы заполняете журнал, так что эта привычка остаётся с вами и после курса.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#chart-basics\">Основы работы с картой</a></li><li><a href=\"#why-paper\">Зачем по-прежнему нужна бумага</a></li><li><a href=\"#dead-reckoning\">Счисление</a></li><li><a href=\"#estimated-position\">Место с учётом сноса</a></li><li><a href=\"#bearing-fix\">Определение по трём пеленгам</a></li><li><a href=\"#transits-depth\">Створы и глубины</a></li><li><a href=\"#compass\">Склонение и девиация</a></li><li><a href=\"#methods\">Выбор способа</a></li><li><a href=\"#logbook\">Ведение судового журнала</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"Волна разбивается в прозрачной воде\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Читаем погоду: Бофорт, прогнозы, мельтеми</span><span class=\"card-meta\">Шкала Бофорта, где брать прогнозы погоды для Средиземноморья, как читать порывы и как мельтеми, сирокко и бора влияют на 40-футовую яхту.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Моторная яхта идёт открытым морем\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Правила расхождения в море: что шкиперы применяют каждый день</span><span class=\"card-meta\">МППСС, которые шкипер яхты применяет каждый день: наблюдение, безопасная скорость, опасность столкновения, кто уступает дорогу под парусом и под мотором, обгон, ход под парусами с мотором и фарватеры.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Яхта под звёздным ночным небом\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Навигационные огни и дневные знаки</span><span class=\"card-meta\">Топовый, бортовые и кормовой огни, трёхцветный фонарь, якорный огонь и дневные знаки по части C МППСС, а также как распознать ночью рыболовные суда, буксиры и большие суда.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"Портовый городок в огнях над морем в сумерках\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Средиземноморская швартовка шаг за шагом</span><span class=\"card-meta\">Как встать кормой к причалу в Средиземноморье на муринге или на своём якоре: инструктаж экипажа, заброс кормы от винта, подход, перехлёст якорных цепей и отход.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}