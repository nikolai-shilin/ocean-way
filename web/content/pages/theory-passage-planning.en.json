mbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/passage-planning\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/passage-planning\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/passage-planning\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/passage-planning\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Weather and navigation</li></ol></nav>\n        <h1 class=\"display\">Planning a passage</h1>\n        <p class=\"lead\">Most of a good day at sea is decided the evening before, at the chart table. This guide covers the four stages of a passage plan, from gathering information to checking your progress under way, with a worked example on the Turkish coast.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Coastal skipper</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#four-stages\">Four stages</a></li><li><a href=\"#sources\">Gathering information</a></li><li><a href=\"#route\">Route and dangers</a></li><li><a href=\"#timing\">Timing and daylight</a></li><li><a href=\"#bolt-holes\">Bolt holes</a></li><li><a href=\"#example\">Worked example</a></li><li><a href=\"#brief\">Boat and crew</a></li><li><a href=\"#monitor\">Monitoring</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>Gather information, plan, execute, then monitor.</li><li>Estimate time at 5 to 6 knots and arrive in daylight.</li><li>Choose a bolt hole and a decision point for every stretch.</li><li>Write the plan down and leave it with someone ashore.</li></ul></div>\n          <section id=\"four-stages\">\n<h2>Four stages of a passage plan</h2>\n<p>A passage plan is thinking the day through before you leave, so nothing comes as a surprise. Professional mariners use four stages, and they work just as well on a charter yacht:</p>\n<ol>\n<li><b>Gather information.</b> Charts, pilot book, forecasts, harbour details and anything that has changed recently.</li>\n<li><b>Plan.</b> Choose the route, the waypoints, the timing and the alternatives.</li>\n<li><b>Execute.</b> Brief the crew, prepare the boat and sail the plan.</li>\n<li><b>Monitor.</b> Check your progress against the plan all the way, and change it when things change.</li>\n</ol>\n<p>Many sailing books also teach a checklist under the memory word APPROACH. It covers the same ground: alternative harbours, pilotage into and out of port, dangers on the way, tides and streams, charts, communications and daylight. The exact words vary between books. What matters is that nothing is left out.</p>\n</section>\n<section id=\"sources\">\n<h2>Gather the information</h2>\n<ul>\n<li><b>Charts.</b> A small-scale chart for the whole passage and large-scale charts, or harbour plans, for the departure, the destination and any tricky stretch. Use paper and electronic charts together.</li>\n<li><b>Pilot book.</b> The sailing guide for the area. It describes harbours and anchorages, which winds they are open to, approach dangers, and where to find fuel and water.</li>\n<li><b>Almanac and notices.</b> Lights, radio channels, tide tables where they matter, and Notices to Mariners (official updates such as a new wreck, a moved buoy or a light that is out). NAVTEX and coast radio broadcast navigational warnings too.</li>\n<li><b>Forecasts.</b> At least two sources, for today and the next couple of days, so you know whether you can get back or move on.</li>\n</ul>\n</section>\n<section id=\"route\">\n<h2>Route, waypoints and dangers</h2>\n<p>Draw the route on the chart, then measure each leg on the latitude scale. Keep well off headlands, shoals and lee shores (a coast the wind is blowing onto). The shortest line is rarely the best.</p>\n<p><b>Waypoints.</b> A waypoint is a position you enter into the plotter to steer towards. Put them in clear water, never on a rock, buoy or headland, where other boats steer for the same mark. Check every leg on the largest-scale chart.</p>\n<p><b>Clearing bearings.</b> A clearing bearing is a compass bearing on a charted object that marks the edge of safe water. For example, if a reef lies off a point, you might note that you are safe while a lighthouse bears not more than 080°. Draw the line on the chart, write the bearing in your plan and check it with a hand-bearing compass.</p>\n<p><b>Safe depth contour.</b> Pick a depth contour, often 10 or 20 metres, that keeps you clear of the dangers along a coast. If the echo sounder shows less than that, you are too close, and you head out.</p>\n</section>\n<section id=\"timing\">\n<h2>Time, daylight and the afternoon wind</h2>\n<p>Estimate the time by dividing the distance by a realistic average speed. For a charter yacht, 5 to 6 knots is a fair figure, less if you are beating (sailing towards the wind) or the sea is rough. Add time for leaving and entering harbour.</p>\n<ul>\n<li><b>Daylight.</b> Check sunrise and sunset, and plan to arrive with at least an hour of light to spare. Many charter agreements do not allow sailing at night, and a strange anchorage is much harder to enter in the dark.</li>\n<li><b>Afternoon wind.</b> In summer, the sea breeze and the meltemi usually build through the day and peak in the afternoon. Leave early so the exposed stretches are behind you before the wind fills in, especially if it will be on the nose.</li>\n<li><b>Tidal gates.</b> In tidal waters, some headlands and channels can only be passed sensibly at certain states of tide, when the stream is slack or running your way. Portland Bill on the English Channel is a classic example. Work back from the gate to find your departure time. On our home waters a channel current or the wind accelerating round a cape can play the same role.</li>\n</ul>\n</section>\n<section id=\"bolt-holes\">\n<h2>Bolt holes and plan B</h2>\n<p>A bolt hole is an alternative harbour or anchorage you can run to if the weather turns, the crew is unwell or something breaks. Choose at least one for each part of the passage, and note which winds it shelters from.</p>\n<p>Set decision points too. For example: if we are not past the headland by 1100, we turn back. Deciding in advance, while everyone is calm, is far easier than deciding on a pitching boat with a tired crew.</p>\n</section>\n<section id=\"example\">\n<h2>Worked example: Kaş to Kekova</h2>\n<p>A summer day leg on the Lycian coast of Turkey, from Kaş marina east to an anchorage near Üçağız, inside the sheltered water behind Kekova Island. The total is about 16 miles. The waypoints below are illustrative, so plot your own from the chart.</p>\n<table class=\"tbl\"><thead><tr><th>Leg</th><th>Distance</th><th>Time at 5 knots</th><th>Notes</th></tr></thead><tbody>\n<tr><td>Kaş marina to a waypoint outside the bay</td><td>About 1.5 miles</td><td>About 20 minutes</td><td>Stay out of Greek waters off Kastellorizo unless you have cleared in</td></tr>\n<tr><td>Along the coast to a waypoint off the Aperlae peninsula</td><td>About 8 miles</td><td>About 1 hour 35 minutes</td><td>Keep outside the 20-metre contour; Aperlae bay is a bolt hole</td></tr>\n<tr><td>To the western entrance of the Kekova channel</td><td>About 4 miles</td><td>About 50 minutes</td><td>Identify the entrance early; reefs off the western end of the island</td></tr>\n<tr><td>Inside the channel to the anchorage near Üçağız</td><td>About 2.5 miles</td><td>About 30 minutes</td><td>No anchoring over the sunken ruins; check the pilot book</td></tr>\n<tr><td>Total</td><td>About 16 miles</td><td>About 3 hours 15 minutes</td><td>Leave 0800, at anchor by about 1130</td></tr>\n</tbody></table>\n<p>In a typical summer pattern on this coast, the afternoon wind blows from the west, so the leg runs with it behind you. Leaving at 0800 gets you in before it peaks, with time to take a shore line. If a strong southerly is forecast, the open coast is uncomfortable, and you would wait in Kaş.</p>\n</section>\n<section id=\"brief\">\n<h2>Prepare the boat and brief the crew</h2>\n<p>Check fuel and water before you go, enough for the passage and a good reserve, and note where you can refill. Check the engine, bilges and safety gear, and stow anything loose.</p>\n<p>Then brief the crew. Tell them the route, the timing, the expected weather, where the bolt holes are and who does what. Show them the life jackets, radio and first aid kit.</p>\n<p>Write the plan down: waypoints, courses, distances, times, clearing bearings, bolt holes and key radio channels. Leave a copy, or at least your route and expected arrival time, with someone ashore, such as the charter base or a friend, and tell them when to raise the alarm.</p>\n</section>\n<section id=\"monitor\">\n<h2>Monitoring under way</h2>\n<p>A plan is only useful if you check against it. Write up the log every hour and at each waypoint: time, log reading, course, speed, wind, barometer and position. Compare where you are with where the plan says you should be.</p>\n<ul>\n<li>Are you ahead or behind? Work out a new arrival time.</li>\n<li>Is the wind doing what the forecast said? If not, rethink the next leg.</li>\n<li>Is the crew coping? Fatigue and seasickness are good reasons to use a bolt hole.</li>\n</ul>\n<aside class=\"note warn\"><b>Watch out</b><p>The commonest mistake is to stick to the plan after it has stopped making sense. If you reach a decision point and the conditions are worse than expected, take the alternative. Changing the plan is good seamanship, not a failure.</p></aside>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On our courses you plan each day's passage yourself the evening before, from the chart, the pilot book and the forecast. In the morning you brief the crew, then skipper the passage, keep the log every hour and decide when to change the plan, with an instructor beside you.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#four-stages\">Four stages</a></li><li><a href=\"#sources\">Gathering information</a></li><li><a href=\"#route\">Route and dangers</a></li><li><a href=\"#timing\">Timing and daylight</a></li><li><a href=\"#bolt-holes\">Bolt holes</a></li><li><a href=\"#example\">Worked example</a></li><li><a href=\"#brief\">Boat and crew</a></li><li><a href=\"#monitor\">Monitoring</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"A wave breaking in clear water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reading the weather: Beaufort, forecasts, meltemi</span><span class=\"card-meta\">Learn the Beaufort scale, where to get Mediterranean sailing forecasts, how to read gusts, and how the meltemi, sirocco and bora affect a 40 ft yacht.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/position-fixing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534008897995-27a23e859048?w=900&q=80&auto=format&fit=crop\" alt=\"Boats in a bay between cliffs\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Coastal skipper</span><span class=\"card-title\">Where are we? Position fixing and dead reckoning</span><span class=\"card-meta\">How to fix a yacht's position on a paper chart: latitude and longitude, dead reckoning, estimated position, bearing fixes, transits and compass error.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tides\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1505118380757-91f5f5632de0?w=900&q=80&auto=format&fit=crop\" alt=\"Waves meeting a sandy shore from above\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Coastal skipper</span><span class=\"card-title\">Tides: heights, streams and the rule of twelfths</span><span class=\"card-meta\">How tides work for sailors: springs and neaps, chart datum, drying heights, tide tables, the rule of twelfths, under-keel clearance and tidal streams.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Two sailors at the wheel under sail\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Tacking and gybing, step by step</span><span class=\"card-meta\">How to tack and gybe a sailing yacht: the calls, crew jobs, winches without riding turns, a controlled gybe, getting out of irons and tips for catamarans.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}