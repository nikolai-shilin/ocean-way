a6 6 0 0 0-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/tacking-gybing\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/tacking-gybing\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/tacking-gybing\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/tacking-gybing\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Основы яхтинга</li></ol></nav>\n        <h1 class=\"display\">Повороты оверштаг и фордевинд, шаг за шагом</h1>\n        <p class=\"lead\">Повороты оверштаг и фордевинд — это то, как яхта меняет галс, и оба проходят гладко, когда каждый знает команды и свою работу. Здесь каждый манёвр от первой команды до финальной настройки парусов.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Новичкам</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#calls\">Команды</a></li><li><a href=\"#crew\">Кто что делает</a></li><li><a href=\"#tack\">Поворот оверштаг</a></li><li><a href=\"#winches\">Работа с лебёдкой</a></li><li><a href=\"#irons\">В левентике</a></li><li><a href=\"#gybe\">Поворот фордевинд</a></li><li><a href=\"#risk\">Оверштаг или фордевинд: риски</a></li><li><a href=\"#catamaran\">На катамаране</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Рулевой ведёт поворот чёткими командами и ждёт, пока каждый член экипажа ответит «Готов».</li><li>При повороте оверштаг раздайте старый шкот, когда передний парус обстенится, и быстро выберите новый.</li><li>При повороте фордевинд сначала подтяните гик к середине, чтобы он перешёл на другой борт совсем немного.</li><li>Катамараны теряют ход в повороте оверштаг, поэтому сначала наберите скорость и поворачивайте решительно.</li></ul></div>\n          <section id=\"calls\">\n<h2>Команды и что они значат</h2>\n<p>Рулевой (тот, кто стоит на руле) ведёт каждый поворот оверштаг и фордевинд короткими командами, чтобы весь экипаж знал, что сейчас произойдёт. У некоторых шкиперов слова немного другие, поэтому слушайте инструктаж.</p>\n<table class=\"tbl\"><thead><tr><th>Команда</th><th>Когда подаётся</th><th>Что означает</th></tr></thead><tbody>\n<tr><td>«К повороту оверштаг»</td><td>Перед поворотом оверштаг</td><td>Займите места и подготовьте шкоты.</td></tr>\n<tr><td>«Поворот» или «Руль под ветер»</td><td>Когда рулевой начинает поворачивать</td><td>Нос сейчас проходит линию ветра.</td></tr>\n<tr><td>«К повороту фордевинд»</td><td>Перед поворотом фордевинд</td><td>Подготовьте шкоты и выберите грот на середину.</td></tr>\n<tr><td>«Поворот фордевинд»</td><td>Когда корма проходит линию ветра</td><td>Гик сейчас перейдёт на другой борт.</td></tr>\n</tbody></table>\n<p>После первой команды каждый член экипажа, заняв место, отвечает «Готов», и рулевой ждёт всех. Перед командой рулевой осматривается вокруг, в том числе за передним парусом.</p>\n</section>\n<section id=\"crew\">\n<h2>Кто что делает</h2>\n<ul>\n<li><b>На руле.</b> Подаёт команды, ведёт наблюдение и равномерно проводит яхту через поворот.</li>\n<li><b>На старом шкоте.</b> Раздаёт рабочий шкот — тот шкот переднего паруса, который сейчас держит парус, на подветренном борту (дальнем от ветра).</li>\n<li><b>На новом шкоте.</b> Выбирает холостой шкот — свободный, на наветренном борту, — пока парус переходит.</li>\n<li><b>На гика-шкоте.</b> Работает гика-шкотом и погоном (кареткой, к которой он крепится). Важнее всего эта работа при повороте фордевинд.</li>\n</ul>\n<p>В небольшом экипаже один человек совмещает несколько обязанностей. Остальные держатся подальше от шкотов и ниже траектории гика.</p>\n</section>\n<section id=\"tack\">\n<h2>Поворот оверштаг шаг за шагом</h2>\n<p>Поворот оверштаг переводит яхту из бейдевинда одного галса в бейдевинд другого; на большинстве круизных яхт нос поворачивается примерно на 90°. Начинайте с хорошей скоростью, чтобы яхта по инерции прошла линию ветра.</p>\n<ol>\n<li>Рулевой осматривается вокруг и командует «К повороту оверштаг».</li>\n<li>Положите два-три шлага нового шкота по часовой стрелке на наветренную лебёдку, выберите слабину и держите ручку под рукой.</li>\n<li>Выньте старый шкот из самотейлера (зажима на верху лебёдки) или снимите с утки, оставив шлаги на барабане и держа хвост в руке. Ответьте «Готов».</li>\n<li>Рулевой командует «Поворот» и плавно приводится к ветру.</li>\n<li>Когда передний парус начнёт обстениваться (наполняться с обратной стороны), раздайте старый шкот. Приподнимите хвост, чтобы шлаги соскочили с барабана.</li>\n<li>Выбирайте новый шкот руками, перехватывая, пока парус переходит и ветер ещё не нагрузил его, а остаток добирайте лебёдкой.</li>\n</ol>\n<p><b>Не проскакивайте новый курс.</b> Прекратите поворот на новом курсе бейдевинд. Если уйти дальше, на полные курсы, передний парус резко наполнится до того, как его выбрали, и экипаж не сможет добрать шкот до конца. Противоположная ошибка — поворачивать слишком медленно: яхта останавливается носом к ветру.</p>\n</section>\n<section id=\"winches\">\n<h2>Лебёдки без захлёстов</h2>\n<p>Захлёст — это когда нагруженная часть шкота наползает на шлаги на лебёдке и заклинивает их.</p>\n<ul>\n<li><b>Наматывайте по часовой стрелке.</b> Почти все яхтенные лебёдки вращаются по часовой стрелке.</li>\n<li><b>Держите хвост натянутым.</b> Обычная причина — ослабшие шлаги под нагрузкой. Если для ручки нужны обе руки, пользуйтесь самотейлером.</li>\n<li><b>Добавляйте шлаги по мере роста нагрузки.</b> Два-три, чтобы быстро выбрать слабину, три-четыре под полной нагрузкой.</li>\n<li><b>Проверьте проводку.</b> Шкот должен приходить на барабан чуть снизу.</li>\n</ul>\n<aside class=\"note warn\"><b>Осторожно</b><p>Держите пальцы подальше от барабана и от места, где шкот набегает на него. Чтобы потравить нагруженный шкот, придерживайте шлаги ладонью и давайте им проскальзывать. Если случился захлёст, перестаньте крутить лебёдку и скажите шкиперу: обычно нагрузку снимают другим концом.</p></aside>\n</section>\n<section id=\"irons\">\n<h2>Если поворот не удался: левентик</h2>\n<p>Иногда яхта останавливается носом к ветру, паруса полощут, руль не слушается. Это называется «встать в левентик». Обычно так бывает, если в поворот вошли без скорости, поворачивали слишком медленно или нос остановила короткая крутая волна.</p>\n<ol>\n<li>Вынесите передний парус на борт, противоположный тому, куда вы хотите увести нос. Ветер обстенит его и оттолкнёт нос.</li>\n<li>Потравите гика-шкот, чтобы грот не загонял нос обратно к ветру.</li>\n<li>Когда яхта пойдёт назад, руль работает наоборот: поворачивайте штурвал в сторону, противоположную той, куда должен уйти нос.</li>\n<li>Выйдя на полный бейдевинд, выберите передний парус на подветренном борту, поставьте штурвал прямо и набирайте скорость.</li>\n</ol>\n<p>Если запускаете двигатель в помощь, сначала убедитесь, что за бортом в воде нет концов.</p>\n</section>\n<section id=\"gybe\">\n<h2>Управляемый поворот фордевинд</h2>\n<p>При управляемом повороте фордевинд гик проходит короткий путь, потому что его заранее подтягивают к середине.</p>\n<ol>\n<li>На курсе бакштаг рулевой осматривается вокруг и командует «К повороту фордевинд».</li>\n<li>Отдайте завал гика (конец, удерживающий гик в положении вперёд), если он заведён. Поворот против завала может сломать гик.</li>\n<li>Рулевой медленно уваливается до фордевинда, а гика-шкот тем временем выбирают, пока гик не окажется почти в диаметральной плоскости. Все держат голову пониже и отвечают «Готов».</li>\n<li>Рулевой командует «Поворот фордевинд» и плавно проводит корму через линию ветра. Гик проходит совсем немного.</li>\n<li>Равномерно травите гика-шкот на новом борту, не снимая шлагов с лебёдки. Рулевой встречает яхту небольшим обратным поворотом штурвала, потому что она стремится резко привестись (круто развернуться к ветру).</li>\n<li>Раздайте передний парус на старом борту и выберите его на новом.</li>\n</ol>\n<p>Всё это время держите выбранной оттяжку гика (она тянет гик вниз), чтобы гик не задирался.</p>\n</section>\n<section id=\"risk\">\n<h2>Почему фордевинд требует больше внимания</h2>\n<table class=\"tbl\"><thead><tr><th>Что меняется</th><th>При оверштаге</th><th>При фордевинде</th></tr></thead><tbody>\n<tr><td>Линию ветра проходит</td><td>Нос</td><td>Корма</td></tr>\n<tr><td>Движение гика</td><td>Немного, парус пустой</td><td>Через всю яхту, парус наполнен</td></tr>\n<tr><td>Скорость яхты</td><td>Падает, можно застрять</td><td>Сохраняется</td></tr>\n<tr><td>Главный риск</td><td>Застрять в левентике</td><td>Удар гиком: травма или поломка рангоута</td></tr>\n</tbody></table>\n<p>При повороте оверштаг паруса пустеют, пока нос проходит линию ветра. При фордевинде они остаются наполненными, и нагрузка сразу приходится на гик. Худший случай — случайный поворот фордевинд, о котором рассказано в нашем материале о курсах относительно ветра. В сильный ветер многие шкиперы вместо этого делают «поворот коровой»: через оверштаг, длинным путём.</p>\n</section>\n<section id=\"catamaran\">\n<h2>Повороты на катамаране</h2>\n<ul>\n<li><b>Оверштаг идёт медленнее.</b> Катамаран лёгкий, у него нет тяжёлого киля, который пронёс бы его через линию ветра, поэтому он быстро теряет ход и легко останавливается на короткой волне.</li>\n<li><b>Держите скорость.</b> Идите чуть полнее бейдевинда, чтобы набрать ход, затем поворачивайте решительно. Подержите передний парус обстененным чуть дольше, чтобы он довернул носы.</li>\n<li><b>При необходимости помогите мотором.</b> В слабый ветер на волне короткая работа одним двигателем помогает провести носы через ветер.</li>\n<li><b>Фордевинд спокойнее, но гик большой.</b> Катамаран почти не валяет и не кренит, но грот у него большой, а погон гика-шкота очень широкий. Перед поворотом поставьте на середину и то, и другое.</li>\n</ul>\n<p>На некоторых катамаранах стоит самоповоротный стаксель: он сам переходит по своему погону, без работы со шкотами.</p>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На курсе Introduction to Yachting вы делаете повороты оверштаг и фордевинд много раз в день, по очереди стоя на руле, на шкотах переднего паруса и на гика-шкоте. Мы также специально ставим яхту в левентик, чтобы вы знали, как из него выйти.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Introduction to Yachting</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#calls\">Команды</a></li><li><a href=\"#crew\">Кто что делает</a></li><li><a href=\"#tack\">Поворот оверштаг</a></li><li><a href=\"#winches\">Работа с лебёдкой</a></li><li><a href=\"#irons\">В левентике</a></li><li><a href=\"#gybe\">Поворот фордевинд</a></li><li><a href=\"#risk\">Оверштаг или фордевинд: риски</a></li><li><a href=\"#catamaran\">На катамаране</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Introduction to Yachting</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Двое из экипажа работают у мачты на свежем ветру\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Рифы: когда и как уменьшать парусность</span><span class=\"card-meta\">Когда и как брать рифы на парусной яхте: признаки, что пора, слаб-риф шаг за шагом, грот на закрутке в мачту, закрутка генуи, баланс парусов и отдача рифов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Моторная яхта идёт открытым морем\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Правила расхождения в море: что шкиперы применяют каждый день</span><span class=\"card-meta\">МППСС, которые шкипер яхты применяет каждый день: наблюдение, безопасная скорость, опасность столкновения, кто уступает дорогу под парусом и под мотором, обгон, ход под парусами с мотором и фарватеры.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Яхта под звёздным ночным небом\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Навигационные огни и дневные знаки</span><span class=\"card-meta\">Топовый, бортовые и кормовой огни, трёхцветный фонарь, якорный огонь и дневные знаки по части C МППСС, а также как распознать ночью рыболовные суда, буксиры и большие суда.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"Шкипер за штурвалом выходит из гавани\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Буи и знаки: система IALA</span><span class=\"card-meta\">Латеральные и кардинальные знаки, знаки отдельной опасности и безопасных вод, специальные знаки в регионе A системы IALA: окраска, топовые фигуры, ритмы огней и как читать огонь на карте.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}