0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/anchoring\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/anchoring\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/anchoring\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/anchoring\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Гавань и якорная стоянка</li></ol></nav>\n        <h1 class=\"display\">Постановка на якорь: место, длина цепи, держание</h1>\n        <p class=\"lead\">Надёжная якорная стоянка складывается из трёх решений: где отдать якорь, сколько вытравить цепи и действительно ли якорь забрал. В этом руководстве разбираем каждое.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Бербоут-шкипер</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#choose-bay\">Выбор бухты</a></li><li><a href=\"#scope\">Длина цепи</a></li><li><a href=\"#set\">Постановка якоря</a></li><li><a href=\"#secure\">Подготовка к ночи</a></li><li><a href=\"#shore-lines\">Береговые концы</a></li><li><a href=\"#weigh\">Съёмка с якоря</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Выбирайте бухту, укрытую от прогнозного ветра, с песком или илом и местом для разворота.</li><li>Травите цепь не меньше чем на 4–5 глубин, больше, если ожидается ветер.</li><li>Опустите якорь, травите цепь на заднем ходу, затем заглубите его задним ходом и проверьте по створу.</li><li>Заведите демпфер, включите якорную тревогу и по возможности проплывите над якорем, чтобы посмотреть.</li></ul></div>\n          <section id=\"choose-bay\">\n<h2>Выбор бухты</h2>\n<p>Хорошая ночь на якоре решается до того, как вы что-то опустили в воду. Начните с прогноза, а не с вида. Посмотрите, какой ветер ожидается ночью и завтра утром, и ищите бухту, которая может быть открыта любым другим ветрам, но закрыта от этого направления.</p>\n<ul>\n<li><b>Укрытие.</b> Между вами и прогнозным ветром должна быть суша. Следите за ветром, который меняется в течение ночи. В Эгейском море мельтеми (сильный летний северный ветер) может задуть в бухту, которая в обед казалась спокойной, а ночью с высоких берегов могут срываться катабатические шквалы.</li>\n<li><b>Грунт.</b> Песок и ил держат хорошо. Водоросли, в том числе частые в Средиземном море заросли посидонии, держат плохо: якорь скользит по ним. Скала надёжно не держит и может заклинить якорь. В некоторых районах вставать на якорь на посидонии запрещено, так что уточняйте местные правила.</li>\n<li><b>Глубина.</b> Большинству чартерных яхт подходит глубина примерно от 4 до 12 метров. Слишком мелко — можно коснуться дна в малую воду или при развороте. Слишком глубоко — не хватит цепи.</li>\n<li><b>Место для разворота.</b> Вокруг якоря нужен свободный круг радиусом не меньше длины вытравленной цепи плюс длина яхты.</li>\n</ul>\n<p>Тип грунта и глубины покажут карта и хорошая лоция. Глаза и эхолот их подтвердят.</p>\n</section>\n<section id=\"scope\">\n<h2>Длина цепи: сколько травить</h2>\n<p><b>Длина цепи</b> — это отношение вытравленной цепи к глубине. Если якорная линия (всё, что соединяет якорь и яхту) целиком из цепи, травите <b>не меньше 4–5 глубин</b> в спокойную погоду и больше, если прогнозируют ветер. Глубину считайте от носового ролика, то есть прибавляйте к показанию эхолота примерно метр. В большей части Средиземного моря приливы малы, но там, где они больше, берите глубину в полную воду.</p>\n<p>В таблице глубина — это показание эхолота плюс высота носового ролика.</p>\n<table class=\"tbl\">\n<thead><tr><th>Глубина</th><th>Цепь, спокойно</th><th>Цепь, ветрено</th></tr></thead>\n<tbody>\n<tr><td>3 м</td><td>15 м</td><td>20–25 м</td></tr>\n<tr><td>5 м</td><td>25 м</td><td>35 м</td></tr>\n<tr><td>8 м</td><td>40 м</td><td>50–55 м</td></tr>\n<tr><td>10 м</td><td>50 м</td><td>60–70 м</td></tr>\n<tr><td>15 м</td><td>60–75 м</td><td>всю, что есть</td></tr>\n</tbody>\n</table>\n<p>На чартерных яхтах обычно от 50 до 80 метров цепи, и бывает по-разному, так что узнайте, сколько у вас, до выхода с базы. Цепь обычно размечена через каждые 10 метров краской или цветными метками. Выучите разметку на своей яхте.</p>\n<p>Длинная цепь важна, потому что якорь держит лучше всего, когда тяга горизонтальна. Вес цепи, лежащей на дне, удерживает тягу низко и гасит рывки, когда яхта движется.</p>\n</section>\n<section id=\"set\">\n<h2>Отдача и постановка якоря</h2>\n<ol>\n<li>Медленно зайдите в бухту под мотором и выберите место с учётом того, где окажется яхта, когда цепь будет вытравлена.</li>\n<li>Подходите носом против ветра и остановите яхту над выбранной точкой.</li>\n<li><b>Опустите</b> якорь на дно брашпилем, а не бросайте его в свободном падении. Куча цепи поверх якоря может его запутать.</li>\n<li>Пока яхту сносит назад или вы медленно идёте задним ходом, равномерно травите цепь, чтобы она ложилась на дно линией, а не кучей.</li>\n<li>Когда вытравлена запланированная длина, застопорите цепь и дайте яхте натянуть её. Вы почувствуете, как нос развернётся к якорю.</li>\n<li>Заглубите якорь задним ходом: постепенно доведите тягу до уверенной и держите 20–30 секунд. Если яхта продолжает двигаться, якорь ползёт. Поднимите его и попробуйте снова.</li>\n</ol>\n<p>Проверьте, держит ли якорь: наметьте <b>створ</b>: два неподвижных объекта на берегу, стоящих на одной линии, например скала на фоне здания, примерно на траверзе (под прямым углом к яхте). Если на заднем ходу они остаются в створе, вы стоите на месте. Подойдёт и пеленг по компасу на неподвижный ориентир. Перепроверьте через какое-то время и каждый раз, когда ветер усиливается.</p>\n</section>\n<section id=\"secure\">\n<h2>Подготовка к ночи</h2>\n<p>Когда якорь забрал, заведите <b>демпфер (снаббер)</b>: отрезок эластичного троса, который цепляют крюком за цепь и крепят на носовой утке. Потравите ещё немного цепи, чтобы нагрузку взял демпфер. Он бережёт брашпиль и не даёт цепи дёргать яхту. На катамаранах используют <b>уздечку</b>, демпфер с двумя ветвями к носу каждого корпуса.</p>\n<p>Включите <b>якорную тревогу</b>. Большинство картплоттеров и многие приложения для телефона позволяют отметить место якоря и подают сигнал, если яхта выходит за заданный радиус. Задайте радиус примерно равным длине цепи плюс длина яхты, чтобы обычный разворот на якоре её не включал.</p>\n<p>Посмотрите на яхты вокруг. Яхты на цепи разворачиваются иначе, чем лодки на тросе, а катамараны ходят иначе, чем однокорпусные. Если встать слишком близко, после смены ветра можно встретиться в 3 часа ночи. По обычаю, у пришедшего первым больше прав на своё место, так что если новичок вы, оставить место — ваша забота.</p>\n<aside class=\"note\"><b>Совет</b><p>В прозрачной средиземноморской воде лучшая проверка — посмотреть. Наденьте маску и трубку и проплывите над якорем. Вы увидите, зарылся ли он, лежит ли на боку или зацепился за пятно водорослей. Несколько минут в воде могут избавить от бессонной ночи.</p></aside>\n</section>\n<section id=\"shore-lines\">\n<h2>Береговые концы в Турции и Греции</h2>\n<p>Во многих небольших бухтах Ликийского побережья, в районе Гёчека и местами в Греции места для разворота нет. Вместо этого вы отдаёте якорь и идёте задним ходом к берегу, а затем заводите конец с кормы на скалу, дерево или рым на берегу. В некоторых бухтах для этого установлены кнехты или рымы.</p>\n<ul>\n<li>Отдавайте якорь подальше, как при средиземноморской швартовке, чтобы к моменту остановки было вытравлено много цепи.</li>\n<li>Один член экипажа отвозит береговой конец на тузике или доплывает с ним. Обнесите его вокруг дерева или камня и верните на яхту, чтобы его можно было отдать с борта.</li>\n<li>Защищайте деревья чехлом или стропом. Не крепитесь ни к чему, что может вырваться.</li>\n<li>Учитывайте направление ветра. Береговой конец лучше всего работает, когда ветер дует с берега. Если прогнозируют боковой ветер, заведите два береговых конца или выберите другую бухту.</li>\n</ul>\n</section>\n<section id=\"weigh\">\n<h2>Съёмка с якоря</h2>\n<p>Чтобы поднять якорь, один член экипажа работает брашпилем и подаёт знаки рулевому. Плавно идите под мотором в сторону цепи, чтобы брашпиль не тянул яхту. Показывайте рукой, куда уходит цепь. Когда цепь встанет вертикально (якорь на панере), якорь должен оторваться. Поднимайте его медленно, смойте ил до того, как он окажется на борту, и закрепите, прежде чем прибавлять ход.</p>\n<p>Никогда не наезжайте на собственную цепь и держите пальцы и ноги подальше от работающего брашпиля.</p>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На наших курсах вы отрабатываете это каждый день в разных бухтах: выбираете место, рассчитываете длину цепи и заглубляете якорь задним ходом. Вы также заводите береговые концы в узких бухтах и проплываете над якорем, чтобы посмотреть, как он забрал.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#choose-bay\">Выбор бухты</a></li><li><a href=\"#scope\">Длина цепи</a></li><li><a href=\"#set\">Постановка якоря</a></li><li><a href=\"#secure\">Подготовка к ночи</a></li><li><a href=\"#shore-lines\">Береговые концы</a></li><li><a href=\"#weigh\">Съёмка с якоря</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"Портовый городок в огнях над морем в сумерках\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Средиземноморская швартовка шаг за шагом</span><span class=\"card-meta\">Как встать кормой к причалу в Средиземноморье на муринге или на своём якоре: инструктаж экипажа, заброс кормы от винта, подход, перехлёст якорных цепей и отход.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/berthing-alongside\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1533105079780-92b9be482077?w=900&q=80&auto=format&fit=crop\" alt=\"Белёные ступени, спускающиеся к морю\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Швартовка лагом и отход на шпрингах</span><span class=\"card-meta\">Как швартоваться лагом к причалу или понтону: кранцы, швартовы и шпринги, угол подхода, ветер и заброс кормы, первый конец на берег, отход на шпринге и стоянка борт к борту.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Двое яхтсменов за штурвалом под парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Повороты оверштаг и фордевинд, шаг за шагом</span><span class=\"card-meta\">Как делать повороты оверштаг и фордевинд на парусной яхте: команды, обязанности экипажа, работа с лебёдкой без захлёстов, управляемый фордевинд, выход из левентика и советы для катамаранов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Двое из экипажа работают у мачты на свежем ветру\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Рифы: когда и как уменьшать парусность</span><span class=\"card-meta\">Когда и как брать рифы на парусной яхте: признаки, что пора, слаб-риф шаг за шагом, грот на закрутке в мачту, закрутка генуи, баланс парусов и отдача рифов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}