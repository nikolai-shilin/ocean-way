0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/navigation-lights\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/navigation-lights\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/navigation-lights\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/navigation-lights\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Правила расхождения</li></ol></nav>\n        <h1 class=\"display\">Навигационные огни и дневные знаки</h1>\n        <p class=\"lead\">Ночью по огням вы узнаёте, что это за судно, куда оно идёт и кто кому уступает. Здесь — огни, которые несёт яхта, и те, что вы встретите.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Бербоут-шкипер</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#arcs\">Как устроены огни</a></li><li><a href=\"#under-sail\">Под парусами</a></li><li><a href=\"#under-engine\">Под мотором</a></li><li><a href=\"#at-anchor\">На якоре и дневные знаки</a></li><li><a href=\"#common-sights\">Что встречается ночью</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Каждый огонь светит в фиксированном секторе: топовый — 225°, бортовые — по 112,5°, кормовой — 135°.</li><li>Под парусами: бортовые и кормовой огни или трёхцветный фонарь на яхте до 20 м. Под мотором: добавьте топовый огонь и выключите трёхцветный.</li><li>На якоре: ночью один белый круговой огонь, днём один чёрный шар.</li><li>Зелёный над белым — траулер, красный над белым — другой лов, красный-белый-красный — судно, ограниченное в возможности маневрировать.</li></ul></div>\n          <section id=\"arcs\">\n<h2>Как устроены огни</h2>\n<p>Часть C МППСС (Международных правил предупреждения столкновений судов в море, Правила 20–31) определяет, какие огни и знаки должно нести каждое судно. Огни несут от захода до восхода солнца и при ограниченной видимости. Знаки — их дневной аналог: чёрные шары, конусы и ромбы.</p>\n<p>Каждый огонь светит только в фиксированном секторе, отсчитываемом от направления прямо по носу. Их определяет Правило 21:</p>\n<ul>\n<li><b>Топовый огонь</b>: белый, светит вперёд в секторе 225°, от направления прямо по носу до 22,5° позади траверза с каждого борта. Несмотря на название, на яхте его обычно ставят на передней стороне мачты, примерно на середине высоты. Яхтсмены часто называют его моторным огнём.</li>\n<li><b>Бортовые огни</b>: красный на левом борту и зелёный на правом, каждый в секторе 112,5°, от направления прямо по носу до 22,5° позади траверза.</li>\n<li><b>Кормовой огонь</b>: белый, светит назад в секторе 135°, по 67,5° в каждую сторону от направления прямо за кормой.</li>\n<li><b>Круговой огонь</b>: любого цвета, виден по всему горизонту, 360°.</li>\n</ul>\n<p>Сектора подогнаны друг к другу. Кормовой огонь закрывает ровно тот сектор, который оставляют тёмным бортовые и топовый огни, поэтому с любого направления вы видите сочетание, по которому понятно, куда направлено другое судно. Видите только зелёный — перед вами его правый борт.</p>\n<p>Минимальная дальность видимости зависит от размера судна. У судна длиной от 12 до 20 метров топовый огонь должен быть виден за 3 мили, а бортовые и кормовой — за 2 мили. У судна короче 12 метров — 2 мили для топового и кормового и 1 миля для бортовых. Огни небольшой яхты тусклые. Не думайте, что большое судно вас заметило.</p>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 380\" role=\"img\" aria-label=\"Сектора навигационных огней, вид сверху: топовый огонь — 225 градусов вперёд, красный и зелёный бортовые — по 112,5 градуса, кормовой — 135 градусов назад\"><path class=\"dg-white\" d=\"M320,215 L158.3,282.0 A175,175 0 1 1 481.7,282.0 Z\"/><path class=\"dg-green\" d=\"M320,215 L320.0,97.0 A118,118 0 0 1 429.0,260.2 Z\"/><path class=\"dg-red\" d=\"M320,215 L211.0,260.2 A118,118 0 0 1 320.0,97.0 Z\"/><path class=\"dg-white dg-stern\" d=\"M320,215 L440.1,264.7 A130,130 0 0 1 199.9,264.7 Z\"/><g class=\"dg-boat \" transform=\"translate(320.0 215.0) scale(1.7)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line style=\"display:none\" class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"0.0\" y2=\"10.0\"/></g><text class=\"dg-label\" x=\"320\" y=\"29\" text-anchor=\"middle\">Топовый огонь, белый, 225°</text><text class=\"dg-label\" x=\"516\" y=\"145\" text-anchor=\"start\">Правый борт</text><text class=\"dg-label\" x=\"516\" y=\"163\" text-anchor=\"start\">зелёный, 112,5°</text><text class=\"dg-label\" x=\"124\" y=\"145\" text-anchor=\"end\">Левый борт</text><text class=\"dg-label\" x=\"124\" y=\"163\" text-anchor=\"end\">красный, 112,5°</text><text class=\"dg-label\" x=\"320\" y=\"367\" text-anchor=\"middle\">Кормовой огонь, белый, 135°</text></svg></div><figcaption class=\"disclaimer\">Сектора огней, вид сверху. Там, где сектора сходятся, видны сразу два огня: прямо с носа — и красный, и зелёный.</figcaption></figure>\n</section>\n<section id=\"under-sail\">\n<h2>Парусная яхта под парусами</h2>\n<p>По Правилу 25 парусное судно на ходу (не на якоре, не ошвартованное и не на мели) несёт <b>бортовые и кормовой огни</b>, и больше ничего. Топового огня нет. Именно отсутствие белого огня над бортовыми говорит другим судам, что вы идёте под парусами.</p>\n<p>Парусное судно длиной менее 20 метров может вместо этого объединить все три огня в один <b>трёхцветный</b> фонарь на топе мачты или рядом с ним. Он лучше виден над волнами и потребляет меньше энергии, поэтому он есть на большинстве круизных яхт. Включают либо трёхцветный фонарь, либо огни на уровне палубы, но никогда не то и другое вместе.</p>\n<p>Правило 25 также разрешает два дополнительных круговых огня на топе мачты, красный над зелёным, вдобавок к бортовым и кормовому огням на уровне палубы. На яхтах они редкость и не должны сочетаться с трёхцветным фонарём.</p>\n</section>\n<section id=\"under-engine\">\n<h2>Под мотором и под парусами с мотором</h2>\n<p>Как только двигатель включён на передачу и толкает яхту, по правилам вы судно с механическим двигателем, даже с поднятыми парусами. Вы теряете преимущества парусного судна, и огни нужно поменять:</p>\n<ul>\n<li>Включите <b>топовый огонь</b> («моторный» огонь).</li>\n<li>Несите <b>бортовые и кормовой огни</b> на уровне палубы.</li>\n<li><b>Выключите трёхцветный фонарь.</b> Его можно использовать только под парусами. Трёхцветный фонарь с топовым огнём под ним — частая ошибка, которая сбивает с толку.</li>\n</ul>\n<p>Днём судно под парусами, которое одновременно идёт под мотором, должно нести <b>конус вершиной вниз</b>, в носовой части, там, где его лучше всего видно (Правило 25(e)). Мало кто на яхтах это делает, но это обязательно.</p>\n</section>\n<section id=\"at-anchor\">\n<h2>На якоре и другие дневные знаки</h2>\n<p>На якоре судно длиной менее 50 метров несёт один <b>белый круговой огонь</b> там, где его лучше всего видно (Правило 30). Днём оно несёт один чёрный <b>шар</b> в носовой части. Суда длиной 50 метров и больше несут два якорных огня, носовой выше кормового. В тесной якорной стоянке в Греции или Хорватии якорный огонь на топе мачты трудно заметить с тузика или с подходящей яхты; многие шкиперы вешают ещё один огонь пониже.</p>\n<p>Другие дневные знаки, которые стоит знать:</p>\n<ul>\n<li>Два конуса, вершинами друг к другу: судно занято ловом рыбы.</li>\n<li>Шар, ромб, шар: судно ограничено в возможности маневрировать.</li>\n<li>Два шара: судно лишено возможности управляться (не может маневрировать, например из-за отказа двигателя или рулевого устройства).</li>\n<li>Ромб: буксировка, длина буксира больше 200 метров.</li>\n</ul>\n</section>\n<section id=\"common-sights\">\n<h2>Что встречается ночью</h2>\n<h3>Суда с механическим двигателем</h3>\n<p>Судно с механическим двигателем длиной менее 50 метров несёт топовый огонь, бортовые огни и кормовой огонь. Прямо с носа вы видите белый над красным и зелёным. С его правого борта — белый и зелёный. С левого борта — белый и красный. С кормы — один белый кормовой огонь, который выглядит так же, как у парусного судна с кормы.</p>\n<p>Судно длиной 50 метров и больше должно нести второй топовый огонь, ближе к корме и выше первого. Пара работает как прицел. Если два белых огня стоят на одной вертикали и видны оба бортовых, судно идёт прямо на вас. Когда они расходятся, видно, в какую сторону оно поворачивает.</p>\n<h3>Рыболовные суда</h3>\n<p>Рыболовные суда несут два круговых огня на одной вертикали. <b>Зелёный над белым</b> — траление (судно тянет сеть). <b>Красный над белым</b> — другой лов, например сетями или ярусами. Если судно имеет ход относительно воды, оно добавляет бортовые и кормовой огни. В Эгейском море и вдоль побережья Турции ночью ждите небольших рыбацких лодок у самого берега.</p>\n<h3>Ограниченные в манёвре и буксировщики</h3>\n<p>Судно, <b>ограниченное в возможности маневрировать</b> из-за своей работы (например, земснаряд, кабелеукладчик или судно, принимающее топливо в море), несёт <b>красный, белый, красный</b> круговые огни на одной вертикали, а если имеет ход относительно воды, ещё и обычные ходовые огни. Судно, <b>занятое буксировкой,</b> несёт два топовых огня на одной вертикали (три, если буксир длиннее 200 метров), бортовые, кормовой и жёлтый буксировочный огонь над кормовым. Буксируемое судно несёт бортовые и кормовой огни. Никогда не проходите между буксировщиком и буксируемым судном.</p>\n<table class=\"tbl\">\n<thead><tr><th>Что вы видите</th><th>Что это</th><th>Что делать</th></tr></thead>\n<tbody>\n<tr><td>Белый над красным и зелёным</td><td>Моторное судно, встречный курс</td><td>Под мотором: поворачивайте вправо. Под парусами: следите за его пеленгом.</td></tr>\n<tr><td>Два белых на одной вертикали, красный и зелёный</td><td>Судно больше 50 м, встречный курс</td><td>Действуйте заранее и явно. Поворачивайте вправо.</td></tr>\n<tr><td>Только белый и красный</td><td>Моторное судно, его левый борт</td><td>Под мотором на пересекающихся курсах: уступаете вы. Пройдите за кормой.</td></tr>\n<tr><td>Только белый и зелёный</td><td>Моторное судно, его правый борт</td><td>Под мотором на пересекающихся курсах: уступает оно. Держите курс и следите.</td></tr>\n<tr><td>Один белый, низко</td><td>Кормовой огонь любого судна</td><td>Если вы обгоняете, уступайте дорогу.</td></tr>\n<tr><td>Зелёный над белым</td><td>Траулер</td><td>Держитесь подальше, под парусами и под мотором.</td></tr>\n<tr><td>Красный над белым</td><td>Другой лов</td><td>Держитесь в стороне. Смотрите, нет ли сетей.</td></tr>\n<tr><td>Красный, белый, красный</td><td>Ограниченное в возможности маневрировать</td><td>Держитесь в стороне. Оно не может уйти с вашего пути.</td></tr>\n<tr><td>Два или три белых на вертикали, жёлтый ближе к корме</td><td>Буксировка</td><td>Держитесь в стороне. Никогда не проходите между буксировщиком и буксируемым.</td></tr>\n<tr><td>Один белый, круговой, неподвижный</td><td>Судно на якоре</td><td>Обойдите на безопасном расстоянии. Проверьте глубину.</td></tr>\n</tbody>\n</table>\n<p>Столбец «что делать» — подсказка, а не замена правил маневрирования. Правило 18 говорит, что парусное судно уступает дорогу судам, занятым ловом рыбы, ограниченным в возможности маневрировать и лишённым возможности управляться. Что бы ни говорили правила, если компасный пеленг на огни другого судна не меняется, а дистанция сокращается, существует опасность столкновения. Действуйте заранее.</p>\n<aside class=\"note warn\"><b>Осторожно</b><p>Большое судно ночью бывает трудно оценить. Его огни могут быть высоко и теряться на фоне береговых, а милю оно проходит за несколько минут. Если сомневаетесь, меняйте курс заранее и сильно, чтобы изменение было очевидным, и при необходимости вызывайте его по VHF на 16-м канале.</p></aside>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На наших курсах вы отрабатываете это на ночных переходах: распознаёте настоящие огни из кокпита, берёте на них пеленги и решаете, кто уступает дорогу. Перед каждым ночным выходом вы также проверяете собственные огни и переключаетесь с трёхцветного фонаря на топовый огонь, когда переходите с парусов на мотор.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#arcs\">Как устроены огни</a></li><li><a href=\"#under-sail\">Под парусами</a></li><li><a href=\"#under-engine\">Под мотором</a></li><li><a href=\"#at-anchor\">На якоре и дневные знаки</a></li><li><a href=\"#common-sights\">Что встречается ночью</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Моторная яхта идёт открытым морем\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Правила расхождения в море: что шкиперы применяют каждый день</span><span class=\"card-meta\">МППСС, которые шкипер яхты применяет каждый день: наблюдение, безопасная скорость, опасность столкновения, кто уступает дорогу под парусом и под мотором, обгон, ход под парусами с мотором и фарватеры.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"Портовый городок в огнях над морем в сумерках\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Средиземноморская швартовка шаг за шагом</span><span class=\"card-meta\">Как встать кормой к причалу в Средиземноморье на муринге или на своём якоре: инструктаж экипажа, заброс кормы от винта, подход, перехлёст якорных цепей и отход.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/anchoring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=900&q=80&auto=format&fit=crop\" alt=\"Яхты на якоре в бирюзовой бухте\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Постановка на якорь: место, длина цепи, держание</span><span class=\"card-meta\">Как поставить яхту на якорь: выбор защищённой бухты с хорошим грунтом, сколько вытравить цепи, как заглубить якорь, проверить, что он держит, и завести береговые концы.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"Волна разбивается в прозрачной воде\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Читаем погоду: Бофорт, прогнозы, мельтеми</span><span class=\"card-meta\">Шкала Бофорта, где брать прогнозы погоды для Средиземноморья, как читать порывы и как мельтеми, сирокко и бора влияют на 40-футовую яхту.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}