 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/es\" aria-label=\"Ocean Way, inicio\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Principal\">\n      <a class=\"navl\" href=\"/es#courses\">Cursos</a>\n      <a class=\"navl\" href=\"/es#passages\">Travesías</a>\n      <a class=\"navl on\" href=\"/es/theory\">Teoría</a>\n      <a class=\"navl\" href=\"/es#fleet\">Flota</a>\n      <a class=\"navl\" href=\"#\">Precios</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Idioma: Español\">ES</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/buoyage\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/buoyage\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/buoyage\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/buoyage\" hreflang=\"es\" lang=\"es\" aria-current=\"true\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Tema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Guardados\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Cuenta\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Ruta de navegación\"><ol><li><a href=\"/es\">Inicio</a></li><li><a href=\"/es/theory\">Teoría</a></li><li aria-current=\"page\">Reglamento de abordajes</li></ol></nav>\n        <h1 class=\"display\">Boyas y marcas: el sistema IALA</h1>\n        <p class=\"lead\">Las boyas muestran por dónde va el canal y por qué lado de un peligro se pasa con seguridad. Esta guía trata las marcas IALA que encontrarás en el Mediterráneo, de día y de noche.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Instructores de Ocean Way</span><span class=\"meta\">Actualizado el 1 nov 2026</span><span class=\"meta\">6 min de lectura</span><span class=\"lvl\">Patrón de chárter</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>En esta página<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#regions\">Regiones A y B</a></li><li><a href=\"#lateral\">Marcas laterales</a></li><li><a href=\"#cardinals\">Marcas cardinales</a></li><li><a href=\"#isolated-safe\">Peligro aislado y aguas navegables</a></li><li><a href=\"#special\">Marcas especiales y de naufragio</a></li><li><a href=\"#lights\">Leer las luces</a></li><li><a href=\"#real-life\">Las boyas en la vida real</a></li><li><a href=\"#practise\">Practícalo</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">En resumen</span><ul><li>En la Región A, entrando desde el mar, las marcas cilíndricas rojas se dejan a babor y los conos verdes a estribor.</li><li>Las marcas de tope cardinales apuntan al negro de la marca. Pasa por el lado que da nombre a la marca.</li><li>Las luces cardinales siguen la esfera de un reloj: este, 3 destellos; sur, 6 y uno largo; oeste, 9; norte, continua.</li><li>Las boyas se desplazan, desaparecen y pueden estar apagadas, así que comprueba cada marca con la carta.</li></ul></div>\n          <section id=\"regions\">\n<h2>Un sistema, dos regiones</h2>\n<p>Las boyas y las balizas (marcas fijas sobre postes o rocas) siguen el Sistema de Balizamiento Marítimo de la IALA, acordado en todo el mundo. Cada marca te da cuatro pistas: su color, su forma, su marca de tope (la pequeña figura de arriba) y, de noche, su luz.</p>\n<p>El mundo se divide en dos regiones, que solo se diferencian en los colores de las marcas laterales que señalan los lados de un canal.</p>\n<ul>\n<li><b>Región A.</b> Europa, el Mediterráneo con Grecia y Turquía, África, la mayor parte de Asia, Australia y Nueva Zelanda. Entrando desde el mar, las marcas rojas se dejan a babor.</li>\n<li><b>Región B.</b> Norteamérica, Centroamérica y Sudamérica, Japón, Corea del Sur y Filipinas. Los colores laterales están invertidos, así que entrando desde el mar las marcas rojas se dejan a estribor.</li>\n</ul>\n<p>Todas las demás marcas son iguales en las dos regiones. Todo lo que sigue describe la Región A, donde navegamos.</p>\n</section>\n<section id=\"lateral\">\n<h2>Marcas laterales: los lados del canal</h2>\n<p>Las marcas laterales señalan los dos bordes de un canal, como los bordillos de una carretera.</p>\n<ul>\n<li><b>Marca de babor.</b> Roja y cilíndrica (un cilindro de parte superior plana), con un cilindro rojo como marca de tope si la lleva. Su luz, si la tiene, es roja.</li>\n<li><b>Marca de estribor.</b> Verde y cónica, con un cono verde con el vértice hacia arriba como marca de tope si la lleva. Su luz, si la tiene, es verde.</li>\n</ul>\n<p>Las luces laterales pueden tener cualquier ritmo salvo grupos de dos destellos seguidos de uno, Fl(2+1), que se reserva para las marcas de canal principal.</p>\n<h3>Sentido del balizamiento</h3>\n<p>Babor y estribor significan aquí tus bandas cuando navegas en el sentido convencional del balizamiento. Cerca de un puerto, un río o un estuario, eso significa entrar desde el mar. En costas abiertas lo fijan las autoridades y en general sigue el sentido de las agujas del reloj alrededor de los continentes. Donde pueda haber dudas, la carta lo indica con un símbolo de flecha. Al salir de puerto todo se invierte: dejas las marcas rojas a estribor.</p>\n<h3>Marcas de canal principal</h3>\n<p>Donde un canal se bifurca, una marca lateral modificada indica el ramal principal. Su luz es Fl(2+1), del color del cuerpo principal de la marca.</p>\n<ul>\n<li><b>Canal principal a estribor.</b> Un cilindro rojo con una banda ancha verde. Déjalo a babor y el canal principal queda a estribor.</li>\n<li><b>Canal principal a babor.</b> Un cono verde con una banda ancha roja. Déjalo a estribor para seguir en el canal principal.</li>\n</ul>\n</section>\n<section id=\"cardinals\">\n<h2>Marcas cardinales: qué lado es seguro</h2>\n<p>Una marca cardinal se coloca al norte, al este, al sur o al oeste de un peligro, como una roca, un bajo o un naufragio. Su nombre te dice el lado seguro: pasa al norte de una cardinal norte, al este de una cardinal este, y así sucesivamente. Todas las cardinales son negras y amarillas, con dos conos negros como marca de tope, y su luz, si la tienen, es blanca.</p>\n<p>La marca de tope es la clave de los colores. El negro de la marca está hacia donde apuntan los conos.</p>\n<table class=\"tbl\">\n<thead><tr><th>Marca</th><th>Marca de tope</th><th>Colores</th><th>Luz</th></tr></thead>\n<tbody>\n<tr><td>Cardinal norte</td><td>Los dos conos hacia arriba</td><td>Negro sobre amarillo</td><td>Q o VQ, continua</td></tr>\n<tr><td>Cardinal este</td><td>Conos base con base, vértices separados</td><td>Negra con una banda ancha amarilla</td><td>Q(3) 10s o VQ(3) 5s</td></tr>\n<tr><td>Cardinal sur</td><td>Los dos conos hacia abajo</td><td>Amarillo sobre negro</td><td>Q(6)+LFl 15s o VQ(6)+LFl 10s</td></tr>\n<tr><td>Cardinal oeste</td><td>Conos vértice con vértice, puntas juntas</td><td>Amarilla con una banda ancha negra</td><td>Q(9) 15s o VQ(9) 10s</td></tr>\n</tbody>\n</table>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 470\" role=\"img\" aria-label=\"Cuatro marcas cardinales alrededor de un peligro, cada una en el lado que le da nombre, con sus colores, marcas de tope y ritmos de luz centelleante\"><line class=\"dg-ring\" x1=\"352.5\" y1=\"217.5\" x2=\"443.7\" y2=\"126.3\"/><line class=\"dg-ring\" x1=\"352.5\" y1=\"282.5\" x2=\"443.7\" y2=\"373.7\"/><line class=\"dg-ring\" x1=\"287.5\" y1=\"282.5\" x2=\"196.3\" y2=\"373.7\"/><line class=\"dg-ring\" x1=\"287.5\" y1=\"217.5\" x2=\"196.3\" y2=\"126.3\"/><path class=\"dg-nogo\" d=\"M290,256 C286,236 310,224 328,230 C350,234 354,254 342,268 C328,280 298,276 290,256Z\"/><text class=\"dg-label dg-muted\" x=\"320\" y=\"300\" text-anchor=\"middle\">Peligro</text><line class=\"dg-water\" x1=\"286\" y1=\"130\" x2=\"354\" y2=\"130\"/><rect class=\"dg-blk\" x=\"307\" y=\"72.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-yel\" x=\"307\" y=\"100.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-outline\" x=\"307\" y=\"72\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"320\" y1=\"72\" x2=\"320\" y2=\"62\"/><polygon class=\"dg-cone\" points=\"311,62 329,62 320,49\"/><polygon class=\"dg-cone\" points=\"311,47 329,47 320,34\"/><text class=\"dg-label\" x=\"350\" y=\"70\" text-anchor=\"start\">Cardinal norte</text><text class=\"dg-label dg-muted\" x=\"350\" y=\"88\" text-anchor=\"start\">Q · pásala por el norte</text><line class=\"dg-water\" x1=\"476\" y1=\"280\" x2=\"544\" y2=\"280\"/><rect class=\"dg-blk\" x=\"497\" y=\"222.0\" width=\"26\" height=\"18.7\"/><rect class=\"dg-yel\" x=\"497\" y=\"240.7\" width=\"26\" height=\"18.7\"/><rect class=\"dg-blk\" x=\"497\" y=\"259.3\" width=\"26\" height=\"18.7\"/><rect class=\"dg-outline\" x=\"497\" y=\"222\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"510\" y1=\"222\" x2=\"510\" y2=\"212\"/><polygon class=\"dg-cone\" points=\"501,199 519,199 510,212\"/><polygon class=\"dg-cone\" points=\"501,197 519,197 510,184\"/><text class=\"dg-label\" x=\"510\" y=\"306\" text-anchor=\"middle\">Cardinal este</text><text class=\"dg-label dg-muted\" x=\"510\" y=\"324\" text-anchor=\"middle\">Q(3) · pásala por el este</text><line class=\"dg-water\" x1=\"286\" y1=\"440\" x2=\"354\" y2=\"440\"/><rect class=\"dg-yel\" x=\"307\" y=\"382.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-blk\" x=\"307\" y=\"410.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-outline\" x=\"307\" y=\"382\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"320\" y1=\"382\" x2=\"320\" y2=\"372\"/><polygon class=\"dg-cone\" points=\"311,359 329,359 320,372\"/><polygon class=\"dg-cone\" points=\"311,344 329,344 320,357\"/><text class=\"dg-label\" x=\"350\" y=\"380\" text-anchor=\"start\">Cardinal sur</text><text class=\"dg-label dg-muted\" x=\"350\" y=\"398\" text-anchor=\"start\">Q(6)+LFl · pásala por el sur</text><line class=\"dg-water\" x1=\"96\" y1=\"280\" x2=\"164\" y2=\"280\"/><rect class=\"dg-yel\" x=\"117\" y=\"222.0\" width=\"26\" height=\"18.7\"/><rect class=\"dg-blk\" x=\"117\" y=\"240.7\" width=\"26\" height=\"18.7\"/><rect class=\"dg-yel\" x=\"117\" y=\"259.3\" width=\"26\" height=\"18.7\"/><rect class=\"dg-outline\" x=\"117\" y=\"222\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"130\" y1=\"222\" x2=\"130\" y2=\"212\"/><polygon class=\"dg-cone\" points=\"121,212 139,212 130,199\"/><polygon class=\"dg-cone\" points=\"121,184 139,184 130,197\"/><text class=\"dg-label\" x=\"130\" y=\"306\" text-anchor=\"middle\">Cardinal oeste</text><text class=\"dg-label dg-muted\" x=\"130\" y=\"324\" text-anchor=\"middle\">Q(9) · pásala por el oeste</text></svg></div><figcaption class=\"disclaimer\">Marcas cardinales alrededor de un peligro, con el norte arriba. Cada marca está en el lado que le da nombre, así que pasas por ese lado. Los conos apuntan hacia donde está el negro, y la luz blanca destella como la esfera de un reloj: 3 en el este, 6 en el sur, 9 en el oeste.</figcaption></figure>\n<p>Para las luces, piensa en la esfera de un reloj. El este está a las tres y da tres destellos. El sur está a las seis y da seis, y luego un destello largo para que no se confunda con tres o nueve. El oeste está a las nueve y da nueve. El norte, a las doce, destella sin pausa.</p>\n<aside class=\"note warn\"><b>Atención</b><p>Una marca cardinal te dice qué lado es seguro, no hasta dónde llega el peligro. Un bajo puede extenderse bastante más allá de la marca, así que dale un buen resguardo y consulta la carta.</p></aside>\n</section>\n<section id=\"isolated-safe\">\n<h2>Peligro aislado y aguas navegables</h2>\n<p><b>Marca de peligro aislado.</b> Negra con una o más bandas anchas rojas, y con dos esferas negras, una encima de otra, como marca de tope. Se coloca sobre un peligro pequeño, como una roca aislada, con aguas navegables a su alrededor. Su luz es blanca, un grupo de dos destellos, Fl(2). Dos esferas, dos destellos. Pasa bien separado por cualquier lado.</p>\n<p><b>Marca de aguas navegables.</b> Franjas verticales rojas y blancas, con una sola esfera roja como marca de tope. Indica aguas navegables a su alrededor, a menudo en el extremo exterior de la aproximación a un puerto o en mitad de un canal. Su luz es blanca: isofase (Iso), de ocultaciones (Oc), un destello largo cada 10 segundos (LFl 10s) o la letra A en Morse, Mo(A).</p>\n</section>\n<section id=\"special\">\n<h2>Marcas especiales y boyas de naufragio</h2>\n<p><b>Marcas especiales.</b> Amarillas, con una X amarilla como marca de tope si la llevan, y luz amarilla si están iluminadas. Señalan cosas como zonas de baño, cables y tuberías, emisarios, balizas de regatas y piscifactorías. En verano, las filas de pequeñas boyas amarillas frente a las playas griegas y turcas delimitan las zonas de baño. No entres en ellas a motor.</p>\n<p><b>Boya de emergencia para naufragios.</b> Franjas verticales azules y amarillas, con una cruz amarilla vertical (en forma de signo más) como marca de tope y una luz que alterna destellos azules y amarillos. Señala un naufragio reciente que aún no figura en la carta, hasta que se inspecciona y se baliza de forma permanente. Mantente bien apartado.</p>\n</section>\n<section id=\"lights\">\n<h2>Leer las luces en la carta</h2>\n<p>Junto a cada marca iluminada, la carta imprime un código corto, la característica de la luz. Indica el ritmo, el color y el periodo: el tiempo en segundos desde el inicio de una secuencia hasta el inicio de la siguiente.</p>\n<table class=\"tbl\">\n<thead><tr><th>Código</th><th>Nombre</th><th>Qué ves</th></tr></thead>\n<tbody>\n<tr><td>F</td><td>Fija</td><td>Una luz continua</td></tr>\n<tr><td>Fl</td><td>De destellos</td><td>Destellos más cortos que la oscuridad entre ellos</td></tr>\n<tr><td>Fl(3)</td><td>Grupos de destellos</td><td>Grupos de tres destellos y luego una oscuridad más larga</td></tr>\n<tr><td>LFl</td><td>Destellos largos</td><td>Un destello que dura al menos 2 segundos</td></tr>\n<tr><td>Q</td><td>Centelleante</td><td>50 o 60 destellos por minuto</td></tr>\n<tr><td>VQ</td><td>Centelleante rápida</td><td>100 o 120 destellos por minuto</td></tr>\n<tr><td>Iso</td><td>Isofase</td><td>Luz y oscuridad de igual duración</td></tr>\n<tr><td>Oc</td><td>De ocultaciones</td><td>Luz más larga que la oscuridad, con eclipses cortos</td></tr>\n<tr><td>Mo(A)</td><td>Morse A</td><td>Un destello corto y luego uno largo</td></tr>\n</tbody>\n</table>\n<p>Los colores se indican con letras: R roja, G verde, Y amarilla, W blanca. Sin letra de color, la luz es blanca. Una entrada completa como Fl(2)R 6s 7m 4M se lee así: dos destellos rojos cada 6 segundos, de una luz a 7 metros de altura, visible a 4 millas náuticas con buena visibilidad. Para cronometrar una luz, observa dos o tres ciclos completos y cuenta, o usa un cronómetro.</p>\n</section>\n<section id=\"real-life\">\n<h2>Las boyas en la vida real</h2>\n<p>Una boya es una pista que hay que comprobar, no un hecho.</p>\n<ul>\n<li><b>Se mueven y desaparecen.</b> Una boya puede desplazarse con un temporal, soltarse o retirarse para su reparación, y las luces fallan. Nunca navegues de boya en boya sin comprobar cada una con la carta.</li>\n<li><b>Muchas no tienen luz.</b> Una marca que pasaste sin problema de día puede ser invisible de noche. Solo tienen luz las marcas que llevan una característica de luz en la carta.</li>\n<li><b>Identifica antes de fiarte.</b> Comprueba color, forma, marca de tope y luz, y luego confirma tu situación con el plotter, una demora o la sonda.</li>\n<li><b>Los puertos pequeños tienen pocas marcas.</b> En Grecia y Turquía, muchos puertos pequeños no tienen canal balizado, solo una luz en el extremo de cada espigón: roja a babor y verde a estribor al entrar. Las rocas aisladas suelen estar señaladas con una baliza sobre la propia roca.</li>\n</ul>\n<p>Entra en un puerto desconocido de día siempre que puedas, y lee antes el derrotero.</p>\n</section>\n<section id=\"practise\">\n<h2>Practícalo en el agua</h2>\n<p>En nuestros cursos nombras cada marca de la aproximación a un puerto nuevo antes de llegar a ella: primero en la carta, luego a simple vista y, de noche, contando y cronometrando su luz. Las travesías nocturnas por la costa turca y entre las islas griegas te dan luces cardinales y de puerto reales que identificar desde la bañera.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">International Bareboat Skipper</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es/courses/bareboat-skipper\">Ver el curso</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"En esta página\"><span class=\"kicker\">En esta página</span><ol class=\"toc-list\"><li><a href=\"#regions\">Regiones A y B</a></li><li><a href=\"#lateral\">Marcas laterales</a></li><li><a href=\"#cardinals\">Marcas cardinales</a></li><li><a href=\"#isolated-safe\">Peligro aislado y aguas navegables</a></li><li><a href=\"#special\">Marcas especiales y de naufragio</a></li><li><a href=\"#lights\">Leer las luces</a></li><li><a href=\"#real-life\">Las boyas en la vida real</a></li><li><a href=\"#practise\">Practícalo</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">International Bareboat Skipper</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es/courses/bareboat-skipper\">Ver el curso</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Teoría</span><h2 class=\"h2\" style=\"margin-top:12px\">Sigue leyendo</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/es/theory\">Toda la teoría</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Más teoría\"><a class=\"card\" href=\"/es/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Un yate a motor cruzando mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Quién tiene preferencia en el mar: las reglas que un patrón usa a diario</span><span class=\"card-meta\">El RIPA que un patrón de velero aplica a diario: vigilancia, velocidad de seguridad, riesgo de abordaje, quién cede el paso a vela y a motor, alcance, navegar a vela y motor, y canales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Un velero bajo un cielo estrellado\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Luces de navegación y marcas diurnas</span><span class=\"card-meta\">Luces de tope, de costado y de alcance, tricolor, luz de fondeo y marcas diurnas según la Parte C del RIPA, y cómo reconocer de noche pesqueros, remolques y buques.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Un velero navegando de ceñida en mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Rumbos: cómo navega un velero cerca del viento</span><span class=\"card-meta\">Aprende los rumbos, de la ceñida a la popa: la zona muerta, el trimado en cada rumbo, la virada por avante y la trasluchada, el viento aparente y la lectura de los catavientos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Una goleta con todas las velas izadas\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Seis nudos que usa todo tripulante</span><span class=\"card-meta\">Seis nudos que necesita todo tripulante: as de guía, ballestrinque, vuelta redonda y dos medios cotes, nudo de cornamusa, nudo de ocho y nudo llano, paso a paso.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Dos navegantes al timón navegando a vela\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Virada por avante y trasluchada, paso a paso</span><span class=\"card-meta\">Cómo virar por avante y trasluchar en un velero: las voces, el trabajo de cada tripulante, winches sin vueltas montadas, la trasluchada controlada, cómo salir si te quedas aproado y consejos para catamaranes.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Dos tripulantes trabajan junto al mástil con brisa fresca\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Rizos: cuándo y cómo reducir vela</span><span class=\"card-meta\">Cuándo y cómo tomar rizos en un velero: las señales de que ha llegado el momento, rizos de faja paso a paso, mayor enrollable en el mástil, enrollar el génova, equilibrio de velas y largar rizos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Prototipo de diseño. Los precios, las fechas y las personas son contenido de ejemplo. Fotos vía Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Quiénes somos</a><a href=\"#\">Telegram</a><a href=\"#\">Privacidad</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}