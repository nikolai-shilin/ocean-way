0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/right-of-way\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/right-of-way\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/right-of-way\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/right-of-way\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Rules of the road</li></ol></nav>\n        <h1 class=\"display\">Right of way at sea: the rules skippers use daily</h1>\n        <p class=\"lead\">The COLREGs decide who keeps clear when two vessels meet. These are the rules a yacht skipper applies every day, from keeping a lookout to dealing with big ships in a channel.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Bareboat skipper</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#lookout\">Lookout and safe speed</a></li><li><a href=\"#risk\">Risk of collision</a></li><li><a href=\"#action\">Taking action</a></li><li><a href=\"#sailing\">Two sailing vessels</a></li><li><a href=\"#power\">Overtaking, head-on, crossing</a></li><li><a href=\"#duties\">Give-way and stand-on</a></li><li><a href=\"#responsibilities\">Who gives way to whom</a></li><li><a href=\"#channels\">Narrow channels</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>Keep a proper lookout; a steady bearing with a closing range means risk of collision.</li><li>Port tack gives way to starboard; windward gives way to leeward; the overtaking vessel always keeps clear.</li><li>Give-way vessels act early and boldly; stand-on vessels hold course and speed.</li><li>With the engine in gear you are a power-driven vessel, even with sails up.</li></ul></div>\n          <section id=\"lookout\">\n<h2>Lookout and safe speed</h2>\n<p>The International Regulations for Preventing Collisions at Sea, known as the COLREGs, apply to every vessel, from a cruise ship to a dinghy; some ports add local rules on top. They begin with what everyone must do all the time.</p>\n<p><b>Rule 5, lookout.</b> Every vessel must keep a proper lookout at all times, by sight and hearing and by every other available means, such as radar and AIS (which shows ships' positions on a screen). On a yacht, check the whole horizon regularly, including behind the headsail.</p>\n<p><b>Rule 6, safe speed.</b> Every vessel must go at a speed that lets her take proper action to avoid a collision and stop within a suitable distance. There is no fixed number. It depends on visibility, traffic, how quickly your boat stops and turns, wind, sea and current, shore lights at night and the depth under the keel.</p>\n</section>\n<section id=\"risk\">\n<h2>Is there a risk of collision?</h2>\n<p><b>Rule 7</b> asks you to decide early whether a risk of collision exists. The simplest test is the compass bearing. Take a bearing of the other vessel with a hand-bearing compass, or line her up with a stanchion (an upright guardrail post) while holding a steady course, then repeat after a minute or two.</p>\n<ul>\n<li>If the bearing stays steady and the vessel is getting closer, you are on a collision course.</li>\n<li>If the bearing moves clearly ahead or astern, you will probably pass clear.</li>\n</ul>\n<p>With large ships, tows or at close range, a risk can exist even when the bearing changes. If in doubt, assume the risk exists. Never decide on a single look or radar reading.</p>\n</section>\n<section id=\"action\">\n<h2>How to take action</h2>\n<p><b>Rule 8</b> says avoiding action must be taken in ample time, be large enough to be obvious to the other vessel by eye or by radar, and leave you passing at a safe distance. Avoid a series of small changes, and keep checking until she is past and clear.</p>\n<p>With sea room, a large change of course alone is often best; you can also slow down, stop or go astern (reverse). A clear turn to pass well astern of a ship shows your intention; a nudge of a few degrees does not.</p>\n</section>\n<section id=\"sailing\">\n<h2>Two sailing vessels</h2>\n<p><b>Rule 12</b> applies when two vessels, both under sail alone, approach each other. With the wind on your port (left) side you are on port tack. The windward side is the side opposite the mainsail.</p>\n<ol>\n<li><b>Wind on different sides:</b> the vessel on port tack keeps out of the way of the one on starboard tack.</li>\n<li><b>Wind on the same side:</b> the windward vessel (the one further upwind) keeps out of the way of the leeward one.</li>\n<li><b>Cannot tell:</b> on port tack, if you see a vessel to windward and cannot tell her tack, keep out of the way.</li>\n</ol>\n</section>\n<section id=\"power\">\n<h2>Overtaking, head-on and crossing</h2>\n<p><b>Rule 13, overtaking.</b> Any vessel overtaking another keeps out of the way, whatever type either vessel is. This overrides Rules 12 and 18: a sailing yacht overtaking a motor boat keeps clear of it. You are overtaking if you approach from more than 22.5° abaft her beam (behind the line across her middle), where at night you would see only her stern light. If in doubt, assume you are overtaking.</p>\n<p><b>Rule 14, head-on.</b> When two power-driven vessels meet on reciprocal or nearly reciprocal courses, each turns to starboard so they pass port side to port side.</p>\n<p><b>Rule 15, crossing.</b> When two power-driven vessels cross, the one that has the other on her own starboard side gives way and, if she can, avoids crossing ahead. In short: if you see her red port sidelight, you give way.</p>\n</section>\n<section id=\"duties\">\n<h2>Give-way and stand-on duties</h2>\n<p><b>Rule 16:</b> the give-way vessel takes early and substantial action to keep well clear, ideally passing astern rather than crossing ahead.</p>\n<p><b>Rule 17:</b> the stand-on vessel keeps her course and speed. That is a duty, not a privilege: the give-way vessel relies on you being predictable. If she is clearly not taking proper action, sound at least five short, rapid blasts (Rule 34); you <em>may</em> also act on your own. If she is so close that her action alone cannot prevent a collision, you <em>must</em> act. A power-driven stand-on vessel should then avoid turning to port for a vessel on her own port side. None of this frees the give-way vessel from her duty.</p>\n</section>\n<section id=\"responsibilities\">\n<h2>Who gives way to whom</h2>\n<p><b>Rule 18</b> sets the order between different kinds of vessel, except where Rules 9, 10 (traffic separation schemes) and 13 say otherwise. Broadly, the less able a vessel is to manoeuvre, the more others keep clear of her.</p>\n<ul>\n<li>A power-driven vessel keeps out of the way of a vessel not under command (unable to manoeuvre, for example after a breakdown), a vessel restricted in her ability to manoeuvre (such as a dredger at work), a vessel engaged in fishing, and a sailing vessel.</li>\n<li>A sailing vessel keeps out of the way of the first three.</li>\n<li>Where possible, every vessel avoids impeding a vessel constrained by her draught (a deep ship limited to the deep water).</li>\n</ul>\n<p>\"Engaged in fishing\" means with nets, lines or trawls that restrict her movement; a boat trolling a line does not count. A sailing vessel is one under sail with any engine not in use. Once the engine drives the propeller, a sailing yacht is a power-driven vessel, even with every sail set.</p>\n<aside class=\"note warn\"><b>Watch out</b><p>A motorsailing yacht follows the rules for a power-driven vessel, so she gives way to sailing yachts. By day she shows a cone, point down, forward where it can best be seen. At night she shows a steaming light (a white masthead light) with her sidelights and stern light, never the tricolour at the masthead. Others judge you by what they see: without the cone, a motorsailing yacht looks like a sailing vessel standing on.</p></aside>\n<table class=\"tbl\"><thead><tr><th>Situation</th><th>Who gives way</th><th>What to do</th></tr></thead><tbody>\n<tr><td>Two yachts sailing, opposite tacks</td><td>Port-tack yacht</td><td>Bear away astern, or tack early</td></tr>\n<tr><td>Two yachts sailing, same tack</td><td>Windward yacht</td><td>Head up or drop back, keep clear</td></tr>\n<tr><td>Any vessel overtaking another</td><td>Overtaking vessel</td><td>Keep well clear until past</td></tr>\n<tr><td>Two power vessels crossing</td><td>The one with the other to starboard</td><td>Alter to starboard, pass astern</td></tr>\n<tr><td>Yacht under sail and motor boat</td><td>Motor boat, unless overtaking</td><td>Yacht stands on, keeps watching</td></tr>\n<tr><td>Yacht and a fishing, restricted or not-under-command vessel</td><td>Yacht</td><td>Keep well clear, early</td></tr>\n<tr><td>Motorsailing yacht and sailing yacht</td><td>Motorsailing yacht</td><td>Keep clear as a power vessel</td></tr>\n<tr><td>Yacht and ship in a narrow channel</td><td>Yacht must not impede</td><td>Keep to the starboard edge or outside</td></tr>\n</tbody></table>\n</section>\n<section id=\"channels\">\n<h2>Narrow channels and big ships</h2>\n<p><b>Rule 9</b> covers narrow channels and fairways, such as a buoyed harbour approach. Keep as near to the outer edge of the channel on your starboard side as is safe and practicable. A vessel under 20 metres long, or any sailing vessel, must not impede the passage of a vessel that can safely navigate only inside the channel. Do not cross a channel if that would impede such a vessel, and avoid anchoring in it.</p>\n<p>\"Must not impede\" means acting early, before any risk of collision develops. A large ship may need well over a mile to stop, and from her bridge a yacht close ahead can be hidden under the bow. Near busy ferry ports such as Piraeus or Bodrum, assume the ship has not seen you. If you must cross, cross quickly and at right angles. If a ship sounds five or more short blasts, she doubts you are keeping clear: act at once.</p>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On the International Bareboat Skipper course, each time another vessel appears you take bearings, decide who gives way and say it aloud before you act. You also practise identifying vessels by their lights and shapes.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#lookout\">Lookout and safe speed</a></li><li><a href=\"#risk\">Risk of collision</a></li><li><a href=\"#action\">Taking action</a></li><li><a href=\"#sailing\">Two sailing vessels</a></li><li><a href=\"#power\">Overtaking, head-on, crossing</a></li><li><a href=\"#duties\">Give-way and stand-on</a></li><li><a href=\"#responsibilities\">Who gives way to whom</a></li><li><a href=\"#channels\">Narrow channels</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"A yacht under a starry night sky\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Navigation lights and day shapes</span><span class=\"card-meta\">Masthead, side and stern lights, tricolour, anchor light and day shapes under COLREG Part C, plus how to read fishing boats, tows and ships at night.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"A skipper at the wheel leaving harbour\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Buoys and marks: the IALA system</span><span class=\"card-meta\">Lateral, cardinal, isolated danger, safe water and special marks in IALA Region A: colours, topmarks, light rhythms and how to read a light on the chart.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Two sailors at the wheel under sail\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Tacking and gybing, step by step</span><span class=\"card-meta\">How to tack and gybe a sailing yacht: the calls, crew jobs, winches without riding turns, a controlled gybe, getting out of irons and tips for catamarans.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Two crew working at the mast in a fresh breeze\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reefing: when and how to shorten sail</span><span class=\"card-meta\">When and how to reef a sailing yacht: signs it is time, slab reefing step by step, in-mast furling mains, rolling in the genoa, sail balance and shaking out.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}