0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/de\" aria-label=\"Ocean Way, Startseite\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Hauptmenü\">\n      <a class=\"navl\" href=\"/de#courses\">Kurse</a>\n      <a class=\"navl\" href=\"/de#passages\">Törns</a>\n      <a class=\"navl on\" href=\"/de/theory\">Theorie</a>\n      <a class=\"navl\" href=\"/de#fleet\">Flotte</a>\n      <a class=\"navl\" href=\"#\">Preise</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Sprache: Deutsch\">DE</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/vhf-procedure\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/vhf-procedure\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/vhf-procedure\" hreflang=\"de\" lang=\"de\" aria-current=\"true\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/vhf-procedure\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Farbschema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Gemerkt\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Konto\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Navigationspfad\"><ol><li><a href=\"/de\">Startseite</a></li><li><a href=\"/de/theory\">Theorie</a></li><li aria-current=\"page\">Funk und Sicherheit</li></ol></nav>\n        <h1 class=\"display\">VHF-Funk: Mayday, Pan-Pan und Alltagsanrufe</h1>\n        <p class=\"lead\">Das VHF-Funkgerät ist deine Verbindung zu Rettungsdiensten, Marinas und anderen Booten. Lerne die Kanäle, das Buchstabieralphabet und den genauen Wortlaut für Mayday, Pan-Pan, Sécurité und einen normalen Anruf bei der Marina.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ausbilder von Ocean Way</span><span class=\"meta\">Aktualisiert am 1. Nov. 2026</span><span class=\"meta\">5 Min. Lesezeit</span><span class=\"lvl\">Ganze Crew</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>Auf dieser Seite<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#channels\">Kanäle und Dual Watch</a></li><li><a href=\"#phonetic\">Buchstabieralphabet</a></li><li><a href=\"#dsc\">DSC-Notalarmtaste</a></li><li><a href=\"#mayday\">Mayday</a></li><li><a href=\"#pan-pan\">Pan-Pan</a></li><li><a href=\"#securite\">Sécurité</a></li><li><a href=\"#everyday\">Eine Marina anrufen</a></li><li><a href=\"#prowords\">Betriebsausdrücke</a></li><li><a href=\"#licence\">Scheine und Lizenzen</a></li><li><a href=\"#practise\">Auf dem Wasser üben</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Kurz gesagt</span><ul><li>Kanal 16 ist für Not, Sicherheit und Anruf; gesprochen wird auf einem Arbeitskanal.</li><li>Die rote DSC-Taste sendet automatisch deine MMSI und Position.</li><li>Mayday bei ernster und unmittelbarer Gefahr, Pan-Pan bei Dringlichkeit.</li><li>Zum Funken brauchst du ein SRC; das Boot braucht eine Lizenz für die Seefunkstelle.</li></ul></div>\n          <section id=\"channels\">\n<h2>Kanal 16 und Arbeitskanäle</h2>\n<p>Ein Seefunkgerät auf VHF arbeitet auf Sichtlinie, die Reichweite liegt zwischen Schiffen also meist bei 20–30 sm, zu einer Küstenfunkstelle mit hoher Antenne auch darüber. Es hat viele Kanäle, aber einer ist der wichtigste.</p>\n<p><b>Kanal 16</b> ist für Not-, Dringlichkeits- und Sicherheitsmeldungen und für den Anruf einer anderen Funkstelle. Jedes Fahrzeug mit VHF sollte auf See darauf hören. Du stellst dort den Kontakt her und wechselst dann zum Sprechen auf einen Arbeitskanal.</p>\n<ul>\n<li><b>Arbeitskanäle.</b> Gespräche von Schiff zu Schiff laufen auf Schiff-Schiff-Kanälen wie 6, 8, 72 oder 77. Marinas und Häfen haben jeweils ihren eigenen Kanal, der im Hafenhandbuch steht.</li>\n<li><b>Kanal 70</b> überträgt ausschließlich digitale DSC-Alarme. Auf ihm wird nie gesprochen.</li>\n<li><b>Dual Watch.</b> Mit dieser Einstellung hört das Funkgerät gleichzeitig Kanal 16 und einen weiteren Kanal ab. Das ist bei der Ansteuerung einer Marina nützlich, aber lass Kanal 16 immer mitlaufen.</li>\n<li><b>Sendeleistung.</b> Nimm geringe Leistung (1 Watt) für nahe Funkstellen wie eine Marina und hohe Leistung (25 Watt) für größere Entfernungen.</li>\n</ul>\n</section>\n<section id=\"phonetic\">\n<h2>Das Buchstabieralphabet</h2>\n<p>Über ein knisterndes Funkgerät klingen Buchstaben ähnlich, deshalb buchstabierst du Wörter mit dem internationalen Buchstabieralphabet. Zahlen sprichst du Ziffer für Ziffer: „one five“ für 15.</p>\n<table class=\"tbl\"><thead><tr><th>Buchstabe</th><th>Wort</th><th>Buchstabe</th><th>Wort</th></tr></thead><tbody>\n<tr><td>A</td><td>Alfa</td><td>N</td><td>November</td></tr>\n<tr><td>B</td><td>Bravo</td><td>O</td><td>Oscar</td></tr>\n<tr><td>C</td><td>Charlie</td><td>P</td><td>Papa</td></tr>\n<tr><td>D</td><td>Delta</td><td>Q</td><td>Quebec</td></tr>\n<tr><td>E</td><td>Echo</td><td>R</td><td>Romeo</td></tr>\n<tr><td>F</td><td>Foxtrot</td><td>S</td><td>Sierra</td></tr>\n<tr><td>G</td><td>Golf</td><td>T</td><td>Tango</td></tr>\n<tr><td>H</td><td>Hotel</td><td>U</td><td>Uniform</td></tr>\n<tr><td>I</td><td>India</td><td>V</td><td>Victor</td></tr>\n<tr><td>J</td><td>Juliett</td><td>W</td><td>Whiskey</td></tr>\n<tr><td>K</td><td>Kilo</td><td>X</td><td>X-ray</td></tr>\n<tr><td>L</td><td>Lima</td><td>Y</td><td>Yankee</td></tr>\n<tr><td>M</td><td>Mike</td><td>Z</td><td>Zulu</td></tr>\n</tbody></table>\n</section>\n<section id=\"dsc\">\n<h2>Die DSC-Notalarmtaste</h2>\n<p>Die meisten modernen Geräte haben DSC (Digital Selective Calling, digitaler Selektivruf). Jedes Boot hat eine MMSI (Maritime Mobile Service Identity), eine neunstellige Nummer, die im Funkgerät programmiert ist. Ist das Funkgerät mit dem GPS verbunden, kennt es die Position des Boots.</p>\n<p>Um einen Notalarm zu senden, klappst du die Abdeckung über der roten DISTRESS-Taste hoch und hältst die Taste gedrückt (meist etwa fünf Sekunden), bis das Gerät sendet. Wenn Zeit ist, wähl vorher im Menü die Art des Notfalls, etwa Feuer oder Sinken. Der Alarm überträgt deine MMSI, Position und Uhrzeit.</p>\n<p>Was danach passiert:</p>\n<ol>\n<li>Der Alarm geht auf Kanal 70 hinaus, und das Funkgerät schaltet selbst auf Kanal 16.</li>\n<li>Das Funkgerät wiederholt den Alarm alle paar Minuten, bis eine Funkstelle ihn bestätigt.</li>\n<li>Eine Küstenfunkstelle oder Seenotleitstelle bestätigt per DSC.</li>\n<li>Dann setzt du den Mayday-Sprechfunkspruch auf Kanal 16 ab und hörst weiter mit.</li>\n</ol>\n</section>\n<section id=\"mayday\">\n<h2>Mayday</h2>\n<p>Mayday ist für <b>ernste und unmittelbare Gefahr</b> für ein Fahrzeug oder eine Person, wenn du sofort Hilfe brauchst: Feuer außer Kontrolle, Sinken, eine Person über Bord, die du nicht bergen kannst. Sprich langsam und deutlich auf Kanal 16, mit hoher Leistung. Der Aufbau:</p>\n<ol>\n<li>MAYDAY, MAYDAY, MAYDAY</li>\n<li>THIS IS, dann dreimal der Bootsname</li>\n<li>Rufzeichen und MMSI</li>\n<li>MAYDAY, Bootsname</li>\n<li>Position</li>\n<li>Art des Notfalls</li>\n<li>Benötigte Hilfe</li>\n<li>Anzahl der Personen an Bord</li>\n<li>Weitere nützliche Informationen</li>\n<li>OVER</li>\n</ol>\n<p>Ein vollständiges Beispiel (auf Englisch, wie es im Mittelmeer gesprochen wird):</p>\n<p><em>„Mayday, Mayday, Mayday. This is sailing yacht Kalimera, Kalimera, Kalimera. Call sign Sierra Victor Alfa Two, MMSI two three nine one two three four five six. Mayday Kalimera. My position two miles south of Cape Sounion. Fire in the engine compartment, out of control. I require immediate assistance. Six persons on board. We are preparing to abandon to the liferaft. Over.“</em></p>\n<p>Dann warte. Antwortet niemand, wiederhol den Funkspruch. Gib die Position als Breite und Länge vom GPS an oder als Peilung und Abstand zu einem Punkt aus der Karte.</p>\n</section>\n<section id=\"pan-pan\">\n<h2>Pan-Pan</h2>\n<p>Pan-Pan ist die Dringlichkeitsmeldung. Nutze sie, wenn die Sicherheit des Boots oder einer Person gefährdet ist, die Gefahr aber nicht unmittelbar besteht: Motorausfall nahe einer Leeküste, solange noch Zeit ist, eine schwere Verletzung, ein gebrochenes Ruder. Der Aufbau folgt dem Mayday und richtet sich an alle Funkstellen.</p>\n<p><em>„Pan-Pan, Pan-Pan, Pan-Pan. All stations, all stations, all stations. This is sailing yacht Kalimera, Kalimera, Kalimera. Call sign Sierra Victor Alfa Two, MMSI two three nine one two three four five six. My position two miles south of Kalymnos. Engine failure and torn mainsail, drifting slowly, no immediate danger. I require a tow. Four persons on board. Over.“</em></p>\n</section>\n<section id=\"securite\">\n<h2>Sécurité</h2>\n<p>Sécurité (gesprochen „se-kü-ri-tee“) ist die Sicherheitsmeldung für Navigations- oder Wetterwarnungen. Küstenfunkstellen nutzen sie für Sturmwarnungen. Du könntest damit andere vor einem treibenden Container oder einer unbeleuchteten Tonne warnen. Kündige sie auf Kanal 16 an, „Sécurité, Sécurité, Sécurité, all stations, this is…“, nenne den Arbeitskanal, wechsle dorthin und gib die Meldung durch.</p>\n</section>\n<section id=\"everyday\">\n<h2>Eine Marina anrufen</h2>\n<p>Die meisten Funkgespräche sind ganz alltäglich. Für den Anruf bei einer Marina stellst du geringe Leistung und den Arbeitskanal der Marina ein:</p>\n<p><em>„Kos Marina, Kos Marina, this is sailing yacht Kalimera, Kalimera. Over.“</em></p>\n<p>Wenn sie antworten, sag, was du brauchst: <em>„Good afternoon. We are a 12-metre yacht, beam four metres, draft two metres, requesting a berth for two nights. We are 15 minutes away. Over.“</em> Sie weisen dir einen Platz zu und bitten dich oft, draußen auf einen Marinero (Anlegehelfer) zu warten. Bereite in der Zeit Leinen und Fender vor.</p>\n</section>\n<section id=\"prowords\">\n<h2>Betriebsausdrücke</h2>\n<ul>\n<li><b>Over:</b> Ich bin fertig und erwarte eine Antwort.</li>\n<li><b>Out:</b> Das Gespräch ist beendet. Sag nie „over and out“.</li>\n<li><b>Say again:</b> Bitte wiederholen.</li>\n<li><b>Received:</b> Ich habe deine Meldung erhalten.</li>\n<li><b>This is:</b> vor dem eigenen Namen.</li>\n<li><b>Correction:</b> Ich habe mich vertan, hier die richtige Fassung.</li>\n<li><b>Seelonce Mayday:</b> Funkstille. Wird von der Funkstelle verwendet, die den Notverkehr leitet. Sende auf diesem Kanal nichts mehr bis zum <b>Seelonce Fini</b>.</li>\n</ul>\n</section>\n<section id=\"licence\">\n<h2>Scheine und Lizenzen</h2>\n<p>Um ein Seefunkgerät auf VHF mit DSC zu bedienen, brauchst du ein Funkzeugnis, normalerweise das Short Range Certificate (SRC) oder ein gleichwertiges. Das Boot braucht außerdem eine Lizenz für die Seefunkstelle vom Flaggenstaat, in der Rufzeichen und MMSI stehen. Charteryachten sind bereits lizenziert, aber das Funkzeugnis ist persönlich und liegt in deiner Verantwortung.</p>\n<aside class=\"note warn\"><b>Achtung</b><p>Sende nie einen Test-Mayday, weder per Sprache noch mit der roten Taste. Ein Fehlalarm kann eine echte Rettungsaktion auslösen. Nutze stattdessen den DSC-Testanruf deines Geräts. Hast du versehentlich einen Notalarm gesendet, schalte nicht aus. Brich den Alarm am Gerät ab und ruf dann auf Kanal 16: „All stations, all stations, all stations, this is (Bootsname ×3), MMSI…, position…, cancel my distress alert of (Uhrzeit). Over.“</p></aside>\n</section>\n<section id=\"practise\">\n<h2>Auf dem Wasser üben</h2>\n<p>In unseren Kursen übst du jeden Funkspruch zuerst an Übungsgeräten, bis du die Abläufe ohne Notizen beherrschst. Unterwegs führst du dann die echten alltäglichen Gespräche selbst und rufst Marinas und andere Boote auf den Arbeitskanälen.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Üben im Kurs</span><div class=\"card-title\">VHF Radio Operator</div><p>Lerne das auf dem Wasser mit einem Ausbilder, in einer Woche an Bord.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/de#courses\">Zu den Kursen</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"Auf dieser Seite\"><span class=\"kicker\">Auf dieser Seite</span><ol class=\"toc-list\"><li><a href=\"#channels\">Kanäle und Dual Watch</a></li><li><a href=\"#phonetic\">Buchstabieralphabet</a></li><li><a href=\"#dsc\">DSC-Notalarmtaste</a></li><li><a href=\"#mayday\">Mayday</a></li><li><a href=\"#pan-pan\">Pan-Pan</a></li><li><a href=\"#securite\">Sécurité</a></li><li><a href=\"#everyday\">Eine Marina anrufen</a></li><li><a href=\"#prowords\">Betriebsausdrücke</a></li><li><a href=\"#licence\">Scheine und Lizenzen</a></li><li><a href=\"#practise\">Auf dem Wasser üben</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Üben im Kurs</span><div class=\"card-title\">VHF Radio Operator</div><p>Lerne das auf dem Wasser mit einem Ausbilder, in einer Woche an Bord.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/de#courses\">Zu den Kursen</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theorie</span><h2 class=\"h2\" style=\"margin-top:12px\">Weiterlesen</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/de/theory\">Alle Artikel</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Mehr Theorie\"><a class=\"card\" href=\"/de/theory/man-overboard\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1732267994253-4b9e4fd70a41?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Crew in Segeljacken an Deck auf offener See\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Ganze Crew</span><span class=\"card-title\">Mensch über Bord: jemanden zurückholen</span><span class=\"card-meta\">Mensch über Bord für Yachtcrews: Vorbeugung, die ersten Sekunden, wann du Mayday sendest, Bergung unter Motor oder Segeln und wie du die Person sicher zurück an Bord holst.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/safety-on-board\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1542405242-8217b4c9e34c?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Crew mit Rettungswesten an Deck\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Ganze Crew</span><span class=\"card-title\">Sicherheit an Bord: Ausrüstung und Einweisung</span><span class=\"card-meta\">Yachtsicherheit für die Crew: die Sicherheitseinweisung des Skippers, 150-N-Rettungswesten und Lifebelts, Rettungsinsel und Notfalltasche, EPIRB und PLB, Seenotsignale, Feuer, Gas und Seeventile.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Segelyacht hoch am Wind auf offenem Wasser\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Kurse zum Wind: Wie eine Yacht hoch am Wind segelt</span><span class=\"card-meta\">Die Kurse zum Wind von hoch am Wind bis vor dem Wind: der tote Winkel, Segeltrimm auf jedem Kurs, Wende und Halse, scheinbarer Wind und Windfäden lesen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Ein Schoner mit allen Segeln gesetzt\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Sechs Knoten, die jedes Crewmitglied braucht</span><span class=\"card-meta\">Sechs Segelknoten, die jedes Crewmitglied braucht: Palstek, Webeleinstek, Rundtörn mit zwei halben Schlägen, Klampenschlag, Achtknoten und Kreuzknoten, Schritt für Schritt.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Segler am Steuerrad unter Segeln\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Wende und Halse, Schritt für Schritt</span><span class=\"card-meta\">Wie du mit einer Segelyacht wendest und halst: Kommandos, Aufgaben der Crew, Winschen ohne Überläufer, die kontrollierte Halse, was tun, wenn das Boot im Wind steht, und Tipps für Katamarane.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Crewmitglieder arbeiten bei frischer Brise am Mast\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Reffen: wann und wie du die Segelfläche verkleinerst</span><span class=\"card-meta\">Wann und wie du auf einer Segelyacht reffst: Anzeichen, dass es Zeit ist, Bindereff Schritt für Schritt, Rollgroß, Genua einrollen, Segelbalance und Ausreffen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout-Prototyp. Preise, Termine und Personen sind Beispielinhalte. Fotos über Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Über uns</a><a href=\"#\">Telegram</a><a href=\"#\">Datenschutz</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}