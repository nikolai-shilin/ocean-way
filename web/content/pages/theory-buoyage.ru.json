-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/buoyage\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/buoyage\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/buoyage\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/buoyage\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Правила расхождения</li></ol></nav>\n        <h1 class=\"display\">Буи и знаки: система IALA</h1>\n        <p class=\"lead\">Буи показывают, где проходит фарватер и с какой стороны от опасности безопасно. В этом руководстве — знаки IALA, которые вы встретите в Средиземноморье, днём и ночью.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Бербоут-шкипер</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#regions\">Регионы A и B</a></li><li><a href=\"#lateral\">Латеральные знаки</a></li><li><a href=\"#cardinals\">Кардинальные знаки</a></li><li><a href=\"#isolated-safe\">Отдельная опасность и безопасные воды</a></li><li><a href=\"#special\">Специальные знаки и знаки затонувших судов</a></li><li><a href=\"#lights\">Как читать огни</a></li><li><a href=\"#real-life\">Буи на практике</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>В регионе A при входе с моря красные цилиндрические знаки оставляют по левому борту, а зелёные конические — по правому.</li><li>Конусы кардинального знака указывают, где на нём чёрный цвет. Обходите знак с той стороны, по которой он назван.</li><li>Огни кардинальных знаков идут по циферблату: восток — 3 проблеска, юг — 6 и длинный проблеск, запад — 9, север — непрерывно.</li><li>Буи сносит, они пропадают и могут не гореть, поэтому сверяйте каждый знак с картой.</li></ul></div>\n          <section id=\"regions\">\n<h2>Одна система, два региона</h2>\n<p>Буи и неподвижные знаки (на столбах или скалах) подчиняются Системе морского ограждения IALA, принятой во всём мире. Каждый знак даёт четыре подсказки: окраску, форму, топовую фигуру (небольшую фигуру наверху) и ночью — огонь.</p>\n<p>Мир разделён на два региона, которые отличаются только окраской латеральных знаков, обозначающих стороны фарватера.</p>\n<ul>\n<li><b>Регион A.</b> Европа, Средиземноморье, включая Грецию и Турцию, Африка, большая часть Азии, Австралия и Новая Зеландия. При входе с моря красные знаки оставляют по левому борту.</li>\n<li><b>Регион B.</b> Северная, Центральная и Южная Америка, Япония, Южная Корея и Филиппины. Латеральные цвета здесь наоборот, поэтому при входе с моря красные знаки оставляют по правому борту.</li>\n</ul>\n<p>Все остальные знаки в обоих регионах одинаковы. Дальше речь о регионе A, где ходим мы.</p>\n</section>\n<section id=\"lateral\">\n<h2>Латеральные знаки: стороны фарватера</h2>\n<p>Латеральные знаки обозначают две кромки фарватера, как бордюры дороги.</p>\n<ul>\n<li><b>Знак левой стороны.</b> Красный, цилиндрический (цилиндр с плоским верхом), с красным цилиндром в качестве топовой фигуры, если она есть. Огонь, если есть, красный.</li>\n<li><b>Знак правой стороны.</b> Зелёный, конический, с зелёным конусом вершиной вверх в качестве топовой фигуры, если она есть. Огонь, если есть, зелёный.</li>\n</ul>\n<p>У латеральных огней может быть любой ритм, кроме двух проблесков, за которыми следует один, Fl(2+1): он оставлен для знаков основного фарватера.</p>\n<h3>Направление ограждения</h3>\n<p>Левая и правая сторона здесь — это ваши борта, когда вы идёте по направлению ограждения. У гавани, реки или эстуария это значит — при входе с моря. Вдоль открытых берегов направление устанавливают власти, и обычно оно идёт по часовой стрелке вокруг материков. Там, где возможна неясность, на карте его показывают стрелкой. При выходе из гавани всё наоборот: красные знаки оставляйте по правому борту.</p>\n<h3>Знаки основного фарватера</h3>\n<p>Там, где фарватер разветвляется, модифицированный латеральный знак показывает основную ветвь. Его огонь — Fl(2+1), того же цвета, что и основная окраска знака.</p>\n<ul>\n<li><b>Основной фарватер справа.</b> Красный цилиндр с одной широкой зелёной полосой. Оставьте его по левому борту — основной фарватер лежит справа.</li>\n<li><b>Основной фарватер слева.</b> Зелёный конус с одной широкой красной полосой. Оставьте его по правому борту, чтобы остаться в основном фарватере.</li>\n</ul>\n</section>\n<section id=\"cardinals\">\n<h2>Кардинальные знаки: где безопасно</h2>\n<p>Кардинальный знак стоит к северу, востоку, югу или западу от опасности — скалы, мели или затонувшего судна. Его название говорит, где безопасная сторона: северный кардинальный знак обходят с севера, восточный — с востока и так далее. Все кардинальные знаки чёрно-жёлтые, с двумя чёрными конусами в качестве топовой фигуры, а огонь, если есть, белый.</p>\n<p>Топовая фигура — ключ к окраске. Чёрный цвет на знаке там, куда указывают конусы.</p>\n<table class=\"tbl\">\n<thead><tr><th>Знак</th><th>Топовая фигура</th><th>Окраска</th><th>Огонь</th></tr></thead>\n<tbody>\n<tr><td>Северный кардинальный знак</td><td>Оба конуса вершинами вверх</td><td>Чёрный над жёлтым</td><td>Q или VQ, непрерывно</td></tr>\n<tr><td>Восточный кардинальный знак</td><td>Конусы основаниями друг к другу, вершины врозь</td><td>Чёрный с широкой жёлтой полосой</td><td>Q(3) 10s или VQ(3) 5s</td></tr>\n<tr><td>Южный кардинальный знак</td><td>Оба конуса вершинами вниз</td><td>Жёлтый над чёрным</td><td>Q(6)+LFl 15s или VQ(6)+LFl 10s</td></tr>\n<tr><td>Западный кардинальный знак</td><td>Конусы вершинами друг к другу</td><td>Жёлтый с широкой чёрной полосой</td><td>Q(9) 15s или VQ(9) 10s</td></tr>\n</tbody>\n</table>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 470\" role=\"img\" aria-label=\"Четыре кардинальных знака вокруг опасности, каждый с той стороны, по которой назван, с окраской, топовыми фигурами и ритмами частых проблесков\"><line class=\"dg-ring\" x1=\"352.5\" y1=\"217.5\" x2=\"443.7\" y2=\"126.3\"/><line class=\"dg-ring\" x1=\"352.5\" y1=\"282.5\" x2=\"443.7\" y2=\"373.7\"/><line class=\"dg-ring\" x1=\"287.5\" y1=\"282.5\" x2=\"196.3\" y2=\"373.7\"/><line class=\"dg-ring\" x1=\"287.5\" y1=\"217.5\" x2=\"196.3\" y2=\"126.3\"/><path class=\"dg-nogo\" d=\"M290,256 C286,236 310,224 328,230 C350,234 354,254 342,268 C328,280 298,276 290,256Z\"/><text class=\"dg-label dg-muted\" x=\"320\" y=\"300\" text-anchor=\"middle\">Опасность</text><line class=\"dg-water\" x1=\"286\" y1=\"130\" x2=\"354\" y2=\"130\"/><rect class=\"dg-blk\" x=\"307\" y=\"72.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-yel\" x=\"307\" y=\"100.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-outline\" x=\"307\" y=\"72\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"320\" y1=\"72\" x2=\"320\" y2=\"62\"/><polygon class=\"dg-cone\" points=\"311,62 329,62 320,49\"/><polygon class=\"dg-cone\" points=\"311,47 329,47 320,34\"/><text class=\"dg-label\" x=\"350\" y=\"70\" text-anchor=\"start\">Северный кардинальный знак</text><text class=\"dg-label dg-muted\" x=\"350\" y=\"88\" text-anchor=\"start\">Q · обходить с севера</text><line class=\"dg-water\" x1=\"476\" y1=\"280\" x2=\"544\" y2=\"280\"/><rect class=\"dg-blk\" x=\"497\" y=\"222.0\" width=\"26\" height=\"18.7\"/><rect class=\"dg-yel\" x=\"497\" y=\"240.7\" width=\"26\" height=\"18.7\"/><rect class=\"dg-blk\" x=\"497\" y=\"259.3\" width=\"26\" height=\"18.7\"/><rect class=\"dg-outline\" x=\"497\" y=\"222\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"510\" y1=\"222\" x2=\"510\" y2=\"212\"/><polygon class=\"dg-cone\" points=\"501,199 519,199 510,212\"/><polygon class=\"dg-cone\" points=\"501,197 519,197 510,184\"/><text class=\"dg-label\" x=\"510\" y=\"306\" text-anchor=\"middle\">Восточный кардинальный знак</text><text class=\"dg-label dg-muted\" x=\"510\" y=\"324\" text-anchor=\"middle\">Q(3) · обходить с востока</text><line class=\"dg-water\" x1=\"286\" y1=\"440\" x2=\"354\" y2=\"440\"/><rect class=\"dg-yel\" x=\"307\" y=\"382.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-blk\" x=\"307\" y=\"410.0\" width=\"26\" height=\"28.0\"/><rect class=\"dg-outline\" x=\"307\" y=\"382\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"320\" y1=\"382\" x2=\"320\" y2=\"372\"/><polygon class=\"dg-cone\" points=\"311,359 329,359 320,372\"/><polygon class=\"dg-cone\" points=\"311,344 329,344 320,357\"/><text class=\"dg-label\" x=\"350\" y=\"380\" text-anchor=\"start\">Южный кардинальный знак</text><text class=\"dg-label dg-muted\" x=\"350\" y=\"398\" text-anchor=\"start\">Q(6)+LFl · обходить с юга</text><line class=\"dg-water\" x1=\"96\" y1=\"280\" x2=\"164\" y2=\"280\"/><rect class=\"dg-yel\" x=\"117\" y=\"222.0\" width=\"26\" height=\"18.7\"/><rect class=\"dg-blk\" x=\"117\" y=\"240.7\" width=\"26\" height=\"18.7\"/><rect class=\"dg-yel\" x=\"117\" y=\"259.3\" width=\"26\" height=\"18.7\"/><rect class=\"dg-outline\" x=\"117\" y=\"222\" width=\"26\" height=\"56\" rx=\"3\"/><line class=\"dg-mast\" x1=\"130\" y1=\"222\" x2=\"130\" y2=\"212\"/><polygon class=\"dg-cone\" points=\"121,212 139,212 130,199\"/><polygon class=\"dg-cone\" points=\"121,184 139,184 130,197\"/><text class=\"dg-label\" x=\"130\" y=\"306\" text-anchor=\"middle\">Западный кардинальный знак</text><text class=\"dg-label dg-muted\" x=\"130\" y=\"324\" text-anchor=\"middle\">Q(9) · обходить с запада</text></svg></div><figcaption class=\"disclaimer\">Кардинальные знаки вокруг опасности, север вверху. Каждый знак стоит с той стороны, по которой назван, и обходить его нужно с этой стороны. Конусы указывают, где чёрный цвет, а белый огонь мигает по циферблату: 3 на востоке, 6 на юге, 9 на западе.</figcaption></figure>\n<p>Для огней представьте циферблат. Восток — на трёх часах, он даёт три проблеска. Юг — на шести, даёт шесть и затем один длинный проблеск, чтобы его нельзя было спутать с тремя или девятью. Запад — на девяти, даёт девять. Север, на двенадцати, мигает без перерыва.</p>\n<aside class=\"note warn\"><b>Осторожно</b><p>Кардинальный знак говорит, с какой стороны безопасно, но не говорит, как далеко тянется опасность. Мель может уходить довольно далеко за знак, поэтому обходите его с хорошим запасом и сверяйтесь с картой.</p></aside>\n</section>\n<section id=\"isolated-safe\">\n<h2>Отдельная опасность и безопасные воды</h2>\n<p><b>Знак отдельной опасности.</b> Чёрный с одной или несколькими широкими красными полосами, топовая фигура — два чёрных шара один над другим. Стоит на небольшой опасности или над ней, например на отдельной скале, вокруг которой судоходные воды. Огонь белый, группа из двух проблесков, Fl(2). Два шара — два проблеска. Обходите на хорошем расстоянии с любой стороны.</p>\n<p><b>Знак безопасных вод.</b> Красные и белые вертикальные полосы, топовая фигура — один красный шар. Показывает, что вокруг судоходные воды; часто стоит в начале подхода к гавани со стороны моря или на оси фарватера. Огонь белый: изофазный (Iso), затмевающийся (Oc), один длинный проблеск каждые 10 секунд (LFl 10s) или буква A азбуки Морзе, Mo(A).</p>\n</section>\n<section id=\"special\">\n<h2>Специальные знаки и буи затонувших судов</h2>\n<p><b>Специальные знаки.</b> Жёлтые, с жёлтым косым крестом (X) в качестве топовой фигуры, если она есть, и с жёлтым огнём, если они светящиеся. Ими обозначают зоны купания, кабели и трубопроводы, выпуски стоков, гоночные знаки и рыбные фермы. Летом у пляжей Греции и Турции ряды маленьких жёлтых буйков отделяют зоны купания. Не заходите в них под мотором.</p>\n<p><b>Аварийный буй ограждения затонувшего судна.</b> Синие и жёлтые вертикальные полосы, топовая фигура — жёлтый прямой крест (в виде плюса), огонь чередует синие и жёлтые проблески. Обозначает новое затонувшее судно, которого ещё нет на карте, пока место не обследуют и не оградят постоянными знаками. Держитесь от него подальше.</p>\n</section>\n<section id=\"lights\">\n<h2>Как читать огни на карте</h2>\n<p>Рядом с каждым светящимся знаком на карте напечатан короткий код — характеристика огня. Он показывает ритм, цвет и период: время в секундах от начала одной последовательности до начала следующей.</p>\n<table class=\"tbl\">\n<thead><tr><th>Код</th><th>Название</th><th>Что вы видите</th></tr></thead>\n<tbody>\n<tr><td>F</td><td>Постоянный</td><td>Ровный немигающий огонь</td></tr>\n<tr><td>Fl</td><td>Проблесковый</td><td>Проблески короче промежутков темноты между ними</td></tr>\n<tr><td>Fl(3)</td><td>Группо-проблесковый</td><td>Группы из трёх проблесков, затем более длинная темнота</td></tr>\n<tr><td>LFl</td><td>Длинно-проблесковый</td><td>Проблеск длительностью не меньше 2 секунд</td></tr>\n<tr><td>Q</td><td>Частый</td><td>50 или 60 проблесков в минуту</td></tr>\n<tr><td>VQ</td><td>Очень частый</td><td>100 или 120 проблесков в минуту</td></tr>\n<tr><td>Iso</td><td>Изофазный</td><td>Свет и темнота равной длительности</td></tr>\n<tr><td>Oc</td><td>Затмевающийся</td><td>Свет длиннее темноты, с короткими затмениями</td></tr>\n<tr><td>Mo(A)</td><td>Буква A азбуки Морзе</td><td>Короткий проблеск, затем длинный</td></tr>\n</tbody>\n</table>\n<p>Цвета обозначают буквами: R — красный, G — зелёный, Y — жёлтый, W — белый. Нет буквы цвета — огонь белый. Полная запись, например Fl(2)R 6s 7m 4M, читается так: два красных проблеска каждые 6 секунд, огонь на высоте 7 м, виден на 4 мили в ясную погоду. Чтобы засечь период огня, понаблюдайте два-три полных цикла и посчитайте или воспользуйтесь секундомером.</p>\n</section>\n<section id=\"real-life\">\n<h2>Буи на практике</h2>\n<p>Буй — подсказка, которую нужно проверить, а не факт.</p>\n<ul>\n<li><b>Они смещаются и пропадают.</b> Буй может стащить в шторм, оторвать или снять на ремонт, а огни отказывают. Никогда не идите от буя к бую, не сверяя каждый с картой.</li>\n<li><b>Многие не светятся.</b> Знак, который днём легко было пройти, ночью может быть не виден. Светятся только те знаки, у которых на карте указана характеристика огня.</li>\n<li><b>Опознайте, прежде чем полагаться.</b> Проверьте окраску, форму, топовую фигуру и огонь, затем подтвердите своё место по картплоттеру, пеленгу или эхолоту.</li>\n<li><b>В маленьких гаванях знаков мало.</b> В Греции и Турции во многих маленьких гаванях нет обвехованного фарватера, только огонь на оконечности каждого мола: красный слева и зелёный справа при входе. Отдельные скалы часто обозначены знаком прямо на скале.</li>\n</ul>\n<p>Заходите в незнакомую гавань засветло, когда это возможно, и заранее прочитайте лоцию.</p>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На наших курсах вы называете каждый знак на подходе к новой гавани ещё до того, как дойдёте до него: сначала по карте, затем глазами, а ночью — считая проблески и засекая период огня. Ночные переходы вдоль побережья Турции и среди греческих островов дают настоящие огни кардинальных знаков и гаваней, которые нужно опознать из кокпита.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#regions\">Регионы A и B</a></li><li><a href=\"#lateral\">Латеральные знаки</a></li><li><a href=\"#cardinals\">Кардинальные знаки</a></li><li><a href=\"#isolated-safe\">Отдельная опасность и безопасные воды</a></li><li><a href=\"#special\">Специальные знаки и знаки затонувших судов</a></li><li><a href=\"#lights\">Как читать огни</a></li><li><a href=\"#real-life\">Буи на практике</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Моторная яхта идёт открытым морем\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Правила расхождения в море: что шкиперы применяют каждый день</span><span class=\"card-meta\">МППСС, которые шкипер яхты применяет каждый день: наблюдение, безопасная скорость, опасность столкновения, кто уступает дорогу под парусом и под мотором, обгон, ход под парусами с мотором и фарватеры.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Яхта под звёздным ночным небом\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Навигационные огни и дневные знаки</span><span class=\"card-meta\">Топовый, бортовые и кормовой огни, трёхцветный фонарь, якорный огонь и дневные знаки по части C МППСС, а также как распознать ночью рыболовные суда, буксиры и большие суда.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Двое яхтсменов за штурвалом под парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Повороты оверштаг и фордевинд, шаг за шагом</span><span class=\"card-meta\">Как делать повороты оверштаг и фордевинд на парусной яхте: команды, обязанности экипажа, работа с лебёдкой без захлёстов, управляемый фордевинд, выход из левентика и советы для катамаранов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Двое из экипажа работают у мачты на свежем ветру\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Рифы: когда и как уменьшать парусность</span><span class=\"card-meta\">Когда и как брать рифы на парусной яхте: признаки, что пора, слаб-риф шаг за шагом, грот на закрутке в мачту, закрутка генуи, баланс парусов и отдача рифов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}