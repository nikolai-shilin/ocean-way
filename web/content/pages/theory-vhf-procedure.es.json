c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/es\" aria-label=\"Ocean Way, inicio\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Principal\">\n      <a class=\"navl\" href=\"/es#courses\">Cursos</a>\n      <a class=\"navl\" href=\"/es#passages\">Travesías</a>\n      <a class=\"navl on\" href=\"/es/theory\">Teoría</a>\n      <a class=\"navl\" href=\"/es#fleet\">Flota</a>\n      <a class=\"navl\" href=\"#\">Precios</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Idioma: Español\">ES</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/vhf-procedure\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/vhf-procedure\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/vhf-procedure\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/vhf-procedure\" hreflang=\"es\" lang=\"es\" aria-current=\"true\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Tema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Guardados\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Cuenta\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Ruta de navegación\"><ol><li><a href=\"/es\">Inicio</a></li><li><a href=\"/es/theory\">Teoría</a></li><li aria-current=\"page\">Radio y seguridad</li></ol></nav>\n        <h1 class=\"display\">Radio VHF: Mayday, Pan-Pan y llamadas habituales</h1>\n        <p class=\"lead\">La radio VHF es tu enlace con los servicios de salvamento, las marinas y otros barcos. Aprende los canales, el alfabeto fonético y las palabras exactas para Mayday, Pan-Pan, Sécurité y una llamada habitual a una marina.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Instructores de Ocean Way</span><span class=\"meta\">Actualizado el 1 nov 2026</span><span class=\"meta\">5 min de lectura</span><span class=\"lvl\">Toda la tripulación</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>En esta página<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#channels\">Canales y doble escucha</a></li><li><a href=\"#phonetic\">Alfabeto fonético</a></li><li><a href=\"#dsc\">Botón de socorro DSC</a></li><li><a href=\"#mayday\">Mayday</a></li><li><a href=\"#pan-pan\">Pan-Pan</a></li><li><a href=\"#securite\">Sécurité</a></li><li><a href=\"#everyday\">Llamar a una marina</a></li><li><a href=\"#prowords\">Palabras de procedimiento</a></li><li><a href=\"#licence\">Titulaciones y licencias</a></li><li><a href=\"#practise\">Practícalo en el agua</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">En resumen</span><ul><li>El canal 16 es para socorro, seguridad y llamada; habla en un canal de trabajo.</li><li>El botón rojo DSC envía tu MMSI y tu posición automáticamente.</li><li>Mayday ante un peligro grave e inminente, Pan-Pan para urgencias.</li><li>Necesitas un SRC para operar; el barco necesita una licencia de estación de barco.</li></ul></div>\n          <section id=\"channels\">\n<h2>Canal 16 y canales de trabajo</h2>\n<p>Una radio VHF marina funciona en línea de vista, así que su alcance suele ser de 20–30 millas entre barcos y mayor hasta una estación costera con una antena alta. Tiene muchos canales, pero uno importa más que ninguno.</p>\n<p><b>Canal 16</b> es para llamadas de socorro, urgencia y seguridad, y para llamar a otra estación. Todo barco con VHF debe mantener escucha en él en la mar. Lo usas para establecer contacto y luego pasas a un canal de trabajo para hablar.</p>\n<ul>\n<li><b>Canales de trabajo.</b> Las conversaciones entre barcos van en canales intership como el 6, el 8, el 72 o el 77. Cada marina y cada puerto tienen su propio canal, que figura en el derrotero.</li>\n<li><b>Canal 70</b> lleva solo alertas digitales DSC. En él nunca se habla.</li>\n<li><b>Doble escucha.</b> Este ajuste permite a la radio escuchar el canal 16 y otro canal a la vez. Es útil al aproximarte a una marina, pero mantén siempre el 16 en escucha.</li>\n<li><b>Potencia.</b> Usa baja potencia (1 vatio) para estaciones cercanas, como una marina, y alta potencia (25 vatios) para distancias mayores.</li>\n</ul>\n</section>\n<section id=\"phonetic\">\n<h2>El alfabeto fonético</h2>\n<p>Las letras se confunden en una radio con ruido, así que las palabras se deletrean con el alfabeto fonético internacional. Di los números cifra a cifra: «uno cinco» para 15.</p>\n<table class=\"tbl\"><thead><tr><th>Letra</th><th>Palabra</th><th>Letra</th><th>Palabra</th></tr></thead><tbody>\n<tr><td>A</td><td>Alfa</td><td>N</td><td>November</td></tr>\n<tr><td>B</td><td>Bravo</td><td>O</td><td>Oscar</td></tr>\n<tr><td>C</td><td>Charlie</td><td>P</td><td>Papa</td></tr>\n<tr><td>D</td><td>Delta</td><td>Q</td><td>Quebec</td></tr>\n<tr><td>E</td><td>Echo</td><td>R</td><td>Romeo</td></tr>\n<tr><td>F</td><td>Foxtrot</td><td>S</td><td>Sierra</td></tr>\n<tr><td>G</td><td>Golf</td><td>T</td><td>Tango</td></tr>\n<tr><td>H</td><td>Hotel</td><td>U</td><td>Uniform</td></tr>\n<tr><td>I</td><td>India</td><td>V</td><td>Victor</td></tr>\n<tr><td>J</td><td>Juliett</td><td>W</td><td>Whiskey</td></tr>\n<tr><td>K</td><td>Kilo</td><td>X</td><td>X-ray</td></tr>\n<tr><td>L</td><td>Lima</td><td>Y</td><td>Yankee</td></tr>\n<tr><td>M</td><td>Mike</td><td>Z</td><td>Zulu</td></tr>\n</tbody></table>\n</section>\n<section id=\"dsc\">\n<h2>El botón de socorro DSC</h2>\n<p>La mayoría de los equipos modernos tienen DSC (llamada selectiva digital). Cada barco tiene un MMSI (Identidad del Servicio Móvil Marítimo), un número de nueve cifras programado en la radio. Cuando la radio está conectada al GPS, conoce la posición del barco.</p>\n<p>Para enviar una alerta de socorro, levanta la tapa del botón rojo DISTRESS y mantenlo pulsado (normalmente unos cinco segundos) hasta que la radio transmita. Si hay tiempo, elige antes en el menú la naturaleza del peligro, como incendio o hundimiento. La alerta incluye tu MMSI, tu posición y la hora.</p>\n<p>Qué pasa después:</p>\n<ol>\n<li>La alerta sale por el canal 70 y la radio pasa sola al canal 16.</li>\n<li>La radio repite la alerta cada pocos minutos hasta que una estación acusa recibo.</li>\n<li>Una estación costera o un centro de salvamento acusa recibo por DSC.</li>\n<li>Entonces haces la llamada de voz Mayday en el canal 16 y sigues a la escucha.</li>\n</ol>\n</section>\n<section id=\"mayday\">\n<h2>Mayday</h2>\n<p>Mayday se usa ante un <b>peligro grave e inminente</b> para un barco o una persona, cuando necesitas ayuda inmediata: un incendio fuera de control, un hundimiento, una persona al agua que no puedes recuperar. Habla despacio y claro en el canal 16, en alta potencia. El formato:</p>\n<ol>\n<li>MAYDAY, MAYDAY, MAYDAY</li>\n<li>THIS IS, seguido del nombre del barco tres veces</li>\n<li>Indicativo de llamada y MMSI</li>\n<li>MAYDAY y el nombre del barco</li>\n<li>Posición</li>\n<li>Naturaleza del peligro</li>\n<li>Asistencia que necesitas</li>\n<li>Número de personas a bordo</li>\n<li>Cualquier otra información útil</li>\n<li>OVER</li>\n</ol>\n<p>Un ejemplo completo:</p>\n<p><em>«Mayday, Mayday, Mayday. This is velero Kalimera, Kalimera, Kalimera. Indicativo Sierra Victor Alfa dos, MMSI dos tres nueve uno dos tres cuatro cinco seis. Mayday Kalimera. Mi posición, dos millas al sur del cabo Sunión. Incendio en la sala de máquinas, fuera de control. Solicito asistencia inmediata. Seis personas a bordo. Nos preparamos para abandonar el barco en la balsa salvavidas. Over.»</em></p>\n<p>Después espera. Si nadie responde, repite la llamada. Da la posición en latitud y longitud según el GPS, o como demora y distancia a un punto de la carta.</p>\n</section>\n<section id=\"pan-pan\">\n<h2>Pan-Pan</h2>\n<p>Pan-Pan es la llamada de urgencia. Úsala cuando la seguridad del barco o de una persona está en riesgo, pero el peligro no es inmediato: una avería de motor cerca de una costa a sotavento con tiempo por delante, una lesión grave, un timón roto. La estructura sigue la del Mayday, dirigida a todas las estaciones.</p>\n<p><em>«Pan-Pan, Pan-Pan, Pan-Pan. All stations, all stations, all stations. This is velero Kalimera, Kalimera, Kalimera. Indicativo Sierra Victor Alfa dos, MMSI dos tres nueve uno dos tres cuatro cinco seis. Mi posición, dos millas al sur de Kálimnos. Avería de motor y mayor rajada, derivando despacio, sin peligro inmediato. Solicito remolque. Cuatro personas a bordo. Over.»</em></p>\n</section>\n<section id=\"securite\">\n<h2>Sécurité</h2>\n<p>Sécurité (se pronuncia «se-cu-ri-té») es la llamada de seguridad, para avisos a la navegación o meteorológicos. Las estaciones costeras la usan para los avisos de temporal. Tú podrías usarla para avisar a otros de un contenedor a la deriva o de una boya sin luz. Anúnciala en el canal 16, «Sécurité, Sécurité, Sécurité, all stations, this is…», indica el canal de trabajo, cambia a él y da el mensaje.</p>\n</section>\n<section id=\"everyday\">\n<h2>Llamar a una marina</h2>\n<p>La mayor parte del uso de la radio es rutinario. Para llamar a una marina, pon baja potencia y el canal de trabajo de la marina:</p>\n<p><em>«Kos Marina, Kos Marina, this is velero Kalimera, Kalimera. Over.»</em></p>\n<p>Cuando respondan, di lo que necesitas: <em>«Buenas tardes. Somos un velero de 12 metros, cuatro metros de manga, dos metros de calado, y solicitamos amarre para dos noches. Estamos a 15 minutos. Over.»</em> Te asignarán un puesto y a menudo te pedirán que esperes fuera a un marinero (el que ayuda a amarrar). Prepara cabos y defensas mientras esperas.</p>\n</section>\n<section id=\"prowords\">\n<h2>Palabras de procedimiento</h2>\n<ul>\n<li><b>Over:</b> he terminado; espero respuesta.</li>\n<li><b>Out:</b> la conversación ha terminado. No digas nunca «over and out».</li>\n<li><b>Say again:</b> repita, por favor.</li>\n<li><b>Received:</b> he recibido su mensaje.</li>\n<li><b>This is:</b> antes de tu propio nombre.</li>\n<li><b>Correction:</b> me he equivocado; esta es la versión correcta.</li>\n<li><b>Seelonce Mayday:</b> silencio. Lo usa la estación que coordina un socorro. Deja de transmitir en ese canal hasta que oigas <b>Seelonce Fini</b>.</li>\n</ul>\n</section>\n<section id=\"licence\">\n<h2>Titulaciones y licencias</h2>\n<p>Para operar una VHF marina con DSC necesitas un certificado de operador, normalmente el Short Range Certificate (SRC) o uno equivalente. El barco también necesita una licencia de estación de barco de su Estado de bandera, en la que figuran su indicativo de llamada y su MMSI. Los barcos de chárter ya tienen licencia, pero el certificado de operador es personal y es responsabilidad tuya.</p>\n<aside class=\"note warn\"><b>Atención</b><p>No transmitas nunca un Mayday de prueba, ni de voz ni pulsando el botón rojo. Una falsa alerta puede poner en marcha un rescate real. Usa en su lugar la llamada de prueba DSC de tu radio. Si envías una alerta de socorro por error, no apagues la radio. Cancela la alerta en el equipo y después llama por el canal 16: «All stations, all stations, all stations, this is (nombre del barco ×3), MMSI…, posición…, anulo mi alerta de socorro de las (hora). Over.»</p></aside>\n</section>\n<section id=\"practise\">\n<h2>Practícalo en el agua</h2>\n<p>En nuestros cursos practicas cada llamada primero con radios de formación, hasta que los formatos te salen sin notas. Después, en travesía, haces tú mismo las llamadas habituales reales, a marinas y a otros barcos, en los canales de trabajo.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">VHF Radio Operator</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es#courses\">Ver los cursos</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"En esta página\"><span class=\"kicker\">En esta página</span><ol class=\"toc-list\"><li><a href=\"#channels\">Canales y doble escucha</a></li><li><a href=\"#phonetic\">Alfabeto fonético</a></li><li><a href=\"#dsc\">Botón de socorro DSC</a></li><li><a href=\"#mayday\">Mayday</a></li><li><a href=\"#pan-pan\">Pan-Pan</a></li><li><a href=\"#securite\">Sécurité</a></li><li><a href=\"#everyday\">Llamar a una marina</a></li><li><a href=\"#prowords\">Palabras de procedimiento</a></li><li><a href=\"#licence\">Titulaciones y licencias</a></li><li><a href=\"#practise\">Practícalo en el agua</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">VHF Radio Operator</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es#courses\">Ver los cursos</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Teoría</span><h2 class=\"h2\" style=\"margin-top:12px\">Sigue leyendo</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/es/theory\">Toda la teoría</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Más teoría\"><a class=\"card\" href=\"/es/theory/man-overboard\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1732267994253-4b9e4fd70a41?w=900&q=80&auto=format&fit=crop\" alt=\"Una tripulación con chaquetas de vela en cubierta en mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Toda la tripulación</span><span class=\"card-title\">Hombre al agua: cómo recuperar a alguien</span><span class=\"card-meta\">Hombre al agua para tripulaciones de velero: prevención, los primeros segundos, cuándo lanzar un Mayday, recuperación a motor o a vela, y cómo subir a la persona a bordo con seguridad.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/safety-on-board\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1542405242-8217b4c9e34c?w=900&q=80&auto=format&fit=crop\" alt=\"Una tripulación con chalecos salvavidas en cubierta\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Toda la tripulación</span><span class=\"card-title\">Seguridad a bordo: el equipo y la charla de seguridad</span><span class=\"card-meta\">Seguridad en el velero para la tripulación: la charla del patrón, chalecos de 150 N y arneses, la balsa salvavidas y la bolsa de abandono, EPIRB y PLB, bengalas, fuego, gas y grifos de fondo.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Un velero navegando de ceñida en mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Rumbos: cómo navega un velero cerca del viento</span><span class=\"card-meta\">Aprende los rumbos, de la ceñida a la popa: la zona muerta, el trimado en cada rumbo, la virada por avante y la trasluchada, el viento aparente y la lectura de los catavientos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Una goleta con todas las velas izadas\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Seis nudos que usa todo tripulante</span><span class=\"card-meta\">Seis nudos que necesita todo tripulante: as de guía, ballestrinque, vuelta redonda y dos medios cotes, nudo de cornamusa, nudo de ocho y nudo llano, paso a paso.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Dos navegantes al timón navegando a vela\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Virada por avante y trasluchada, paso a paso</span><span class=\"card-meta\">Cómo virar por avante y trasluchar en un velero: las voces, el trabajo de cada tripulante, winches sin vueltas montadas, la trasluchada controlada, cómo salir si te quedas aproado y consejos para catamaranes.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Dos tripulantes trabajan junto al mástil con brisa fresca\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Rizos: cuándo y cómo reducir vela</span><span class=\"card-meta\">Cuándo y cómo tomar rizos en un velero: las señales de que ha llegado el momento, rizos de faja paso a paso, mayor enrollable en el mástil, enrollar el génova, equilibrio de velas y largar rizos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Prototipo de diseño. Los precios, las fechas y las personas son contenido de ejemplo. Fotos vía Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Quiénes somos</a><a href=\"#\">Telegram</a><a href=\"#\">Privacidad</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}