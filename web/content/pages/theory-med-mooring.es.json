6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/es\" aria-label=\"Ocean Way, inicio\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Principal\">\n      <a class=\"navl\" href=\"/es#courses\">Cursos</a>\n      <a class=\"navl\" href=\"/es#passages\">Travesías</a>\n      <a class=\"navl on\" href=\"/es/theory\">Teoría</a>\n      <a class=\"navl\" href=\"/es#fleet\">Flota</a>\n      <a class=\"navl\" href=\"#\">Precios</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Idioma: Español\">ES</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/med-mooring\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/med-mooring\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/med-mooring\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/med-mooring\" hreflang=\"es\" lang=\"es\" aria-current=\"true\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Tema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Guardados\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Cuenta\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Ruta de navegación\"><ol><li><a href=\"/es\">Inicio</a></li><li><a href=\"/es/theory\">Teoría</a></li><li aria-current=\"page\">Puerto y fondeadero</li></ol></nav>\n        <h1 class=\"display\">Amarre a la mediterránea, paso a paso</h1>\n        <p class=\"lead\">El amarre de popa es lo habitual en la mayoría de los puertos del Mediterráneo. Aquí verás cómo prepararte, aproximarte y amarrar con muerto o con tu propia ancla, con calma y sin dramas.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Instructores de Ocean Way</span><span class=\"meta\">Actualizado el 1 nov 2026</span><span class=\"meta\">6 min de lectura</span><span class=\"lvl\">Patrón de chárter</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>En esta página<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#two-ways\">Dos maneras de amarrar</a></li><li><a href=\"#prepare\">Preparación</a></li><li><a href=\"#read-berth\">Viento, hueco y efecto de la hélice</a></li><li><a href=\"#sequence\">Paso a paso</a></li><li><a href=\"#crossed-anchors\">Cadenas cruzadas</a></li><li><a href=\"#leaving\">Salir del amarre</a></li><li><a href=\"#crosswind\">Consejos con viento de través</a></li><li><a href=\"#practise\">Practícalo</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">En resumen</span><ul><li>Prepara defensas en ambas bandas, dos amarras de popa, un bichero y una tripulación informada antes de entrar.</li><li>Conoce el efecto evolutivo de la hélice de tu barco y aproxímate despacio en marcha atrás, apuntando a barlovento del hueco si hay viento de través.</li><li>Lleva la guía del muerto hasta la proa, o fondea tu ancla a 3 o 4 esloras y larga la cadena en línea recta.</li><li>Mantén los cabos fuera del agua cerca de la hélice.</li></ul></div>\n          <section id=\"two-ways\">\n<h2>Dos maneras de amarrar de popa</h2>\n<p>En la mayoría de los puertos del Mediterráneo no te abarloas a un pantalán. Amarras <b>de popa</b>: la popa (parte trasera) del barco se amarra al muelle y la proa (parte delantera) se aguanta con un cabo o con un ancla. Así caben muchos barcos en poco espacio y bajas a tierra por una pasarela.</p>\n<p>Hay dos variantes:</p>\n<ul>\n<li><b>Muertos con guía.</b> La mayoría de las marinas, y muchos muelles de pueblo en Croacia y Grecia, tienen gruesas líneas de fondeo tendidas en el fondo. Desde cada puesto, un cabo más fino, la guía del muerto, baja del muelle hasta una cadena de fondeo. La recoges en la popa y la llevas a proa.</li>\n<li><b>Tu propia ancla.</b> En muchos muelles de las islas griegas y en partes de Turquía no hay muertos. Fondeas el ancla bien lejos del muelle y entras en marcha atrás, largando cadena según avanzas.</li>\n</ul>\n<p>La aproximación es igual en los dos casos. Solo cambia lo que sujeta la proa.</p>\n</section>\n<section id=\"prepare\">\n<h2>Prepárate antes de entrar</h2>\n<p>Casi todos los problemas de amarre empiezan con una tripulación que no está lista. Prepáralo todo bien fuera del puerto, en aguas abiertas, donde tienes tiempo.</p>\n<ul>\n<li><b>Defensas en ambas bandas</b>, en la parte más ancha del barco y cerca de la popa. Puedes acabar entre dos barcos, y no siempre sabrás qué banda va a recibir la presión.</li>\n<li><b>Dos amarras de popa</b>, una por banda, hechas firmes a bordo, adujadas y pasadas por fuera de todo para poder lanzarlas o darlas a tierra limpiamente.</li>\n<li><b>Un bichero</b> listo en la popa para coger la guía del muerto.</li>\n<li><b>Molinete</b> (el chigre del ancla) encendido y el ancla lista para fondear, si vas a usar la tuya.</li>\n<li><b>Funciones repartidas.</b> Quién lleva cada amarra de popa, quién coge la guía o maneja el molinete, quién defiende. Acuerda con la tripulación señales de mano sencillas, porque el timonel no oye a la proa con el ruido del motor.</li>\n</ul>\n<p>Si hay marinero, llama a la marina por VHF o por teléfono antes de llegar. Normalmente te indicará un puesto y te dará la guía del muerto.</p>\n</section>\n<section id=\"read-berth\">\n<h2>Lee el viento, el hueco y el efecto de la hélice</h2>\n<p>Antes de comprometerte, detente frente al puesto y observa. ¿De dónde viene el viento y con qué fuerza? ¿Es el hueco lo bastante ancho para tu manga más las defensas? ¿Estorban los cabos o las cadenas de los vecinos?</p>\n<p>Después piensa en el <b>efecto evolutivo de la hélice</b>. Una hélice que gira en marcha atrás empuja la popa de lado además de hacia atrás. En la mayoría de los barcos de chárter, con hélice dextrógira, la popa se va a babor (izquierda) en marcha atrás. Compruébalo en tu barco en aguas abiertas: da marcha atrás con el timón al centro y mira hacia qué lado se va la popa.</p>\n<p>Aprovéchalo. Si la popa se va a babor, aproxímate de modo que ese efecto te ayude a alinearte al final, o empieza el giro pronto para que no te empuje contra el barco de al lado. Con viento de través, aproxímate por barlovento y apunta un poco a barlovento del hueco, porque la proa caerá a sotavento en cuanto reduzcas.</p>\n</section>\n<section id=\"sequence\">\n<h2>La aproximación, paso a paso</h2>\n<p>Esta es la secuencia principal para amarrar a muerto, con los pasos extra para tu propia ancla marcados.</p>\n<ol>\n<li>Alinéate a cierta distancia del muelle, con la popa hacia el puesto, y empieza a dar marcha atrás despacio. Coge arrancada para gobernar (suficiente flujo sobre el timón) antes de llegar a la fila de barcos.</li>\n<li><b>Con ancla propia:</b> fondea el ancla a unas 3 o 4 esloras del muelle, en línea con tu puesto. Larga cadena de forma continua mientras das atrás para que quede en línea recta sobre el fondo. No dejes que se amontone y no la frenes hasta que estés casi dentro.</li>\n<li>Da atrás despacio, con golpes cortos de motor y punto muerto. No te acerques más rápido de lo que te importaría chocar con el muelle.</li>\n<li>A un metro más o menos, para el barco con un toque avante. La tripulación salta o pasa a tierra primero la amarra de popa de barlovento, y luego la otra.</li>\n<li><b>Con muerto:</b> coge la guía con el bichero en la popa y pásala hacia proa. Llévala por el costado, por fuera de los candeleros, hasta la proa.</li>\n<li>Cobra la guía a mano hasta que quede tensa y hazla firme en la cornamusa de proa.</li>\n<li><b>Con ancla propia:</b> tensa la cadena con el molinete, con suavidad, hasta que sujete la proa y el ancla haya agarrado.</li>\n<li>Ajusta las amarras de popa para que la popa quede lo bastante separada del muelle como para no tocarlo si el barco se mueve, pero lo bastante cerca para bajar por la pasarela. Motor en punto muerto y después apagado.</li>\n</ol>\n<p>Hazlo todo despacio. Un barco que va atrás al paso de una persona se para fácilmente. Uno que va a tres nudos, no.</p>\n<aside class=\"note warn\"><b>Atención</b><p>Un cabo cerca de la hélice puede enrollarse en segundos y parar el motor justo cuando lo necesitas. Mantén las amarras de popa fuera del agua. Cuando levantes la guía del muerto, pon el motor en punto muerto y llévala rápido hacia proa para que se hunda lejos de la popa. Nunca des avante con fuerza mientras cuelgue un cabo por la popa.</p></aside>\n</section>\n<section id=\"crossed-anchors\">\n<h2>Cadenas cruzadas</h2>\n<p>Cuando usas tu propia ancla, el problema más habitual es dejar tu cadena cruzada sobre la de un vecino. Cuando uno de los dos sale, el ancla sube con la cadena del otro barco enganchada.</p>\n<p>Para evitarlo, mira el ángulo de las cadenas de los vecinos antes de entrar, fondea tu ancla recta hacia fuera desde tu puesto y no en ángulo y, si puedes, entra cuando los barcos de ambos lados ya estén asentados. Si alguien fondea sobre tu cadena, díselo con educación y pronto.</p>\n<p>Si levantas la cadena de otro barco, para el molinete. Pasa un cabo por debajo de su cadena, haz firmes los dos chicotes a bordo y luego baja un poco tu ancla para que se suelte. Larga un chicote del cabo y deja que su cadena vuelva al fondo.</p>\n</section>\n<section id=\"leaving\">\n<h2>Salir del amarre</h2>\n<p>Informa a la tripulación antes de empezar. Con muerto, pasa las amarras de popa por seno (en doble, desde el barco alrededor de la argolla del muelle y de vuelta) para poder largarlas desde a bordo. Suelta la guía en la proa y espera a que se haya hundido bien lejos. Después larga las amarras de popa y sal despacio avante.</p>\n<p>Con tu propia ancla, larga las amarras de popa y cobra la cadena con el molinete mientras el timonel da un poco avante para quitarle carga. Mantén el barco en línea con la cadena hasta que el ancla despegue del fondo.</p>\n</section>\n<section id=\"crosswind\">\n<h2>Consejos con viento de través</h2>\n<ul>\n<li>Da primero a tierra la amarra de popa de barlovento. Evita que la popa caiga a sotavento.</li>\n<li>Un poco más de velocidad da más control. No vayas tan despacio que el viento se lleve la proa.</li>\n<li>Con tu propia ancla, fondea un poco a barlovento de tu puesto. Así la cadena aguanta la proa mientras das atrás.</li>\n<li>Si sale mal, sal, recoloca y vuelve a intentarlo. No hay nada de malo en una segunda aproximación.</li>\n</ul>\n</section>\n<section id=\"practise\">\n<h2>Practícalo en el agua</h2>\n<p>En nuestros cursos lo practicas en puertos reales, con muerto y con tu propia ancla, hasta que cada tripulante ha hecho todas las funciones. Empiezas con poco viento y pasas a puestos con viento de través cuando la rutina ya sale con calma.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">International Bareboat Skipper</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es/courses/bareboat-skipper\">Ver el curso</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"En esta página\"><span class=\"kicker\">En esta página</span><ol class=\"toc-list\"><li><a href=\"#two-ways\">Dos maneras de amarrar</a></li><li><a href=\"#prepare\">Preparación</a></li><li><a href=\"#read-berth\">Viento, hueco y efecto de la hélice</a></li><li><a href=\"#sequence\">Paso a paso</a></li><li><a href=\"#crossed-anchors\">Cadenas cruzadas</a></li><li><a href=\"#leaving\">Salir del amarre</a></li><li><a href=\"#crosswind\">Consejos con viento de través</a></li><li><a href=\"#practise\">Practícalo</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">International Bareboat Skipper</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es/courses/bareboat-skipper\">Ver el curso</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Teoría</span><h2 class=\"h2\" style=\"margin-top:12px\">Sigue leyendo</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/es/theory\">Toda la teoría</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Más teoría\"><a class=\"card\" href=\"/es/theory/berthing-alongside\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1533105079780-92b9be482077?w=900&q=80&auto=format&fit=crop\" alt=\"Escalones encalados que bajan al mar\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Atracar de costado y salir con springs</span><span class=\"card-meta\">Cómo atracar de costado a un muelle o pantalán: defensas, cabos y springs, ángulo de aproximación, viento y efecto de la hélice, el primer cabo a tierra, desatracar con springs y abarloarse en balsa.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/anchoring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=900&q=80&auto=format&fit=crop\" alt=\"Barcos fondeados en una cala turquesa\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Fondeo: el sitio, la cadena, el agarre</span><span class=\"card-meta\">Cómo fondear un velero: elegir una bahía resguardada con buen tenedero, cuánta cadena filar, hacer que el ancla agarre, comprobar que aguanta y dar cabos a tierra.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Un velero navegando de ceñida en mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Rumbos: cómo navega un velero cerca del viento</span><span class=\"card-meta\">Aprende los rumbos, de la ceñida a la popa: la zona muerta, el trimado en cada rumbo, la virada por avante y la trasluchada, el viento aparente y la lectura de los catavientos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Una goleta con todas las velas izadas\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Seis nudos que usa todo tripulante</span><span class=\"card-meta\">Seis nudos que necesita todo tripulante: as de guía, ballestrinque, vuelta redonda y dos medios cotes, nudo de cornamusa, nudo de ocho y nudo llano, paso a paso.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Dos navegantes al timón navegando a vela\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Virada por avante y trasluchada, paso a paso</span><span class=\"card-meta\">Cómo virar por avante y trasluchar en un velero: las voces, el trabajo de cada tripulante, winches sin vueltas montadas, la trasluchada controlada, cómo salir si te quedas aproado y consejos para catamaranes.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Dos tripulantes trabajan junto al mástil con brisa fresca\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Rizos: cuándo y cómo reducir vela</span><span class=\"card-meta\">Cuándo y cómo tomar rizos en un velero: las señales de que ha llegado el momento, rizos de faja paso a paso, mayor enrollable en el mástil, enrollar el génova, equilibrio de velas y largar rizos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Prototipo de diseño. Los precios, las fechas y las personas son contenido de ejemplo. Fotos vía Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Quiénes somos</a><a href=\"#\">Telegram</a><a href=\"#\">Privacidad</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}