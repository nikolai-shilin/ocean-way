/symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/safety-on-board\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/safety-on-board\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/safety-on-board\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/safety-on-board\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Radio and safety</li></ol></nav>\n        <h1 class=\"display\">Safety on board: the gear and the briefing</h1>\n        <p class=\"lead\">Every yacht carries safety equipment, and every crew member should know where it is and how to use it. This is what the skipper's briefing covers, from lifejackets to the liferaft.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">All crew</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#briefing\">The safety briefing</a></li><li><a href=\"#lifejackets\">Lifejackets</a></li><li><a href=\"#harness\">Harnesses and jackstays</a></li><li><a href=\"#liferaft\">Liferaft and grab bag</a></li><li><a href=\"#beacons\">EPIRB and PLB</a></li><li><a href=\"#flares\">Flares</a></li><li><a href=\"#fire-gas\">Fire and gas</a></li><li><a href=\"#water-first-aid\">Leaks, pumps and first aid</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>The skipper's briefing shows every crew member where the safety gear is.</li><li>Wear a 150N lifejacket with crotch straps, and clip on at night and in rough weather.</li><li>Only take to the liferaft when the yacht is sinking: step up, never down.</li><li>Turn gas off at the bottle, and know where the extinguishers, seacocks and bungs are.</li></ul></div>\n          <section id=\"briefing\">\n<h2>The skipper's safety briefing</h2>\n<p>Before the yacht leaves the berth, the skipper gives the crew a safety briefing. Everyone should know the answers by the end, because the person who needs help may be the skipper. A good briefing covers:</p>\n<ul>\n<li>Lifejackets and harnesses: where they are, how to fit them and when to wear them.</li>\n<li>Moving on deck and the man overboard drill.</li>\n<li>The liferaft, the grab bag and the EPIRB.</li>\n<li>Flares: where they are and how to fire each type.</li>\n<li>Fire extinguishers, the fire blanket and the gas system.</li>\n<li>The VHF radio and how to send a distress call.</li>\n<li>The first aid kit and any medical needs on board.</li>\n<li>Bilge pumps, seacocks and the wooden bungs.</li>\n<li>Seasickness, sun and how to use the heads (toilet).</li>\n</ul>\n<p>Equipment varies by boat and by country, so always check the boat's own equipment and the charter company's list.</p>\n</section>\n<section id=\"lifejackets\">\n<h2>Lifejackets and buoyancy aids</h2>\n<p>Buoyancy is measured in newtons (N). Cruising yachts usually carry automatic inflating lifejackets of 150N.</p>\n<table class=\"tbl\"><thead><tr><th>Type</th><th>Lifejacket, 150N</th><th>Buoyancy aid, 50N</th></tr></thead><tbody>\n<tr><td>How it floats</td><td>Inflates from a gas cylinder</td><td>Foam, always buoyant</td></tr>\n<tr><td>Turns a person face up</td><td>Yes, in most cases</td><td>No</td></tr>\n<tr><td>Best use</td><td>On a yacht at sea</td><td>Dinghy sailing or watersports near help</td></tr>\n</tbody></table>\n<p><b>Inflation.</b> An automatic lifejacket inflates by itself within seconds of immersion. It also has a pull toggle to fire it by hand and a tube to top it up by mouth.</p>\n<p><b>Fitting.</b> Tighten the waist strap until it is snug and the lifejacket cannot be pulled over your head. Always fasten the crotch straps (between the legs), or it can ride up over your face in the water.</p>\n<p><b>Checking.</b> Check that the gas cylinder is screwed in tight and unused, and the automatic firing unit is in date. Many show a green indicator when ready.</p>\n<p><b>When to wear one.</b> Always at night, in rough weather or poor visibility, and in the dinghy. Non-swimmers and children wear one at all times on deck, children in a lifejacket made for their size. Otherwise, whenever the skipper asks.</p>\n</section>\n<section id=\"harness\">\n<h2>Harnesses, tethers and jackstays</h2>\n<p>A lifejacket helps once you are in the water. A harness keeps you out of it. Most yacht lifejackets have one built in, with a ring at the chest for a tether (a short strap with a safety hook at each end).</p>\n<ul>\n<li><b>Jackstays.</b> These strong lines run along each side deck from bow to stern, so you can walk the length of the boat without unclipping.</li>\n<li><b>Clip on first.</b> At night and in rough weather, clip on to a strong point before you come up the companionway (the steps from the cabin), and stay clipped on.</li>\n<li><b>Strong points only.</b> Clip to jackstays and to fittings made for the purpose, never to the guardrails (the wires round the deck edge).</li>\n<li><b>Short is better.</b> A tether that keeps you on deck is safer than one long enough to let you over the side. Many have two lengths for this reason.</li>\n</ul>\n</section>\n<section id=\"liferaft\">\n<h2>Liferaft and grab bag</h2>\n<p>The liferaft is packed in a canister on deck or a soft valise in a cockpit locker. Find out where it is. Its painter (the line that ties it to the yacht) also fires the gas that inflates it.</p>\n<ol>\n<li>Check that the painter is tied to a strong point on the yacht.</li>\n<li>Throw the liferaft over the leeward (downwind) side.</li>\n<li>Pull out the painter until it comes tight, then give a sharp tug to inflate the raft.</li>\n<li>Pull it alongside and board it as dry as you can, heaviest crew first.</li>\n<li>Once everyone is in, cut the painter with the knife kept by the raft entrance.</li>\n</ol>\n<aside class=\"note warn\"><b>Watch out</b><p>A yacht, even a damaged one, is easier to find and safer than a liferaft. Only abandon her when she is sinking or on fire beyond control. The old rule: step up into the liferaft, never down.</p></aside>\n<p><b>Grab bag.</b> This waterproof, floating bag is kept near the companionway, ready to take into the raft. It usually holds a handheld VHF, flares, a torch, drinking water, seasickness tablets, sun cream, essential medicines and copies of passports and the boat's papers.</p>\n</section>\n<section id=\"beacons\">\n<h2>EPIRB and PLB</h2>\n<p>These beacons send a distress signal by satellite to the rescue services, with an identity code and usually a GPS position.</p>\n<ul>\n<li><b>EPIRB.</b> The Emergency Position Indicating Radio Beacon belongs to the boat. Some float free automatically if the yacht sinks. Others are switched on by hand.</li>\n<li><b>PLB.</b> A Personal Locator Beacon is smaller and belongs to a person. You carry it on your lifejacket and switch it on yourself, holding the aerial upright.</li>\n</ul>\n<p>Every beacon must be registered in the country it is coded for, so rescuers know whose it is and whom to call. Check the battery date, and use only the maker's self-test.</p>\n</section>\n<section id=\"flares\">\n<h2>Flares</h2>\n<p>Flares show rescuers where you are. Each type has its own job:</p>\n<table class=\"tbl\"><thead><tr><th>Flare</th><th>When to use it</th></tr></thead><tbody>\n<tr><td>Red handheld flare</td><td>At night or by day, when rescuers are close and need to pinpoint you</td></tr>\n<tr><td>Orange smoke</td><td>By day, to show a helicopter or aircraft where you are and the wind direction</td></tr>\n<tr><td>Red parachute rocket</td><td>To raise the alarm at a distance, when nobody is in sight</td></tr>\n</tbody></table>\n<p><b>Firing safely.</b> Read the instructions on each flare before you need it. Hold a handheld flare at arm's length on the downwind side, pointing away from you, and do not look at it. Fire a rocket upwards, angled slightly downwind, never when a helicopter is close.</p>\n<p><b>Expiry.</b> Every flare has an expiry date. Hand old flares in through an approved disposal scheme. Never throw them away or set them off.</p>\n</section>\n<section id=\"fire-gas\">\n<h2>Fire and gas</h2>\n<p><b>Extinguishers.</b> Learn where each one is. Pull the pin, aim at the base of the flames and sweep from side to side. If a fire cannot be put out quickly, get everyone on deck and call for help.</p>\n<p><b>Fire blanket.</b> This hangs by the galley (kitchen). For a pan fire, turn off the gas, pull the tapes, lay the blanket over the pan and leave it in place. Never pour water on burning oil.</p>\n<p><b>Gas safety.</b> Bottled gas is heavier than air, so a leak sinks into the bilge (the lowest part of the hull) and can explode. Turn the gas off at the bottle when the stove is not in use. The gas locker drains overboard: keep its drain clear and do not store anything else there. If you smell gas, turn it off at the bottle, use no flames or electrical switches, open the hatches and pump the bilge with the manual pump.</p>\n</section>\n<section id=\"water-first-aid\">\n<h2>Leaks, pumps and first aid</h2>\n<p><b>Bilge pumps.</b> Most yachts have an electric bilge pump, often automatic, and a manual pump worked from the cockpit. Know where its handle is kept, and look in the bilge every day.</p>\n<p><b>Seacocks.</b> These valves close the through-hull fittings (holes in the hull) for the toilet, sinks and engine cooling water. Learn where each one is, and which the skipper wants closed when not in use.</p>\n<p><b>Wooden bungs.</b> A tapered softwood plug should be tied next to each seacock. If a fitting breaks, you hammer the bung into the hole to stop the water.</p>\n<p><b>First aid kit.</b> Know where it is and what is in it. Bring your own medicines, and tell the skipper about any condition that matters. For serious injury or illness, the coastguard can give medical advice by radio.</p>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On the Introduction to Yachting course the skipper gives a full safety briefing on the first day, and you give one yourself before the week ends. You fit your own lifejacket and harness, find every seacock and bung, and handle the safety gear so you know where everything is before you need it.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Introduction to Yachting</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#briefing\">The safety briefing</a></li><li><a href=\"#lifejackets\">Lifejackets</a></li><li><a href=\"#harness\">Harnesses and jackstays</a></li><li><a href=\"#liferaft\">Liferaft and grab bag</a></li><li><a href=\"#beacons\">EPIRB and PLB</a></li><li><a href=\"#flares\">Flares</a></li><li><a href=\"#fire-gas\">Fire and gas</a></li><li><a href=\"#water-first-aid\">Leaks, pumps and first aid</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Introduction to Yachting</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/vhf-procedure\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1528154291023-a6525fabe5b4?w=900&q=80&auto=format&fit=crop\" alt=\"A boat seen from above on dark water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">All crew</span><span class=\"card-title\">VHF radio: Mayday, Pan-Pan and everyday calls</span><span class=\"card-meta\">Marine VHF procedure in plain English: channel 16, DSC distress alerts, the phonetic alphabet, Mayday and Pan-Pan formats with examples, and marina calls.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>5 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/man-overboard\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1732267994253-4b9e4fd70a41?w=900&q=80&auto=format&fit=crop\" alt=\"A crew in sailing jackets on deck in open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">All crew</span><span class=\"card-title\">Man overboard: getting someone back</span><span class=\"card-meta\">Man overboard for yacht crews: prevention, the first seconds, when to send a Mayday, recovery under engine or sail, and getting the person back aboard safely.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Two sailors at the wheel under sail\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Tacking and gybing, step by step</span><span class=\"card-meta\">How to tack and gybe a sailing yacht: the calls, crew jobs, winches without riding turns, a controlled gybe, getting out of irons and tips for catamarans.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Two crew working at the mast in a fresh breeze\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reefing: when and how to shorten sail</span><span class=\"card-meta\">When and how to reef a sailing yacht: signs it is time, slab reefing step by step, in-mast furling mains, rolling in the genoa, sail balance and shaking out.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}