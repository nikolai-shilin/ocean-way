.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/points-of-sail\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/points-of-sail\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/points-of-sail\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/points-of-sail\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Основы яхтинга</li></ol></nav>\n        <h1 class=\"display\">Курсы относительно ветра: как яхта ходит круто к ветру</h1>\n        <p class=\"lead\">Яхта не может идти прямо против ветра, но может идти почти под любым другим углом. Здесь — курсы относительно ветра, как настраивать паруса на каждом из них и чем поворот оверштаг отличается от поворота фордевинд.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Новичкам</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#wind\">Ветер и мёртвая зона</a></li><li><a href=\"#points\">Курсы относительно ветра</a></li><li><a href=\"#trim\">Приведение и уваливание</a></li><li><a href=\"#tacking-gybing\">Повороты оверштаг и фордевинд</a></li><li><a href=\"#apparent-wind\">Истинный и вымпельный ветер</a></li><li><a href=\"#telltales\">Читаем колдунчики</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Ближе примерно 45° к ветру не работает ни один парус: это мёртвая зона.</li><li>Приводитесь — выбирайте шкоты; уваливаетесь — травите.</li><li>При повороте оверштаг линию ветра пересекает нос, при повороте фордевинд — корма, и гик перебрасывается на другой борт.</li><li>Колдунчики показывают обтекание: настраивайте паруса или подруливайте, пока оба не будут ровно тянуться назад.</li></ul></div>\n          <section id=\"wind\">\n<h2>Откуда дует ветер</h2>\n<p>На парусной яхте всё начинается с направления ветра. Прежде чем браться за шкот (конец, которым управляют парусом), определите, откуда дует ветер. Почувствуйте его лицом и ушами, посмотрите на ветроуказатель на топе мачты и на рябь на воде.</p>\n<p>Парус не может вести яхту прямо против ветра. Есть сектор, примерно 45° в обе стороны от ветра, где паруса просто полощут, а яхта теряет ход. Это мёртвая зона. Точный угол зависит от яхты и волны: современная круизная яхта на ровной воде может идти чуть круче, а тяжёлая лодка на короткой крутой волне так круто не пойдёт. Если вы привелись в мёртвую зону и остановились, вы «в левентике»: яхта стоит носом к ветру и не слушается руля.</p>\n<p>Все остальные направления вам доступны. Названия углов между вашим курсом и ветром — это и есть курсы относительно ветра.</p>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 480\" role=\"img\" aria-label=\"Курсы относительно ветра вокруг направления ветра, мёртвая зона — около 45 градусов в обе стороны от ветра\"><path class=\"dg-nogo\" d=\"M320,250 L187.4,117.4 A187.5,187.5 0 0 1 452.6,117.4 Z\"/><text class=\"dg-label dg-muted\" x=\"320\" y=\"94\" text-anchor=\"middle\">Мёртвая зона</text><circle class=\"dg-ring\" cx=\"320\" cy=\"250\" r=\"150\"/><g class=\"dg-boat \" transform=\"translate(426.1 143.9) rotate(45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"2.1\" y2=\"9.9\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"123.9\" text-anchor=\"start\">Бейдевинд</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 143.9) rotate(-45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-2.1\" y2=\"9.9\"/></g><g class=\"dg-boat \" transform=\"translate(455.9 186.6) rotate(65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"6.3\" y2=\"8.6\"/></g><text class=\"dg-label\" x=\"486.8\" y=\"176.2\" text-anchor=\"start\">Полный бейдевинд</text><g class=\"dg-boat dg-faint\" transform=\"translate(184.1 186.6) rotate(-65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-6.3\" y2=\"8.6\"/></g><g class=\"dg-boat \" transform=\"translate(470.0 250.0) rotate(90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"10.6\" y2=\"5.6\"/></g><text class=\"dg-label\" x=\"504.0\" y=\"254.0\" text-anchor=\"start\">Галфвинд</text><g class=\"dg-boat dg-faint\" transform=\"translate(170.0 250.0) rotate(-90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-10.6\" y2=\"5.6\"/></g><g class=\"dg-boat \" transform=\"translate(426.1 356.1) rotate(135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"13.6\" y2=\"1.3\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"384.1\" text-anchor=\"start\">Бакштаг</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 356.1) rotate(-135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-13.6\" y2=\"1.3\"/></g><g class=\"dg-boat \" transform=\"translate(320.0 400.0) rotate(180)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"14.9\" y2=\"-3.7\"/></g><text class=\"dg-label\" x=\"320.0\" y=\"456.0\" text-anchor=\"middle\">Фордевинд</text><line class=\"dg-wind\" x1=\"320\" y1=\"18\" x2=\"320\" y2=\"64\"/><path class=\"dg-windhead\" d=\"M313,56 L320,70 L327,56Z\"/><text class=\"dg-label\" x=\"332\" y=\"34\">Ветер</text><text class=\"dg-label dg-muted\" x=\"496\" y=\"290\" text-anchor=\"start\">Левый галс</text><text class=\"dg-label dg-muted\" x=\"144\" y=\"290\" text-anchor=\"end\">Правый галс</text></svg></div><figcaption class=\"disclaimer\">Курсы относительно ветра, ветер сверху. Внутри мёртвой зоны, примерно 45° в обе стороны от ветра, не может идти ни одна яхта; у яхт справа ветер дует в левый борт (левый галс), бледные слева идут правым галсом.</figcaption></figure>\n</section>\n<section id=\"points\">\n<h2>Курсы относительно ветра</h2>\n<p>Каждый курс относительно ветра описывает угол между носом яхты и ветром. Важно и то, с какого борта дует ветер: если ветер дует в правый борт, вы идёте правым галсом, если в левый — левым галсом. Названия ниже одинаковы на обоих галсах.</p>\n<h3>Бейдевинд</h3>\n<p>Около 45° к ветру, сразу за границей мёртвой зоны. Оба паруса выбраны втугую, близко к диаметральной плоскости яхты. На этом курсе крен (наклон яхты) самый большой, качка живее, на нос могут лететь брызги. Рулите мелкими движениями, держа паруса едва наполненными.</p>\n<h3>Полный бейдевинд</h3>\n<p>Около 60° к ветру. Немного потравите шкоты (отпустите их) по сравнению с бейдевиндом. Крен меньше, и яхта обычно разгоняется.</p>\n<h3>Галфвинд</h3>\n<p>Ветер под 90°, прямо в борт. Паруса потравлены примерно наполовину. Для большинства круизных яхт это быстрый и удобный курс, и на нём хорошо учиться.</p>\n<h3>Бакштаг</h3>\n<p>Около 135°, ветер дует из-за траверза, в кормовую четверть яхты. Паруса сильно потравлены. Яхта стоит ровнее, а ветер кажется слабее, чем на самом деле. На зыби её может начать валять с борта на борт.</p>\n<h3>Фордевинд</h3>\n<p>Ветер дует прямо сзади, примерно под 180°. Грот потравлен полностью, а передний парус (стаксель или генуя) часто безжизненно висит в его тени. Передний парус можно вынести на противоположный гроту борт — это называется «бабочка». На фордевинде выше всего риск случайного поворота, поэтому многие шкиперы предпочитают бакштаг и меняют направление ступеньками.</p>\n<table class=\"tbl\"><thead><tr><th>Курс</th><th>Угол к ветру</th><th>Паруса</th><th>Ощущения</th></tr></thead><tbody>\n<tr><td>Бейдевинд</td><td>Около 45°</td><td>Выбраны втугую</td><td>Крен, живо, мокро</td></tr>\n<tr><td>Полный бейдевинд</td><td>Около 60°</td><td>Немного потравлены</td><td>Быстро, крен меньше</td></tr>\n<tr><td>Галфвинд</td><td>90°</td><td>Потравлены наполовину</td><td>Ровно, удобно</td></tr>\n<tr><td>Бакштаг</td><td>Около 135°</td><td>Сильно потравлены</td><td>Ровно, может валять</td></tr>\n<tr><td>Фордевинд</td><td>Около 180°</td><td>Потравлены полностью</td><td>Тихо на палубе, валяет</td></tr>\n</tbody></table>\n</section>\n<section id=\"trim\">\n<h2>Приведение и уваливание</h2>\n<p>Поворот к ветру называется приведением, от ветра — уваливанием. Настройка парусов подчиняется простому правилу: приводитесь — выбирайте шкоты, уваливаетесь — травите. Каждая смена курса требует перенастройки парусов.</p>\n<p>Надёжная проверка: травите шкот, пока передняя шкаторина (передний край паруса) не начнёт заполаскивать, а затем выбирайте, пока заполаскивание не прекратится. Примерно это и есть правильная настройка для вашего курса.</p>\n<p>Две ошибки встречаются часто. Шкоты, выбранные слишком туго на полных курсах, дают крен и тормозят яхту, хотя парус выглядит наполненным и спокойным. Шкоты, потравленные слишком сильно, заставляют парус полоскать: это стоит скорости и изнашивает ткань. На бакштаге и фордевинде также следите, чтобы гик не упирался в ванты (тросы, которые держат мачту с боков).</p>\n</section>\n<section id=\"tacking-gybing\">\n<h2>Повороты оверштаг и фордевинд</h2>\n<p>Чтобы перейти с одного галса на другой, нужно провести через линию ветра либо нос, либо корму.</p>\n<p><b>Поворот оверштаг</b> — это поворот, при котором через линию ветра проходит нос. Так продвигаются против ветра, лавируя зигзагом из бейдевинда одного галса в бейдевинд другого. Шкот переднего паруса раздают на старом борту и выбирают на новом. Гик перемещается совсем немного, потому что грот и так выбран втугую. Рулевой (тот, кто стоит на руле) командует «К повороту оверштаг», экипаж отвечает «Готов», и рулевой командует «Поворот», начиная поворачивать.</p>\n<p><b>Поворот фордевинд</b> — это поворот, при котором через линию ветра проходит корма. Его выполняют на попутных курсах. На этот раз ветер заходит за грот и перебрасывает гик через всю ширину яхты. При управляемом повороте фордевинд рулевой командует «К повороту фордевинд», экипаж выбирает гика-шкот и подтягивает гик к диаметральной плоскости, рулевой поворачивает, а затем гика-шкот снова травят на новом борту.</p>\n<aside class=\"note warn\"><b>Осторожно</b><p>Случайный поворот фордевинд случается, когда вы слишком уваливаетесь и ветер задувает грот с обратной стороны. Гик тогда без предупреждения перелетает на другой борт. Он может серьёзно травмировать любого на своём пути и повредить рангоут и такелаж. На фордевинде держите голову ниже траектории гика, держите ветер немного с борта, противоположного гику, и ставьте завал гика (конец, удерживающий гик в положении вперёд), когда шкипер об этом просит.</p></aside>\n</section>\n<section id=\"apparent-wind\">\n<h2>Истинный и вымпельный ветер</h2>\n<p>Истинный ветер — это тот, что вы чувствуете, стоя на причале. Когда яхта движется, её собственная скорость создаёт встречный поток, и вместе они дают вымпельный ветер: тот, что вы чувствуете на палубе и которым на самом деле работают паруса. На острых курсах вымпельный ветер кажется сильнее и дует ближе к носу, чем истинный. На попутных он кажется слабее. Поэтому мягкий бакштаг может превратиться в тяжёлую лавировку, стоит привестись. Ветроуказатель и колдунчики всегда показывают вымпельный ветер.</p>\n</section>\n<section id=\"telltales\">\n<h2>Читаем колдунчики</h2>\n<p>Колдунчики — короткие полоски шерсти или ленты с обеих сторон переднего паруса, чуть позади передней шкаторины. Они показывают, как воздух обтекает парус, и реагируют задолго до того, как сам парус начнёт заполаскивать.</p>\n<ul>\n<li><b>Оба ровно тянутся назад:</b> парус настроен правильно. Так и держите.</li>\n<li><b>Наветренный колдунчик поднимается или крутится</b> (со стороны, откуда дует ветер): парус слишком потравлен для вашего курса. Выберите шкот или немного увальтесь.</li>\n<li><b>Подветренный колдунчик поднимается или крутится</b> (со стороны, противоположной ветру): парус выбран слишком туго. Потравите шкот или немного приведитесь.</li>\n</ul>\n<p>В бейдевинд шкот и так выбран втугую, поэтому поправляйтесь рулём: уваливайтесь, когда поднимается наветренный колдунчик, приводитесь, когда подветренный. На полных курсах держите курс и работайте шкотом. На многих гротах есть колдунчики и на задней шкаторине (заднем крае). Если они тянутся назад, грот не перебран.</p>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На курсе Introduction to Yachting вы пройдёте все курсы относительно ветра, по очереди стоя на руле и на шкотах, пока настройка по колдунчикам не войдёт в привычку. Повороты оверштаг и управляемые повороты фордевинд вы много раз отработаете при умеренном ветре, прежде чем делать их в более свежий.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Introduction to Yachting</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#wind\">Ветер и мёртвая зона</a></li><li><a href=\"#points\">Курсы относительно ветра</a></li><li><a href=\"#trim\">Приведение и уваливание</a></li><li><a href=\"#tacking-gybing\">Повороты оверштаг и фордевинд</a></li><li><a href=\"#apparent-wind\">Истинный и вымпельный ветер</a></li><li><a href=\"#telltales\">Читаем колдунчики</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Introduction to Yachting</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Двое яхтсменов за штурвалом под парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Повороты оверштаг и фордевинд, шаг за шагом</span><span class=\"card-meta\">Как делать повороты оверштаг и фордевинд на парусной яхте: команды, обязанности экипажа, работа с лебёдкой без захлёстов, управляемый фордевинд, выход из левентика и советы для катамаранов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Двое из экипажа работают у мачты на свежем ветру\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Рифы: когда и как уменьшать парусность</span><span class=\"card-meta\">Когда и как брать рифы на парусной яхте: признаки, что пора, слаб-риф шаг за шагом, грот на закрутке в мачту, закрутка генуи, баланс парусов и отдача рифов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Моторная яхта идёт открытым морем\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Правила расхождения в море: что шкиперы применяют каждый день</span><span class=\"card-meta\">МППСС, которые шкипер яхты применяет каждый день: наблюдение, безопасная скорость, опасность столкновения, кто уступает дорогу под парусом и под мотором, обгон, ход под парусами с мотором и фарватеры.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Яхта под звёздным ночным небом\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Навигационные огни и дневные знаки</span><span class=\"card-meta\">Топовый, бортовые и кормовой огни, трёхцветный фонарь, якорный огонь и дневные знаки по части C МППСС, а также как распознать ночью рыболовные суда, буксиры и большие суда.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"Шкипер за штурвалом выходит из гавани\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Буи и знаки: система IALA</span><span class=\"card-meta\">Латеральные и кардинальные знаки, знаки отдельной опасности и безопасных вод, специальные знаки в регионе A системы IALA: окраска, топовые фигуры, ритмы огней и как читать огонь на карте.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}