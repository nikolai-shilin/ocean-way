6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/de\" aria-label=\"Ocean Way, Startseite\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Hauptmenü\">\n      <a class=\"navl\" href=\"/de#courses\">Kurse</a>\n      <a class=\"navl\" href=\"/de#passages\">Törns</a>\n      <a class=\"navl on\" href=\"/de/theory\">Theorie</a>\n      <a class=\"navl\" href=\"/de#fleet\">Flotte</a>\n      <a class=\"navl\" href=\"#\">Preise</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Sprache: Deutsch\">DE</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/points-of-sail\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/points-of-sail\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/points-of-sail\" hreflang=\"de\" lang=\"de\" aria-current=\"true\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/points-of-sail\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Farbschema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Gemerkt\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Konto\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Navigationspfad\"><ol><li><a href=\"/de\">Startseite</a></li><li><a href=\"/de/theory\">Theorie</a></li><li aria-current=\"page\">Segelgrundlagen</li></ol></nav>\n        <h1 class=\"display\">Kurse zum Wind: Wie eine Yacht hoch am Wind segelt</h1>\n        <p class=\"lead\">Direkt gegen den Wind kann eine Yacht nicht segeln, aber in fast jedem anderen Winkel. Hier sind die Kurse zum Wind, der passende Trimm für jeden und der Unterschied zwischen Wende und Halse.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ausbilder von Ocean Way</span><span class=\"meta\">Aktualisiert am 1. Nov. 2026</span><span class=\"meta\">6 Min. Lesezeit</span><span class=\"lvl\">Einsteiger</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>Auf dieser Seite<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#wind\">Der Wind und der tote Winkel</a></li><li><a href=\"#points\">Die Kurse zum Wind</a></li><li><a href=\"#trim\">Anluven und Abfallen</a></li><li><a href=\"#tacking-gybing\">Wende und Halse</a></li><li><a href=\"#apparent-wind\">Wahrer und scheinbarer Wind</a></li><li><a href=\"#telltales\">Windfäden lesen</a></li><li><a href=\"#practise\">Auf dem Wasser üben</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Kurz gesagt</span><ul><li>Innerhalb von etwa 45° zum Wind zieht kein Segel: Das ist der tote Winkel.</li><li>Beim Anluven dichtholen, beim Abfallen fieren.</li><li>Bei der Wende geht der Bug durch den Wind, bei der Halse das Heck, und der Baum schwingt ganz hinüber.</li><li>Windfäden zeigen die Luftströmung: Trimme oder steuere, bis beide nach hinten wehen.</li></ul></div>\n          <section id=\"wind\">\n<h2>Woher der Wind kommt</h2>\n<p>Auf einer Segelyacht beginnt alles mit der Windrichtung. Bevor du eine Schot (eine Leine, mit der ein Segel bedient wird) anfasst, finde heraus, woher der Wind kommt. Spür ihn im Gesicht und an den Ohren, schau auf den Windanzeiger im Masttopp und beobachte die Kräuselungen auf dem Wasser.</p>\n<p>Ein Segel kann eine Yacht nicht direkt gegen den Wind antreiben. Es gibt einen Sektor, etwa 45° zu beiden Seiten des Windes, in dem die Segel nur killen und das Boot langsamer wird. Das ist der tote Winkel. Der genaue Winkel hängt von Boot und Seegang ab: Eine moderne Fahrtenyacht in glattem Wasser läuft vielleicht etwas höher, ein schweres Boot in kurzer, steiler See segelt nicht so hoch. Drehst du in den toten Winkel und bleibst stehen, „stehst du im Wind“: Der Bug zeigt in den Wind, und das Ruder greift nicht mehr.</p>\n<p>Alle anderen Richtungen stehen dir offen. Die Winkel zwischen deinem Kurs und dem Wind heißen Kurse zum Wind.</p>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 480\" role=\"img\" aria-label=\"Kurse zum Wind rund um die Windrichtung, mit dem toten Winkel von etwa 45 Grad zu beiden Seiten des Windes\"><path class=\"dg-nogo\" d=\"M320,250 L187.4,117.4 A187.5,187.5 0 0 1 452.6,117.4 Z\"/><text class=\"dg-label dg-muted\" x=\"320\" y=\"94\" text-anchor=\"middle\">Toter Winkel</text><circle class=\"dg-ring\" cx=\"320\" cy=\"250\" r=\"150\"/><g class=\"dg-boat \" transform=\"translate(426.1 143.9) rotate(45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"2.1\" y2=\"9.9\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"123.9\" text-anchor=\"start\">Hoch am Wind</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 143.9) rotate(-45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-2.1\" y2=\"9.9\"/></g><g class=\"dg-boat \" transform=\"translate(455.9 186.6) rotate(65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"6.3\" y2=\"8.6\"/></g><text class=\"dg-label\" x=\"486.8\" y=\"176.2\" text-anchor=\"start\">Am Wind</text><g class=\"dg-boat dg-faint\" transform=\"translate(184.1 186.6) rotate(-65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-6.3\" y2=\"8.6\"/></g><g class=\"dg-boat \" transform=\"translate(470.0 250.0) rotate(90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"10.6\" y2=\"5.6\"/></g><text class=\"dg-label\" x=\"504.0\" y=\"254.0\" text-anchor=\"start\">Halbwind</text><g class=\"dg-boat dg-faint\" transform=\"translate(170.0 250.0) rotate(-90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-10.6\" y2=\"5.6\"/></g><g class=\"dg-boat \" transform=\"translate(426.1 356.1) rotate(135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"13.6\" y2=\"1.3\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"384.1\" text-anchor=\"start\">Raumer Wind</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 356.1) rotate(-135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-13.6\" y2=\"1.3\"/></g><g class=\"dg-boat \" transform=\"translate(320.0 400.0) rotate(180)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"14.9\" y2=\"-3.7\"/></g><text class=\"dg-label\" x=\"320.0\" y=\"456.0\" text-anchor=\"middle\">Vor dem Wind</text><line class=\"dg-wind\" x1=\"320\" y1=\"18\" x2=\"320\" y2=\"64\"/><path class=\"dg-windhead\" d=\"M313,56 L320,70 L327,56Z\"/><text class=\"dg-label\" x=\"332\" y=\"34\">Wind</text><text class=\"dg-label dg-muted\" x=\"496\" y=\"290\" text-anchor=\"start\">Backbordbug</text><text class=\"dg-label dg-muted\" x=\"144\" y=\"290\" text-anchor=\"end\">Steuerbordbug</text></svg></div><figcaption class=\"disclaimer\">Kurse zum Wind, der Wind kommt von oben. Im toten Winkel, etwa 45° zu beiden Seiten des Windes, kann keine Yacht segeln; die Boote rechts haben den Wind von Backbord (Backbordbug), die blassen links segeln auf Steuerbordbug.</figcaption></figure>\n</section>\n<section id=\"points\">\n<h2>Die Kurse zum Wind</h2>\n<p>Jeder Kurs zum Wind beschreibt den Winkel zwischen dem Bug (dem vorderen Ende des Boots) und dem Wind. Auch die Seite, von der der Wind kommt, zählt: Kommt er von Steuerbord (rechts), segelst du auf Steuerbordbug, kommt er von Backbord (links), auf Backbordbug. Die Namen unten gelten auf beiden Bugen.</p>\n<h3>Hoch am Wind</h3>\n<p>Etwa 45° zum Wind, knapp außerhalb des toten Winkels. Beide Segel sind dicht geholt, nah an der Mittschiffslinie. Auf diesem Kurs krängt (neigt sich) die Yacht am stärksten, die Bewegung ist lebhafter, und über den Bug kann Gischt kommen. Du steuerst mit kleinen Bewegungen und hältst die Segel gerade eben voll.</p>\n<h3>Am Wind</h3>\n<p>Etwa 60° zum Wind. Fiere (lockere) die Schoten etwas gegenüber hoch am Wind. Das Boot krängt weniger und wird meist schneller.</p>\n<h3>Halbwind</h3>\n<p>Der Wind kommt mit 90° genau quer von der Seite. Die Segel sind etwa zur Hälfte gefiert. Für die meisten Fahrtenyachten ist das ein schneller und angenehmer Kurs und gut zum Lernen.</p>\n<h3>Raumer Wind</h3>\n<p>Etwa 135°, der Wind kommt achterlicher als querab, schräg von hinten. Die Segel sind weit gefiert. Das Boot liegt aufrechter, und der Wind fühlt sich schwächer an, als er wirklich ist. In der Dünung kann es zu rollen beginnen.</p>\n<h3>Vor dem Wind</h3>\n<p>Der Wind kommt genau von achtern, bei etwa 180°. Das Großsegel ist ganz gefiert, und das Vorsegel (das vordere Segel) hängt oft schlaff in seinem Windschatten. Du kannst das Vorsegel auf die andere Seite als das Großsegel nehmen, das heißt Schmetterling. Vor dem Wind ist eine Patenthalse am wahrscheinlichsten, deshalb segeln viele Skipper lieber raumen Wind und ändern die Richtung in Etappen.</p>\n<table class=\"tbl\"><thead><tr><th>Kurs zum Wind</th><th>Winkel zum Wind</th><th>Segel</th><th>Gefühl an Bord</th></tr></thead><tbody>\n<tr><td>Hoch am Wind</td><td>Etwa 45°</td><td>Dicht geholt</td><td>Krängung, lebhaft, nass</td></tr>\n<tr><td>Am Wind</td><td>Etwa 60°</td><td>Etwas gefiert</td><td>Schnell, weniger Krängung</td></tr>\n<tr><td>Halbwind</td><td>90°</td><td>Halb gefiert</td><td>Stetig, angenehm</td></tr>\n<tr><td>Raumer Wind</td><td>Etwa 135°</td><td>Weit gefiert</td><td>Aufrecht, kann rollen</td></tr>\n<tr><td>Vor dem Wind</td><td>Etwa 180°</td><td>Ganz gefiert</td><td>Ruhig an Deck, rollt</td></tr>\n</tbody></table>\n</section>\n<section id=\"trim\">\n<h2>Anluven und Abfallen</h2>\n<p>Zum Wind hin drehen heißt anluven, vom Wind weg drehen abfallen. Für den Segeltrimm gilt eine einfache Regel: Beim Anluven dichtholen, beim Abfallen fieren. Jede Kursänderung braucht einen neuen Trimm.</p>\n<p>Ein verlässlicher Test: Fiere die Schot, bis das Vorliek (die vordere Kante des Segels) zu flattern beginnt, und hol sie dann gerade so weit dicht, bis das Flattern aufhört. Das ist ungefähr die richtige Einstellung für deinen Kurs.</p>\n<p>Zwei Fehler sind häufig. Zu dicht geholte Schoten bei halbem oder raumem Wind lassen das Boot krängen und bremsen es, obwohl das Segel voll und ruhig aussieht. Zu weit gefierte Schoten lassen das Segel killen, das kostet Fahrt und verschleißt das Tuch. Bei raumem Wind und vor dem Wind prüfe außerdem, dass der Baum nicht gegen die Wanten (die Drähte, die den Mast seitlich halten) drückt.</p>\n</section>\n<section id=\"tacking-gybing\">\n<h2>Wende und Halse</h2>\n<p>Um von einem Bug auf den anderen zu wechseln, drehst du entweder den Bug oder das Heck durch den Wind.</p>\n<p><b>Wende</b> heißt, den Bug durch den Wind zu drehen. So kommst du gegen den Wind voran, im Zickzack von hoch am Wind auf dem einen Bug zu hoch am Wind auf dem anderen. Die Vorschot wird auf der alten Seite losgeworfen und auf der neuen dichtgeholt. Der Baum bewegt sich nur ein kurzes Stück, weil das Großsegel schon dicht ist. Der Rudergänger (wer steuert) ruft „Klar zur Wende“, die Crew antwortet „Ist klar“, und beim Drehen ruft der Rudergänger „Ree“.</p>\n<p><b>Halse</b> heißt, das Heck (das hintere Ende des Boots) durch den Wind zu drehen. Du brauchst sie, wenn du vor dem Wind segelst. Diesmal kommt der Wind hinter das Großsegel und schwingt den Baum über die ganze Breite des Boots. Bei einer kontrollierten Halse ruft der Rudergänger „Klar zur Halse“, die Crew holt die Großschot dicht, um den Baum zur Mitte zu holen, der Rudergänger dreht, und auf der neuen Seite wird die Großschot wieder gefiert.</p>\n<aside class=\"note warn\"><b>Achtung</b><p>Eine Patenthalse passiert, wenn du zu weit vor den Wind steuerst und der Wind das Großsegel von hinten erwischt. Dann schlägt der Baum ohne Vorwarnung hinüber. Er kann jeden in seiner Bahn schwer verletzen und das Rigg beschädigen. Vor dem Wind: Halte den Kopf unterhalb der Bahn des Baums, halte den Wind etwas auf der dem Baum gegenüberliegenden Seite und bring einen Bullenstander (eine Leine, die den Baum nach vorn hält) aus, wenn der Skipper einen verlangt.</p></aside>\n</section>\n<section id=\"apparent-wind\">\n<h2>Wahrer und scheinbarer Wind</h2>\n<p>Der wahre Wind ist das, was du spürst, wenn du still auf dem Kai stehst. Sobald das Boot fährt, erzeugt seine eigene Geschwindigkeit einen Fahrtwind, und beide ergeben zusammen den scheinbaren Wind: den Wind, den du an Deck spürst und den die Segel tatsächlich nutzen. Am Wind fühlt sich der scheinbare Wind stärker an und kommt weiter von vorn als der wahre Wind. Vor dem Wind fühlt er sich schwächer an. Deshalb kann aus einem gemütlichen Kurs mit raumem Wind ein ruppiger Am-Wind-Kurs werden, sobald du anluvst. Windanzeiger und Windfäden zeigen immer den scheinbaren Wind.</p>\n</section>\n<section id=\"telltales\">\n<h2>Windfäden lesen</h2>\n<p>Windfäden sind kurze Woll- oder Bandstreifen auf beiden Seiten des Vorsegels, etwas hinter dem Vorliek. Sie zeigen, wie die Luft am Segel entlangströmt, und reagieren deutlich früher, als das Segel selbst zu flattern beginnt.</p>\n<ul>\n<li><b>Beide wehen gerade nach hinten:</b> Das Segel ist gut getrimmt. Weiter so.</li>\n<li><b>Der luvseitige Faden steigt oder wirbelt</b> (auf der Seite, von der der Wind kommt): Das Segel ist für deinen Kurs zu weit offen. Hol dicht oder fall etwas ab.</li>\n<li><b>Der leeseitige Faden steigt oder wirbelt</b> (auf der windabgewandten Seite): Das Segel ist zu dicht. Fiere die Schot oder luv etwas an.</li>\n</ul>\n<p>Hoch am Wind ist die Schot schon dicht, also korrigierst du mit dem Ruder: Fall ab, wenn der luvseitige Faden steigt, luv an, wenn es der leeseitige tut. Bei halbem oder raumem Wind hältst du den Kurs und trimmst die Schot. Viele Großsegel haben auch Windfäden am Achterliek (der hinteren Kante). Wehen sie nach hinten, ist das Großsegel nicht zu dicht geholt.</p>\n</section>\n<section id=\"practise\">\n<h2>Auf dem Wasser üben</h2>\n<p>Im Kurs Introduction to Yachting segelst du jeden Kurs zum Wind, abwechselnd am Ruder und an den Schoten, bis das Trimmen nach Windfäden zur Gewohnheit wird. Wenden und kontrollierte Halsen übst du viele Male bei mäßigem Wind, bevor du sie bei mehr Wind fährst.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Üben im Kurs</span><div class=\"card-title\">Introduction to Yachting</div><p>Lerne das auf dem Wasser mit einem Ausbilder, in einer Woche an Bord.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/de#courses\">Zu den Kursen</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"Auf dieser Seite\"><span class=\"kicker\">Auf dieser Seite</span><ol class=\"toc-list\"><li><a href=\"#wind\">Der Wind und der tote Winkel</a></li><li><a href=\"#points\">Die Kurse zum Wind</a></li><li><a href=\"#trim\">Anluven und Abfallen</a></li><li><a href=\"#tacking-gybing\">Wende und Halse</a></li><li><a href=\"#apparent-wind\">Wahrer und scheinbarer Wind</a></li><li><a href=\"#telltales\">Windfäden lesen</a></li><li><a href=\"#practise\">Auf dem Wasser üben</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Üben im Kurs</span><div class=\"card-title\">Introduction to Yachting</div><p>Lerne das auf dem Wasser mit einem Ausbilder, in einer Woche an Bord.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/de#courses\">Zu den Kursen</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theorie</span><h2 class=\"h2\" style=\"margin-top:12px\">Weiterlesen</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/de/theory\">Alle Artikel</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Mehr Theorie\"><a class=\"card\" href=\"/de/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Ein Schoner mit allen Segeln gesetzt\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Sechs Knoten, die jedes Crewmitglied braucht</span><span class=\"card-meta\">Sechs Segelknoten, die jedes Crewmitglied braucht: Palstek, Webeleinstek, Rundtörn mit zwei halben Schlägen, Klampenschlag, Achtknoten und Kreuzknoten, Schritt für Schritt.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Segler am Steuerrad unter Segeln\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Einsteiger</span><span class=\"card-title\">Wende und Halse, Schritt für Schritt</span><span class=\"card-meta\">Wie du mit einer Segelyacht wendest und halst: Kommandos, Aufgaben der Crew, Winschen ohne Überläufer, die kontrollierte Halse, was tun, wenn das Boot im Wind steht, und Tipps für Katamarane.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Zwei Crewmitglieder arbeiten bei frischer Brise am Mast\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Reffen: wann und wie du die Segelfläche verkleinerst</span><span class=\"card-meta\">Wann und wie du auf einer Segelyacht reffst: Anzeichen, dass es Zeit ist, Bindereff Schritt für Schritt, Rollgroß, Genua einrollen, Segelbalance und Ausreffen.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Motoryacht auf offenem Wasser\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Ausweichregeln auf See: was Skipper täglich anwenden</span><span class=\"card-meta\">Die KVR, die ein Yachtskipper täglich anwendet: Ausguck, sichere Geschwindigkeit, Kollisionsgefahr, Ausweichregeln für Segel- und Maschinenfahrzeuge, Überholen, Motorsegeln und Fahrwasser.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Eine Yacht unter einem Sternenhimmel\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Lichterführung und Signalkörper</span><span class=\"card-meta\">Topplicht, Seitenlichter und Hecklicht, Dreifarbenlaterne, Ankerlicht und Signalkörper nach KVR Teil C, dazu wie du Fischer, Schleppverbände und Schiffe nachts erkennst.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a><a class=\"card\" href=\"/de/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"Ein Skipper am Steuerrad beim Auslaufen aus dem Hafen\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat Skipper</span><span class=\"card-title\">Tonnen und Seezeichen: das IALA-System</span><span class=\"card-meta\">Lateral-, Kardinal-, Einzelgefahren-, Ansteuerungs- und Sonderzeichen in der IALA-Region A: Farben, Toppzeichen, Kennungen und wie du ein Feuer in der Seekarte liest.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 Min. Lesezeit</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout-Prototyp. Preise, Termine und Personen sind Beispielinhalte. Fotos über Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Über uns</a><a href=\"#\">Telegram</a><a href=\"#\">Datenschutz</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}