.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/es\" aria-label=\"Ocean Way, inicio\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Principal\">\n      <a class=\"navl\" href=\"/es#courses\">Cursos</a>\n      <a class=\"navl\" href=\"/es#passages\">Travesías</a>\n      <a class=\"navl on\" href=\"/es/theory\">Teoría</a>\n      <a class=\"navl\" href=\"/es#fleet\">Flota</a>\n      <a class=\"navl\" href=\"#\">Precios</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Idioma: Español\">ES</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/navigation-lights\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/navigation-lights\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/navigation-lights\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/navigation-lights\" hreflang=\"es\" lang=\"es\" aria-current=\"true\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Tema\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Guardados\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Cuenta\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Ruta de navegación\"><ol><li><a href=\"/es\">Inicio</a></li><li><a href=\"/es/theory\">Teoría</a></li><li aria-current=\"page\">Reglamento de abordajes</li></ol></nav>\n        <h1 class=\"display\">Luces de navegación y marcas diurnas</h1>\n        <p class=\"lead\">De noche, las luces te dicen qué es otro buque, hacia dónde se dirige y quién se mantiene apartado. Esta guía cubre las luces que exhibe un velero y las que te vas a encontrar.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Instructores de Ocean Way</span><span class=\"meta\">Actualizado el 1 nov 2026</span><span class=\"meta\">6 min de lectura</span><span class=\"lvl\">Patrón de chárter</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>En esta página<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#arcs\">Cómo funcionan las luces</a></li><li><a href=\"#under-sail\">A vela</a></li><li><a href=\"#under-engine\">A motor</a></li><li><a href=\"#at-anchor\">Fondeado y marcas diurnas</a></li><li><a href=\"#common-sights\">Lo que verás de noche</a></li><li><a href=\"#practise\">Practícalo</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">En resumen</span><ul><li>Cada luz cubre un sector fijo: tope 225°, costado 112,5° cada una, alcance 135°.</li><li>A vela: luces de costado y de alcance, o una tricolor si mides menos de 20 m. A motor: añade la luz de tope y apaga la tricolor.</li><li>Fondeado: una luz blanca todo horizonte de noche y una bola negra de día.</li><li>Verde sobre blanca es un arrastrero, roja sobre blanca otro tipo de pesca, roja-blanca-roja un buque con capacidad de maniobra restringida.</li></ul></div>\n          <section id=\"arcs\">\n<h2>Cómo funcionan las luces</h2>\n<p>La Parte C del RIPA (el Reglamento Internacional para Prevenir los Abordajes en la Mar, Reglas 20 a 31) establece qué luces y marcas debe exhibir cada buque. Las luces se exhiben desde la puesta hasta la salida del sol y con visibilidad reducida. Las marcas son su equivalente diurno: bolas, conos y biconos negros.</p>\n<p>Cada luz alumbra solo un sector fijo, medido desde la proa. La Regla 21 los define:</p>\n<ul>\n<li><b>Luz de tope</b>: blanca, visible hacia proa en un sector de 225°, desde la proa hasta 22,5° a popa del través (por detrás) de cada banda. Pese a su nombre, en un velero suele ir a media altura en la cara de proa del palo. Muchos navegantes la llaman luz de motor.</li>\n<li><b>Luces de costado</b>: roja en la banda de babor (izquierda) y verde en la de estribor (derecha), cada una en un sector de 112,5°, desde la proa hasta 22,5° a popa del través.</li>\n<li><b>Luz de alcance</b>: blanca, visible hacia popa en 135°, 67,5° a cada lado de la popa.</li>\n<li><b>Luz todo horizonte</b>: de cualquier color, visible en los 360°.</li>\n</ul>\n<p>Los sectores encajan. La luz de alcance cubre justo el sector que las luces de costado y la de tope dejan a oscuras, así que desde cualquier dirección ves una combinación que te dice hacia dónde apunta el otro buque. Si solo ves verde, estás mirando su costado de estribor.</p>\n<p>El alcance mínimo depende del tamaño. En un buque de 12 a 20 metros, la luz de tope debe verse a 3 millas y las de costado y de alcance a 2 millas. Por debajo de 12 metros, las cifras bajan a 2 millas para la de tope y la de alcance, y a 1 milla para las de costado. Las luces de un velero pequeño son débiles. No des por hecho que un buque te ha visto.</p>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 380\" role=\"img\" aria-label=\"Sectores de las luces de navegación vistos desde arriba: luz de tope 225 grados hacia proa, luces de costado roja y verde de 112,5 grados cada una, luz de alcance 135 grados hacia popa\"><path class=\"dg-white\" d=\"M320,215 L158.3,282.0 A175,175 0 1 1 481.7,282.0 Z\"/><path class=\"dg-green\" d=\"M320,215 L320.0,97.0 A118,118 0 0 1 429.0,260.2 Z\"/><path class=\"dg-red\" d=\"M320,215 L211.0,260.2 A118,118 0 0 1 320.0,97.0 Z\"/><path class=\"dg-white dg-stern\" d=\"M320,215 L440.1,264.7 A130,130 0 0 1 199.9,264.7 Z\"/><g class=\"dg-boat \" transform=\"translate(320.0 215.0) scale(1.7)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line style=\"display:none\" class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"0.0\" y2=\"10.0\"/></g><text class=\"dg-label\" x=\"320\" y=\"29\" text-anchor=\"middle\">Luz de tope, blanca, 225°</text><text class=\"dg-label\" x=\"516\" y=\"145\" text-anchor=\"start\">Estribor</text><text class=\"dg-label\" x=\"516\" y=\"163\" text-anchor=\"start\">verde, 112,5°</text><text class=\"dg-label\" x=\"124\" y=\"145\" text-anchor=\"end\">Babor</text><text class=\"dg-label\" x=\"124\" y=\"163\" text-anchor=\"end\">roja, 112,5°</text><text class=\"dg-label\" x=\"320\" y=\"367\" text-anchor=\"middle\">Luz de alcance, blanca, 135°</text></svg></div><figcaption class=\"disclaimer\">Sectores de las luces vistos desde arriba. Donde se unen los sectores ves dos luces a la vez: justo por la proa, la roja y la verde.</figcaption></figure>\n</section>\n<section id=\"under-sail\">\n<h2>Un velero navegando a vela</h2>\n<p>Según la Regla 25, un buque de vela en navegación (ni fondeado, ni amarrado, ni varado) exhibe <b>luces de costado y luz de alcance</b>, y nada más. Ninguna luz de tope. La ausencia de una luz blanca por encima de las de costado es lo que indica a los demás que vas a vela.</p>\n<p>Un buque de vela de menos de 20 metros puede, en su lugar, combinar las tres en un único farol <b>tricolor</b> en el tope del palo o cerca de él. Se ve mejor por encima de las olas y gasta menos energía, por eso la llevan casi todos los veleros de crucero. Usas la tricolor o las luces a la altura de cubierta, nunca las dos a la vez.</p>\n<p>La Regla 25 también permite dos luces todo horizonte opcionales en el tope, roja sobre verde, además de las luces de costado y de alcance de cubierta. Son raras en los veleros y no se pueden combinar con una tricolor.</p>\n</section>\n<section id=\"under-engine\">\n<h2>A motor y a vela y motor</h2>\n<p>En cuanto el motor está engranado y mueve el barco, para el reglamento eres un buque de propulsión mecánica, aunque lleves las velas izadas. Pierdes las preferencias del buque de vela y tus luces deben cambiar:</p>\n<ul>\n<li>Enciende la <b>luz de tope</b> (luz de motor).</li>\n<li>Exhibe las <b>luces de costado y de alcance</b> a la altura de cubierta.</li>\n<li><b>Apaga la tricolor.</b> Solo puede usarse navegando a vela. Una tricolor con una luz de tope por debajo es un error habitual y da una imagen confusa.</li>\n</ul>\n<p>De día, un buque que navega a vela y a la vez a motor debe exhibir un <b>cono con el vértice hacia abajo</b>, a proa, donde mejor pueda verse (Regla 25(e)). Pocos veleros lo hacen, pero es obligatorio.</p>\n</section>\n<section id=\"at-anchor\">\n<h2>Fondeado y otras marcas diurnas</h2>\n<p>Fondeado, un buque de menos de 50 metros exhibe una <b>luz blanca todo horizonte</b> donde mejor pueda verse (Regla 30). De día exhibe una <b>bola</b> negra en la parte de proa. Los buques de 50 metros o más exhiben dos luces de fondeo, la de proa más alta. En un fondeadero abarrotado de Grecia o Croacia, una luz de fondeo en el tope puede ser difícil de ver desde una neumática o desde un barco que entra; muchos patrones añaden además una luz más baja.</p>\n<p>Otras marcas diurnas que conviene conocer:</p>\n<ul>\n<li>Dos conos unidos por los vértices: pesca.</li>\n<li>Bola, bicono, bola: capacidad de maniobra restringida.</li>\n<li>Dos bolas: sin gobierno (no puede maniobrar, por ejemplo tras una avería de motor o de timón).</li>\n<li>Un bicono: remolque de más de 200 metros de longitud.</li>\n</ul>\n</section>\n<section id=\"common-sights\">\n<h2>Lo que verás de noche</h2>\n<h3>Buques de propulsión mecánica</h3>\n<p>Un buque de propulsión mecánica de menos de 50 metros exhibe luz de tope, luces de costado y luz de alcance. Justo por la proa ves la blanca encima de la roja y la verde. Desde su estribor, blanca y verde. Desde su babor, blanca y roja. Desde popa, una sola luz blanca de alcance, que se ve igual que la de un buque de vela por la popa.</p>\n<p>Un buque de 50 metros o más debe llevar una segunda luz de tope, más a popa y más alta que la primera. El par funciona como un punto de mira. Si las dos luces blancas están en línea vertical y se ven las dos de costado, viene directo hacia ti. Cuando se abren, puedes leer hacia dónde gira.</p>\n<h3>Buques de pesca</h3>\n<p>Los buques de pesca exhiben dos luces todo horizonte en línea vertical. <b>Verde sobre blanca</b> indica pesca de arrastre (arrastrando una red). <b>Roja sobre blanca</b> indica otro tipo de pesca, como redes o palangres. Si tienen arrancada, añaden luces de costado y de alcance. En el Egeo y a lo largo de la costa turca, cuenta con pequeños pesqueros cerca de la costa por la noche.</p>\n<h3>Maniobra restringida y remolque</h3>\n<p>Un buque <b>con capacidad de maniobra restringida</b> por su trabajo, como una draga, un cablero o un buque que reposta en la mar, exhibe <b>luces roja, blanca y roja</b> todo horizonte en línea vertical, además de las luces normales de navegación si tiene arrancada. Un buque <b>que remolca</b> exhibe dos luces de tope en línea vertical (tres si el remolque supera los 200 metros), luces de costado, luz de alcance y una luz amarilla de remolque encima de la de alcance. El remolque exhibe luces de costado y de alcance. Nunca pases entre un remolcador y su remolque.</p>\n<table class=\"tbl\">\n<thead><tr><th>Qué ves</th><th>Qué es</th><th>Qué hacer</th></tr></thead>\n<tbody>\n<tr><td>Blanca sobre roja y verde</td><td>Buque a motor, de proa</td><td>A motor: cae a estribor. A vela: vigila su demora.</td></tr>\n<tr><td>Dos blancas en línea, roja y verde</td><td>Buque de más de 50 m, de proa</td><td>Maniobra pronto y con claridad. Cae a estribor.</td></tr>\n<tr><td>Solo blanca y roja</td><td>Buque a motor, su babor</td><td>A motor y cruzándoos: cedes tú. Pasa por su popa.</td></tr>\n<tr><td>Solo blanca y verde</td><td>Buque a motor, su estribor</td><td>A motor y cruzándoos: cede él. Mantén el rumbo y vigila.</td></tr>\n<tr><td>Una blanca, baja</td><td>Luz de alcance, cualquier buque</td><td>Si lo estás alcanzando, mantente apartado.</td></tr>\n<tr><td>Verde sobre blanca</td><td>Arrastrero</td><td>Mantente bien apartado, a vela o a motor.</td></tr>\n<tr><td>Roja sobre blanca</td><td>Otro tipo de pesca</td><td>Mantente apartado. Atento a las redes.</td></tr>\n<tr><td>Roja, blanca, roja</td><td>Capacidad de maniobra restringida</td><td>Mantente apartado. No puede quitarse de tu camino.</td></tr>\n<tr><td>Dos o tres blancas en línea, amarilla a popa</td><td>Remolque</td><td>Mantente apartado. Nunca cortes entre remolcador y remolque.</td></tr>\n<tr><td>Una blanca todo horizonte, inmóvil</td><td>Buque fondeado</td><td>Pasa franco. Comprueba la profundidad.</td></tr>\n</tbody>\n</table>\n<p>La columna «Qué hacer» es una guía, no sustituye a las reglas de rumbo y gobierno. La Regla 18 dice que un buque de vela se mantiene apartado de los buques dedicados a la pesca, con capacidad de maniobra restringida y sin gobierno. Digan lo que digan las reglas, si la demora de las luces de otro buque no cambia mientras la distancia se acorta, hay riesgo de abordaje. Maniobra pronto.</p>\n<aside class=\"note warn\"><b>Atención</b><p>De noche, un buque grande puede ser difícil de juzgar. Sus luces pueden quedar altas sobre las luces de tierra, y recorre una milla en pocos minutos. En caso de duda, cambia el rumbo pronto y de forma amplia para que el cambio sea evidente, y llama por el canal 16 de VHF si hace falta.</p></aside>\n</section>\n<section id=\"practise\">\n<h2>Practícalo en el agua</h2>\n<p>En nuestros cursos lo practicas en las travesías nocturnas: identificas luces reales desde la bañera, tomas demoras y decides quién cede el paso. Antes de cada navegación nocturna también compruebas tus propias luces y cambias entre la tricolor y la luz de tope al pasar de vela a motor.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">International Bareboat Skipper</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es/courses/bareboat-skipper\">Ver el curso</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"En esta página\"><span class=\"kicker\">En esta página</span><ol class=\"toc-list\"><li><a href=\"#arcs\">Cómo funcionan las luces</a></li><li><a href=\"#under-sail\">A vela</a></li><li><a href=\"#under-engine\">A motor</a></li><li><a href=\"#at-anchor\">Fondeado y marcas diurnas</a></li><li><a href=\"#common-sights\">Lo que verás de noche</a></li><li><a href=\"#practise\">Practícalo</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practícalo en</span><div class=\"card-title\">International Bareboat Skipper</div><p>Aprende esto en el agua con un instructor, en una semana viviendo a bordo.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/es/courses/bareboat-skipper\">Ver el curso</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Teoría</span><h2 class=\"h2\" style=\"margin-top:12px\">Sigue leyendo</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/es/theory\">Toda la teoría</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Más teoría\"><a class=\"card\" href=\"/es/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Un yate a motor cruzando mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Quién tiene preferencia en el mar: las reglas que un patrón usa a diario</span><span class=\"card-meta\">El RIPA que un patrón de velero aplica a diario: vigilancia, velocidad de seguridad, riesgo de abordaje, quién cede el paso a vela y a motor, alcance, navegar a vela y motor, y canales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"Un patrón al timón saliendo del puerto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Boyas y marcas: el sistema IALA</span><span class=\"card-meta\">Marcas laterales, cardinales, de peligro aislado, de aguas navegables y especiales en la Región A de la IALA: colores, marcas de tope, ritmos de luz y cómo leer una luz en la carta.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Un velero navegando de ceñida en mar abierto\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Rumbos: cómo navega un velero cerca del viento</span><span class=\"card-meta\">Aprende los rumbos, de la ceñida a la popa: la zona muerta, el trimado en cada rumbo, la virada por avante y la trasluchada, el viento aparente y la lectura de los catavientos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Una goleta con todas las velas izadas\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Seis nudos que usa todo tripulante</span><span class=\"card-meta\">Seis nudos que necesita todo tripulante: as de guía, ballestrinque, vuelta redonda y dos medios cotes, nudo de cornamusa, nudo de ocho y nudo llano, paso a paso.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Dos navegantes al timón navegando a vela\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Iniciación</span><span class=\"card-title\">Virada por avante y trasluchada, paso a paso</span><span class=\"card-meta\">Cómo virar por avante y trasluchar en un velero: las voces, el trabajo de cada tripulante, winches sin vueltas montadas, la trasluchada controlada, cómo salir si te quedas aproado y consejos para catamaranes.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a><a class=\"card\" href=\"/es/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Dos tripulantes trabajan junto al mástil con brisa fresca\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Patrón de chárter</span><span class=\"card-title\">Rizos: cuándo y cómo reducir vela</span><span class=\"card-meta\">Cuándo y cómo tomar rizos en un velero: las señales de que ha llegado el momento, rizos de faja paso a paso, mayor enrollable en el mástil, enrollar el génova, equilibrio de velas y largar rizos.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min de lectura</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Prototipo de diseño. Los precios, las fechas y las personas son contenido de ejemplo. Fotos vía Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">Quiénes somos</a><a href=\"#\">Telegram</a><a href=\"#\">Privacidad</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}