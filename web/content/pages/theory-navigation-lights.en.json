l id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/navigation-lights\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/navigation-lights\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/navigation-lights\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/navigation-lights\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Rules of the road</li></ol></nav>\n        <h1 class=\"display\">Navigation lights and day shapes</h1>\n        <p class=\"lead\">At night, lights are how you know what another vessel is, which way she is heading and who keeps clear. This guide covers the lights a yacht shows and the ones you will meet.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Bareboat skipper</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#arcs\">How the lights work</a></li><li><a href=\"#under-sail\">Under sail</a></li><li><a href=\"#under-engine\">Under engine</a></li><li><a href=\"#at-anchor\">At anchor and day shapes</a></li><li><a href=\"#common-sights\">Common sights at night</a></li><li><a href=\"#practise\">Practise it</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>Each light covers a fixed arc: masthead 225°, sidelights 112.5° each, sternlight 135°.</li><li>Under sail: sidelights and sternlight, or a tricolour under 20 m. Under engine: add the masthead light and switch off the tricolour.</li><li>At anchor: one all-round white light by night, one black ball by day.</li><li>Green over white is a trawler, red over white other fishing, red-white-red a vessel restricted in ability to manoeuvre.</li></ul></div>\n          <section id=\"arcs\">\n<h2>How the lights work</h2>\n<p>Part C of the COLREGs (the International Regulations for Preventing Collisions at Sea, Rules 20 to 31) sets out which lights and shapes every vessel must show. Lights are shown from sunset to sunrise and in restricted visibility. Shapes are their daytime equivalent: black balls, cones and diamonds.</p>\n<p>Each light shines only over a fixed arc, measured from right ahead. Rule 21 defines them:</p>\n<ul>\n<li><b>Masthead light</b>: white, shining forward over 225°, from right ahead to 22.5° abaft (behind) the beam on each side. Despite the name, on a yacht it is usually fitted partway up the front of the mast. Sailors often call it the steaming light.</li>\n<li><b>Sidelights</b>: red on the port (left) side and green on the starboard (right) side, each covering 112.5°, from right ahead to 22.5° abaft the beam.</li>\n<li><b>Sternlight</b>: white, shining aft over 135°, 67.5° each side of right astern.</li>\n<li><b>All-round light</b>: any colour, visible over the full 360°.</li>\n</ul>\n<p>The arcs fit together. The sternlight covers exactly the sector the sidelights and masthead light leave dark, so from any direction you see a combination that tells you which way the other vessel is pointing. See only green and you are looking at her starboard side.</p>\n<p>Minimum ranges depend on size. For a vessel of 12 to 20 metres the masthead light must be visible at 3 miles and the sidelights and sternlight at 2 miles. Under 12 metres the figures drop to 2 miles for the masthead light and sternlight, and 1 mile for the sidelights. A small yacht's lights are dim. Do not assume a ship has seen you.</p>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 380\" role=\"img\" aria-label=\"Arcs of navigation lights seen from above: masthead light 225 degrees forward, red and green sidelights 112.5 degrees each, sternlight 135 degrees aft\"><path class=\"dg-white\" d=\"M320,215 L158.3,282.0 A175,175 0 1 1 481.7,282.0 Z\"/><path class=\"dg-green\" d=\"M320,215 L320.0,97.0 A118,118 0 0 1 429.0,260.2 Z\"/><path class=\"dg-red\" d=\"M320,215 L211.0,260.2 A118,118 0 0 1 320.0,97.0 Z\"/><path class=\"dg-white dg-stern\" d=\"M320,215 L440.1,264.7 A130,130 0 0 1 199.9,264.7 Z\"/><g class=\"dg-boat \" transform=\"translate(320.0 215.0) scale(1.7)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line style=\"display:none\" class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"0.0\" y2=\"10.0\"/></g><text class=\"dg-label\" x=\"320\" y=\"29\" text-anchor=\"middle\">Masthead light, white, 225°</text><text class=\"dg-label\" x=\"516\" y=\"145\" text-anchor=\"start\">Starboard</text><text class=\"dg-label\" x=\"516\" y=\"163\" text-anchor=\"start\">green, 112.5°</text><text class=\"dg-label\" x=\"124\" y=\"145\" text-anchor=\"end\">Port</text><text class=\"dg-label\" x=\"124\" y=\"163\" text-anchor=\"end\">red, 112.5°</text><text class=\"dg-label\" x=\"320\" y=\"367\" text-anchor=\"middle\">Sternlight, white, 135°</text></svg></div><figcaption class=\"disclaimer\">Light arcs seen from above. Where the arcs meet, you see two lights at once: from dead ahead, both red and green.</figcaption></figure>\n</section>\n<section id=\"under-sail\">\n<h2>A sailing yacht under sail</h2>\n<p>Under Rule 25, a sailing vessel underway (not at anchor, made fast or aground) shows <b>sidelights and a sternlight</b>, and nothing else. No masthead light. The absence of a white light above the sidelights is what tells other vessels you are sailing.</p>\n<p>A sailing vessel under 20 metres may instead combine the three into one <b>tricolour</b> lantern at or near the top of the mast. It is more visible over waves and uses less power, which is why most cruising yachts have one. You use either the tricolour or the deck-level lights, never both together.</p>\n<p>Rule 25 also allows two optional all-round lights at the masthead, red over green, in addition to the deck-level sidelights and sternlight. They are rare on yachts and must not be combined with a tricolour.</p>\n</section>\n<section id=\"under-engine\">\n<h2>Under engine and motorsailing</h2>\n<p>The moment the engine is in gear and driving the boat, you are a power-driven vessel under the rules, even with the sails up. You lose the sailing vessel's privileges and your lights must change:</p>\n<ul>\n<li>Switch on the <b>masthead light</b> (steaming light).</li>\n<li>Show <b>sidelights and sternlight</b> at deck level.</li>\n<li><b>Switch off the tricolour.</b> It may only be used under sail. A tricolour with a steaming light below it is a common mistake and gives a confusing picture.</li>\n</ul>\n<p>By day, a vessel under sail that is also motoring must show a <b>cone, point down</b>, forward where it can best be seen (Rule 25(e)). Few yachts bother, but it is required.</p>\n</section>\n<section id=\"at-anchor\">\n<h2>At anchor and other day shapes</h2>\n<p>At anchor, a vessel under 50 metres shows one <b>all-round white light</b> where it can best be seen (Rule 30). By day she shows one black <b>ball</b> in the forepart. Vessels of 50 metres or more show two anchor lights, the forward one higher. In a crowded Greek or Croatian anchorage, an anchor light at the masthead can be hard to spot from a dinghy or from a boat coming in; many skippers add a light lower down as well.</p>\n<p>Other day shapes worth knowing:</p>\n<ul>\n<li>Two cones, points together: fishing.</li>\n<li>Ball, diamond, ball: restricted in ability to manoeuvre.</li>\n<li>Two balls: not under command (unable to manoeuvre, for example after an engine or steering failure).</li>\n<li>A diamond: towing, where the tow is over 200 metres long.</li>\n</ul>\n</section>\n<section id=\"common-sights\">\n<h2>Common sights at night</h2>\n<h3>Power-driven vessels</h3>\n<p>A power-driven vessel under 50 metres shows a masthead light, sidelights and a sternlight. From right ahead you see white above red and green. From her starboard side, white and green. From her port side, white and red. From astern, a single white sternlight, which looks the same as a sailing vessel from astern.</p>\n<p>A vessel of 50 metres or more must carry a second masthead light, further aft and higher than the first. The pair works like a gunsight. If the two white lights are in a vertical line with both sidelights visible, she is coming straight at you. As they open out, you can read which way she is turning.</p>\n<h3>Fishing vessels</h3>\n<p>Fishing vessels show two all-round lights in a vertical line. <b>Green over white</b> means trawling (dragging a net). <b>Red over white</b> means other fishing, such as nets or long lines. If they are making way through the water, they add sidelights and a sternlight. In the Aegean and along the Turkish coast, expect small fishing boats close inshore at night.</p>\n<h3>Restricted and towing</h3>\n<p>A vessel <b>restricted in ability to manoeuvre</b> by her work, such as a dredger, cable layer or a ship refuelling at sea, shows <b>red, white, red</b> all-round lights in a vertical line, plus normal steaming lights if making way. A vessel <b>towing</b> shows two masthead lights in a vertical line (three if the tow is over 200 metres), sidelights, sternlight and a yellow towing light above the sternlight. The tow behind her shows sidelights and a sternlight. Never pass between a tug and its tow.</p>\n<table class=\"tbl\">\n<thead><tr><th>What you see</th><th>What it is</th><th>What to do</th></tr></thead>\n<tbody>\n<tr><td>White over red and green</td><td>Power vessel, head-on</td><td>Under engine: turn to starboard. Under sail: watch her bearing.</td></tr>\n<tr><td>Two whites in line, red and green</td><td>Ship over 50 m, head-on</td><td>Act early and clearly. Turn to starboard.</td></tr>\n<tr><td>White and red only</td><td>Power vessel, her port side</td><td>Under engine and crossing: you give way. Pass astern.</td></tr>\n<tr><td>White and green only</td><td>Power vessel, her starboard side</td><td>Under engine and crossing: she gives way. Hold your course and watch.</td></tr>\n<tr><td>Single white, low</td><td>Sternlight, any vessel</td><td>If you are overtaking, keep clear.</td></tr>\n<tr><td>Green over white</td><td>Trawler</td><td>Keep well clear, under sail or engine.</td></tr>\n<tr><td>Red over white</td><td>Other fishing</td><td>Keep clear. Look for nets.</td></tr>\n<tr><td>Red, white, red</td><td>Restricted in ability to manoeuvre</td><td>Keep clear. She cannot get out of your way.</td></tr>\n<tr><td>Two or three whites in line, yellow aft</td><td>Towing</td><td>Keep clear. Never cut between tug and tow.</td></tr>\n<tr><td>Single white, all round, stationary</td><td>Vessel at anchor</td><td>Pass clear. Check your depth.</td></tr>\n</tbody>\n</table>\n<p>The \"what to do\" column is a guide, not a substitute for the steering rules. Rule 18 says a sailing vessel keeps clear of vessels fishing, restricted in ability to manoeuvre and not under command. Whatever the rules say, if the compass bearing of another vessel's lights does not change while the range closes, there is a risk of collision. Act early.</p>\n<aside class=\"note warn\"><b>Watch out</b><p>A big ship can be hard to judge at night. Her lights may sit high against shore lights, and she covers a mile in a few minutes. If in doubt, alter course early and by a large amount so the change is obvious, and call on VHF channel 16 if needed.</p></aside>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On our courses you practise this during night passages: identifying real lights from the cockpit, taking bearings on them and deciding who gives way. Before each night sail you also check your own lights and switch between tricolour and steaming light as you change from sail to engine.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#arcs\">How the lights work</a></li><li><a href=\"#under-sail\">Under sail</a></li><li><a href=\"#under-engine\">Under engine</a></li><li><a href=\"#at-anchor\">At anchor and day shapes</a></li><li><a href=\"#common-sights\">Common sights at night</a></li><li><a href=\"#practise\">Practise it</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"A motor yacht crossing open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Right of way at sea: the rules skippers use daily</span><span class=\"card-meta\">The COLREGs a yacht skipper uses daily: lookout, safe speed, risk of collision, give-way rules for sail and power, overtaking, motorsailing and channels.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/buoyage\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1780335282813-db330424b1bd?w=900&q=80&auto=format&fit=crop\" alt=\"A skipper at the wheel leaving harbour\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Buoys and marks: the IALA system</span><span class=\"card-meta\">Lateral, cardinal, isolated danger, safe water and special marks in IALA Region A: colours, topmarks, light rhythms and how to read a light on the chart.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Two sailors at the wheel under sail\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Tacking and gybing, step by step</span><span class=\"card-meta\">How to tack and gybe a sailing yacht: the calls, crew jobs, winches without riding turns, a controlled gybe, getting out of irons and tips for catamarans.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Two crew working at the mast in a fresh breeze\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reefing: when and how to shorten sail</span><span class=\"card-meta\">When and how to reef a sailing yacht: signs it is time, slab reefing step by step, in-mast furling mains, rolling in the genoa, sail balance and shaking out.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}