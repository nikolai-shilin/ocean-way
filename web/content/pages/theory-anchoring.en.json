mbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/anchoring\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/anchoring\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/anchoring\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/anchoring\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Harbour and anchorage</li></ol></nav>\n        <h1 class=\"display\">Anchoring: the spot, the scope, the hold</h1>\n        <p class=\"lead\">A secure anchorage comes from three decisions: where you drop, how much chain you let out and whether the anchor has really set. This guide walks through each one.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Bareboat skipper</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#choose-bay\">Choosing the bay</a></li><li><a href=\"#scope\">Scope</a></li><li><a href=\"#set\">Setting the anchor</a></li><li><a href=\"#secure\">Securing for the night</a></li><li><a href=\"#shore-lines\">Shore lines</a></li><li><a href=\"#weigh\">Weighing anchor</a></li><li><a href=\"#practise\">Practise it</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>Pick a bay sheltered from the forecast wind, with sand or mud and room to swing.</li><li>Let out at least 4 to 5 times the depth in chain, more if wind is coming.</li><li>Lower the anchor, lay chain while going astern, then set it under reverse power and check with a transit.</li><li>Rig a snubber, set an anchor alarm and, if you can, swim over the anchor to look.</li></ul></div>\n          <section id=\"choose-bay\">\n<h2>Choosing the bay</h2>\n<p>A good night at anchor is decided before you lower anything. Start with the forecast, not with the view. Look at the wind expected overnight and tomorrow morning, then look for a bay that is open to anything else but closed to that direction.</p>\n<ul>\n<li><b>Shelter.</b> Land should lie between you and the forecast wind. Watch for winds that change through the night. In the Aegean, a meltemi (the strong summer northerly) can blow hard into a bay that looked calm at lunchtime, and katabatic gusts can drop off high ground at night.</li>\n<li><b>Holding ground.</b> Sand and mud hold well. Weed, including the seagrass meadows common in the Mediterranean, holds poorly because the anchor slides over it. Rock gives no reliable hold and can trap the anchor. In some areas anchoring on seagrass is restricted, so check local rules.</li>\n<li><b>Depth.</b> Somewhere between about 4 and 12 metres suits most charter yachts. Too shallow and you may touch at low water or when the boat swings. Too deep and you will run out of chain.</li>\n<li><b>Swinging room.</b> You need a clear circle around your anchor at least as large as your chain length plus the length of the boat.</li>\n</ul>\n<p>The chart and a good pilot book will show the bottom type and depths. Your eyes and the depth sounder (echo sounder) confirm them.</p>\n</section>\n<section id=\"scope\">\n<h2>Scope: how much chain</h2>\n<p><b>Scope</b> is the length of chain you let out compared with the depth. For all-chain rode (the line between anchor and boat), use <b>at least 4 to 5 times the depth</b> in settled weather, and more if wind is forecast. Measure depth from the bow roller, so add a metre or so to the sounder reading. Tidal range in most of the Mediterranean is small, but where it is larger, use the depth at high water.</p>\n<p>In the table, depth means sounder depth plus the height of the bow roller.</p>\n<table class=\"tbl\">\n<thead><tr><th>Depth</th><th>Chain, settled</th><th>Chain, windy</th></tr></thead>\n<tbody>\n<tr><td>3 m</td><td>15 m</td><td>20–25 m</td></tr>\n<tr><td>5 m</td><td>25 m</td><td>35 m</td></tr>\n<tr><td>8 m</td><td>40 m</td><td>50–55 m</td></tr>\n<tr><td>10 m</td><td>50 m</td><td>60–70 m</td></tr>\n<tr><td>15 m</td><td>60–75 m</td><td>all you have</td></tr>\n</tbody>\n</table>\n<p>Charter yachts typically carry 50 to 80 metres of chain, and it varies, so find out what you have before you leave the base. Chain is usually marked every 10 metres with paint or coloured tags. Learn the code on your boat.</p>\n<p>Longer scope matters because the anchor holds best when the pull is horizontal. The weight of the chain lying on the seabed keeps the pull low and absorbs snatching as the boat moves.</p>\n</section>\n<section id=\"set\">\n<h2>Lowering and setting the anchor</h2>\n<ol>\n<li>Motor slowly into the bay and pick your spot, allowing for where the boat will lie once the chain is out.</li>\n<li>Approach head to wind (bow pointing into the wind) and stop the boat over the spot.</li>\n<li><b>Lower</b> the anchor to the bottom with the windlass. Do not let it drop in free fall. A heap of chain on top of the anchor can foul it.</li>\n<li>As the boat drifts back or you go slowly astern, let out chain steadily so it lies in a line on the seabed rather than piling up.</li>\n<li>When the planned scope is out, hold the chain and let the boat come up against it. You will feel the bow swing to face the anchor.</li>\n<li>Set it under reverse power: build up gradually to a firm astern load and hold it for 20 to 30 seconds. If the boat keeps moving, the anchor is dragging. Lift it and try again.</li>\n</ol>\n<p>Check that it is holding by taking a <b>transit</b>: two fixed objects ashore that line up, such as a rock in front of a building, roughly abeam (at right angles to the boat). If they stay in line under reverse, you are not moving. A compass bearing on a fixed point works too. Recheck it after a while and whenever the wind gets up.</p>\n</section>\n<section id=\"secure\">\n<h2>Securing for the night</h2>\n<p>Once the anchor is set, rig a <b>snubber</b>: a length of stretchy rope hooked onto the chain and made fast on a bow cleat. Let out a little more chain so the snubber takes the load. It saves the windlass from strain and stops the chain jerking the boat. Catamarans use a <b>bridle</b>, a snubber with two arms led to each bow.</p>\n<p>Set an <b>anchor alarm</b>. Most chart plotters and many phone apps let you mark the anchor position and sound an alarm if the boat moves outside a set radius. Set the radius to about your chain length plus the boat length, so normal swinging does not trigger it.</p>\n<p>Look at the boats around you. Yachts on chain swing differently from boats on rope, and catamarans move differently from monohulls. If you anchor too close, you may meet at 3 a.m. after a wind shift. By custom, the boat that arrived first has the stronger claim to its space, so if you are the newcomer, it is up to you to leave room.</p>\n<aside class=\"note\"><b>Tip</b><p>In clear Mediterranean water, the best check of all is to look. Put on a mask and snorkel and swim over the anchor. You will see whether it has dug in, is lying on its side, or has caught on a patch of weed. A few minutes in the water can save a sleepless night.</p></aside>\n</section>\n<section id=\"shore-lines\">\n<h2>Shore lines in Turkey and Greece</h2>\n<p>In many small bays on the Lycian coast, around Göcek, and in parts of Greece, there is no room to swing. Instead you drop the anchor and reverse towards the shore, then take a line from the stern to a rock, tree or ring ashore. Some bays have bollards or rings fixed for this.</p>\n<ul>\n<li>Drop the anchor well out, as for Mediterranean mooring, so there is plenty of chain when you stop.</li>\n<li>One crew member takes the shore line ashore by dinghy or swims with it. Lead it round the tree or rock and back to the boat, so you can release it from on board.</li>\n<li>Protect trees with a sleeve or a strop. Do not tie to anything that could pull loose.</li>\n<li>Think about the wind direction. A shore line works best with the wind blowing off the land. If wind is forecast from the side, use two shore lines, or choose another bay.</li>\n</ul>\n</section>\n<section id=\"weigh\">\n<h2>Weighing anchor</h2>\n<p>To lift the anchor, one crew member works the windlass and signals to the helm. Motor gently towards the chain so the windlass is not dragging the boat. Point the direction of the chain with an arm. When the chain is straight up and down, the anchor should break out. Raise it slowly, rinse off mud before it comes aboard, and make it fast before you speed up.</p>\n<p>Never drive over your own chain, and keep fingers and feet clear of the windlass while it runs.</p>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On our courses you practise this in different bays every day, choosing the spot, working out the scope and setting the anchor under power. You also take shore lines in narrow coves and swim over the anchor to see how well it has set.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#choose-bay\">Choosing the bay</a></li><li><a href=\"#scope\">Scope</a></li><li><a href=\"#set\">Setting the anchor</a></li><li><a href=\"#secure\">Securing for the night</a></li><li><a href=\"#shore-lines\">Shore lines</a></li><li><a href=\"#weigh\">Weighing anchor</a></li><li><a href=\"#practise\">Practise it</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"A harbour town lit at dusk above the sea\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Mediterranean mooring, step by step</span><span class=\"card-meta\">How to moor stern-to in the Mediterranean with lazy lines or your own anchor: crew briefing, prop walk, the approach, crossed anchors and leaving.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"A motor yacht crossing open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Right of way at sea: the rules skippers use daily</span><span class=\"card-meta\">The COLREGs a yacht skipper uses daily: lookout, safe speed, risk of collision, give-way rules for sail and power, overtaking, motorsailing and channels.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"A yacht under a starry night sky\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Navigation lights and day shapes</span><span class=\"card-meta\">Masthead, side and stern lights, tricolour, anchor light and day shapes under COLREG Part C, plus how to read fishing boats, tows and ships at night.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"A wave breaking in clear water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reading the weather: Beaufort, forecasts, meltemi</span><span class=\"card-meta\">Learn the Beaufort scale, where to get Mediterranean sailing forecasts, how to read gusts, and how the meltemi, sirocco and bora affect a 40 ft yacht.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}