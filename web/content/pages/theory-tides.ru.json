-4 10.5c.8.8 1 1.5 1 2.5h6c0-1 .2-1.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/tides\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/tides\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/tides\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/tides\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Погода и навигация</li></ol></nav>\n        <h1 class=\"display\">Приливы: высоты, течения и правило двенадцатых</h1>\n        <p class=\"lead\">Даже если вы учитесь ходить там, где прилива почти нет, программа Yachtmaster и северные воды требуют умения его рассчитывать. Здесь — как поднимается и опускается вода, как читать нуль глубин и приливо-отливные течения и как рассчитать время прохода через бар.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Прибрежный шкипер</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#why-tides\">Откуда берутся приливы</a></li><li><a href=\"#springs-neaps\">Сизигийные и квадратурные приливы</a></li><li><a href=\"#chart-datum\">Нуль глубин</a></li><li><a href=\"#tide-tables\">Таблицы приливов</a></li><li><a href=\"#twelfths\">Правило двенадцатых</a></li><li><a href=\"#clearance\">Проход через бар</a></li><li><a href=\"#streams\">Приливо-отливные течения</a></li><li><a href=\"#mediterranean\">Наши воды</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Приливы вызывают Луна и Солнце; сизигийные приливы приходят после полнолуния и новолуния.</li><li>Фактическая глубина — это глубина на карте плюс высота прилива.</li><li>Правило двенадцатых: каждый час вода меняется на 1, 2, 3, 3, 2, 1 двенадцатую величины прилива.</li><li>Ветер против течения поднимает короткую крутую волну.</li></ul></div>\n          <section id=\"why-tides\">\n<h2>Откуда берутся приливы</h2>\n<p>Приливы — это регулярные подъём и спад уровня моря, вызванные главным образом притяжением Луны и в меньшей степени Солнца. Луна вытягивает океан в горб на обращённой к ней стороне Земли, а второй горб образуется на противоположной. По мере вращения Земли каждый берег проходит через оба.</p>\n<p>Поэтому на большинстве побережий Атлантики и Северного моря чуть больше чем за сутки бывает две полные и две малые воды, и каждый день они наступают примерно на 50 минут позже. От малой воды до полной проходит около шести часов.</p>\n<ul>\n<li><b>Полная вода (ПВ).</b> Наивысший уровень, которого достигает прилив за один цикл.</li>\n<li><b>Малая вода (МВ).</b> Наинизший уровень за один цикл.</li>\n<li><b>Величина прилива.</b> Разница высот между полной водой и следующей малой водой. Большая величина прилива означает, что движется больше воды и течения сильнее.</li>\n</ul>\n</section>\n<section id=\"springs-neaps\">\n<h2>Сизигийные и квадратурные приливы</h2>\n<p>В новолуние и полнолуние Солнце и Луна выстраиваются в одну линию с Землёй, и их притяжение складывается. Наступают сизигийные приливы: полные воды выше, малые ниже, величина прилива больше, течения сильнее. По-английски они называются spring tides, но с весной это название никак не связано.</p>\n<p>В первой и последней четверти Луна и Солнце тянут под прямым углом и частично гасят друг друга: наступают квадратурные приливы с небольшой величиной и слабыми течениями. Цикл от сизигии до квадратуры и обратно занимает около двух недель, а самые большие сизигийные приливы обычно приходят через день-два после полнолуния или новолуния.</p>\n</section>\n<section id=\"chart-datum\">\n<h2>Нуль глубин и высоты осыхания</h2>\n<p><b>Нуль глубин.</b> Уровень, от которого отсчитываются глубины на карте. На большинстве современных карт это наинизший теоретический уровень (LAT) — самый низкий уровень, которого, по прогнозу, достигает прилив при средних погодных условиях. Поэтому воды обычно больше, чем показывает карта, и редко меньше.</p>\n<p><b>Глубина на карте.</b> Цифра глубины на акватории, отсчитанная вниз от нуля глубин.</p>\n<p><b>Высота осыхания.</b> Банки и илистые отмели, которые обнажаются при нуле глубин, отмечены подчёркнутой цифрой: это их высота над нулём глубин.</p>\n<p><b>Высота прилива.</b> Насколько поверхность моря в данный момент выше нуля глубин. Она связывает всё воедино:</p>\n<ul>\n<li>Глубина = глубина на карте + высота прилива.</li>\n<li>Глубина над осыхающим участком = высота прилива − высота осыхания.</li>\n</ul>\n<p>Высоты суши, огней и подмостовые габариты, наоборот, отсчитываются от уровня полной воды. Какого именно — сказано в примечаниях к карте.</p>\n</section>\n<section id=\"tide-tables\">\n<h2>Таблицы приливов и пункты</h2>\n<p>Таблицы приливов в альманахах и приложениях дают ежедневное время и высоту полных и малых вод. Это прогноз, и погода может увести реальный уровень от него.</p>\n<p><b>Основные пункты.</b> Крупные гавани с полным ежедневным прогнозом и кривой прилива (графиком высоты между малой и полной водой).</p>\n<p><b>Дополнительные пункты.</b> Небольшие гавани: для них прогноз рассчитывают, применяя поправки времени и высоты из альманаха к соседнему основному пункту.</p>\n<p>Проверьте часовой пояс. Многие таблицы даны по UT (всемирному времени), так что прибавьте разницу с местным или летним временем.</p>\n</section>\n<section id=\"twelfths\">\n<h2>Правило двенадцатых</h2>\n<p>Сначала вода прибывает медленно, быстрее всего в середине, а затем снова медленно. Правило двенадцатых позволяет оценить высоту на каждый час, если от малой воды до полной около шести часов. Разделите величину прилива на двенадцать частей. Час за часом вода поднимается на 1, 2, 3, 3, 2 и 1 двенадцатую, а после полной воды падает в том же порядке.</p>\n<p>Пример: малая вода в 08:00, высота 1,0 метра. Полная вода в 14:00, высота 5,8 метра. Величина прилива 4,8 метра, значит, одна двенадцатая — 0,4 метра.</p>\n<table class=\"tbl\"><thead><tr><th>Время</th><th>Подъём за этот час</th><th>Высота прилива</th></tr></thead><tbody>\n<tr><td>08:00 (малая вода)</td><td>Нет</td><td>1,0 м</td></tr>\n<tr><td>0900</td><td>1/12 = 0,4 м</td><td>1,4 м</td></tr>\n<tr><td>1000</td><td>2/12 = 0,8 м</td><td>2,2 м</td></tr>\n<tr><td>1100</td><td>3/12 = 1,2 м</td><td>3,4 м</td></tr>\n<tr><td>1200</td><td>3/12 = 1,2 м</td><td>4,6 м</td></tr>\n<tr><td>1300</td><td>2/12 = 0,8 м</td><td>5,4 м</td></tr>\n<tr><td>14:00 (полная вода)</td><td>1/12 = 0,4 м</td><td>5,8 м</td></tr>\n</tbody></table>\n<p>Половина величины прилива приходится на два средних часа. Правило — лишь приближение. Там, где кривая прилива неправильная, как местами в Соленте, пользуйтесь кривой из альманаха.</p>\n</section>\n<section id=\"clearance\">\n<h2>Запас под килем и проход через бар</h2>\n<p>Во многих гаванях есть бар (банка из песка или гальки поперёк входа), который можно пройти, только когда воды достаточно.</p>\n<ol>\n<li>Найдите по карте глубину над баром. Допустим, 0,7 метра.</li>\n<li>Возьмите свою осадку (глубину киля ниже ватерлинии). Допустим, 1,9 метра.</li>\n<li>Добавьте запас воды под килем. Над баром берите не меньше метра, а при зыби больше, потому что яхта проваливается в каждую подошву волны.</li>\n<li>Значит, нужно 1,9 + 1,0 = 2,9 метра воды. Над баром уже есть 0,7 метра при нуле глубин, поэтому высота прилива должна быть не меньше 2,9 − 0,7 = 2,2 метра.</li>\n</ol>\n<p>По таблице высота прилива достигает 2,2 метра в 10:00. Если вода убывает зеркально тому, как прибывала, снова до 2,2 метра она опустится примерно к 18:00. Значит, окно — примерно с 10:00 до 18:00. Целитесь в его середину, а не в края.</p>\n</section>\n<section id=\"streams\">\n<h2>Приливо-отливные течения</h2>\n<p>Когда уровень поднимается и опускается, вода течёт вдоль берега, входит в эстуарии и выходит из них. Это приливо-отливное течение. Приливное течение идёт, пока вода прибывает, отливное — пока убывает, а пауза между ними — стоячая вода. Течение описывают направлением (куда оно течёт, в отличие от ветра, который называют по тому, откуда он дует) и скоростью в узлах.</p>\n<ul>\n<li><b>Приливные ромбы.</b> Буква в ромбе на карте. Таблица на карте даёт направление и скорость течения в этой точке на каждый час до и после полной воды в основном пункте, в сизигию и в квадратуру.</li>\n<li><b>Атласы приливо-отливных течений.</b> Брошюра с карточкой на каждый час прилива. Стрелки показывают направление, а цифры вроде 08,15 — скорость в десятых долях узла: 0,8 узла в квадратуру, 1,5 в сизигию.</li>\n</ul>\n<p>В сизигию скорость течения часто примерно вдвое выше, чем в квадратуру. Сильнее всего течения у мысов и в узких проходах, и меняются они не всегда в момент полной или малой воды.</p>\n<h3>Ветер против течения</h3>\n<p>Когда ветер дует против течения, волна становится короткой, крутой и частой. 5 баллов, приятные по течению, против сизигийного отливного течения могут дать сильную болтанку, а у мысов можно встретить сулой (толчею волн там, где течение идёт над неровным дном). Огибайте мысы в стоячую воду или когда ветер и течение идут в одну сторону.</p>\n</section>\n<section id=\"mediterranean\">\n<h2>Приливы в наших водах</h2>\n<p>В большей части Средиземного и Эгейского морей, включая турецкое побережье и греческие острова, величина прилива мала, обычно меньше полуметра. Местами она больше: почти метр на севере Адриатики и до двух метров в заливе Габес в Тунисе.</p>\n<p>Поэтому здесь обычно важнее другое. Сильный ветер может нагонять воду к берегу или сгонять её. Низкое давление поднимает уровень моря, а высокое опускает — примерно на сантиметр на каждый гектопаскаль. Через проливы идут течения, а затяжной мельтеми создаёт поверхностный дрейф.</p>\n<p>Но приливы — ключевая часть программы Yachtmaster Coastal, и они понадобятся вам сразу, как только вы выйдете в Атлантику, Ла-Манш или воды Северной Европы.</p>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На курсах Yachtmaster Coastal вы решаете задачи на высоту прилива и течения по выдержкам из альманаха и учебным картам. На воде вы сверяете эхолот с картой и планируете каждый переход так, будто прилив имеет значение, чтобы быть готовыми к приливным водам.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#why-tides\">Откуда берутся приливы</a></li><li><a href=\"#springs-neaps\">Сизигийные и квадратурные приливы</a></li><li><a href=\"#chart-datum\">Нуль глубин</a></li><li><a href=\"#tide-tables\">Таблицы приливов</a></li><li><a href=\"#twelfths\">Правило двенадцатых</a></li><li><a href=\"#clearance\">Проход через бар</a></li><li><a href=\"#streams\">Приливо-отливные течения</a></li><li><a href=\"#mediterranean\">Наши воды</a></li><li><a href=\"#practise\">Отработайте на воде</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru#courses\">Смотреть курсы</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"Волна разбивается в прозрачной воде\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Читаем погоду: Бофорт, прогнозы, мельтеми</span><span class=\"card-meta\">Шкала Бофорта, где брать прогнозы погоды для Средиземноморья, как читать порывы и как мельтеми, сирокко и бора влияют на 40-футовую яхту.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/position-fixing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534008897995-27a23e859048?w=900&q=80&auto=format&fit=crop\" alt=\"Яхты в бухте между скал\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Прибрежный шкипер</span><span class=\"card-title\">Где мы? Определение места и счисление</span><span class=\"card-meta\">Как определить место яхты на бумажной карте: широта и долгота, счисление, счислимое место, определение по пеленгам, створы и поправка компаса.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/passage-planning\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1764726411645-744d48aa4497?w=900&q=80&auto=format&fit=crop\" alt=\"Секстан, часы и измеритель на карте\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Прибрежный шкипер</span><span class=\"card-title\">Планирование перехода</span><span class=\"card-meta\">Как спланировать переход на яхте: карты и лоции, маршрут и путевые точки, ограждающие пеленги, расчёт по световому дню и мельтеми, запасные укрытия и ежечасные записи в вахтенном журнале.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Двое яхтсменов за штурвалом под парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Повороты оверштаг и фордевинд, шаг за шагом</span><span class=\"card-meta\">Как делать повороты оверштаг и фордевинд на парусной яхте: команды, обязанности экипажа, работа с лебёдкой без захлёстов, управляемый фордевинд, выход из левентика и советы для катамаранов.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}