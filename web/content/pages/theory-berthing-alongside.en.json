.7 1-2.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/berthing-alongside\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/berthing-alongside\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/berthing-alongside\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/berthing-alongside\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Harbour and anchorage</li></ol></nav>\n        <h1 class=\"display\">Coming alongside and leaving with springs</h1>\n        <p class=\"lead\">Fuel docks, pontoons, quiet town quays and rafting up all mean berthing alongside. Here is how to prepare, come in under control and spring off again.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Bareboat skipper</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#when\">When to go alongside</a></li><li><a href=\"#lines\">Lines and their names</a></li><li><a href=\"#prepare\">Prepare</a></li><li><a href=\"#approach\">Angle, wind and prop walk</a></li><li><a href=\"#first-line\">Stopping and the first line</a></li><li><a href=\"#leaving\">Springing off</a></li><li><a href=\"#rafting\">Rafting up</a></li><li><a href=\"#practise\">Practise it</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>Set fenders at the height of the quay, lines and springs ready, and brief the crew to step off, never jump.</li><li>Approach slowly at 20 to 30 degrees: steeper with the wind off the quay, shallower with it blowing on.</li><li>Get a midships spring led aft ashore first, then hold the boat in with gentle ahead power.</li><li>To leave a tight berth, motor against a slip spring to swing the stern or bow out first.</li></ul></div>\n          <section id=\"when\">\n<h2>When you berth alongside</h2>\n<p>Berthing alongside means tying up with the side of the boat against a quay, a pontoon or another boat. In most Mediterranean harbours you moor stern-to instead, which has its own guide in this series. But you will still come alongside often:</p>\n<ul>\n<li><b>Fuel docks.</b> Almost always alongside, often in a tight, busy spot.</li>\n<li><b>Town quays.</b> In Turkey and Greece, where there is space, you can often lie alongside a quiet stretch of wall. Ask the harbourmaster if in doubt.</li>\n<li><b>Pontoons.</b> Waiting and reception pontoons in marinas, and visitors' pontoons in some harbours.</li>\n<li><b>Rafting up.</b> Alongside another boat when the quay is full.</li>\n</ul>\n</section>\n<section id=\"lines\">\n<h2>The lines and their names</h2>\n<p>Names for springs vary between schools, so on board it is clearest to say where a line starts and which way it leads.</p>\n<ul>\n<li><b>Bow line.</b> From the bow (front), led forward to the shore. Holds the bow in.</li>\n<li><b>Stern line.</b> From the stern (back), led aft to the shore. Holds the stern in.</li>\n<li><b>Fore spring.</b> From the forward part of the boat, led aft to the shore. Stops her moving forward.</li>\n<li><b>Aft spring.</b> From the after part of the boat, led forward to the shore. Stops her moving back.</li>\n<li><b>Breast lines.</b> Short lines straight across to the shore. Fine for a short stop, but they snatch as the boat moves.</li>\n</ul>\n<p>Together, these keep the boat still and parallel to the quay. Many charter yachts also have a midships cleat near the widest part of the boat. A line from it led aft to the shore, a midships spring, is the most useful first line when you come alongside.</p>\n</section>\n<section id=\"prepare\">\n<h2>Prepare before you go in</h2>\n<p>Set everything up in open water, and decide which side you will tie up on.</p>\n<ul>\n<li><b>Fenders.</b> At least three on the berthing side, along the widest part of the hull. Hang them where the hull will touch: low for a floating pontoon, higher for a stone quay or another yacht's topsides (the sides of the hull above the water). Keep a spare fender in a crew member's hands.</li>\n<li><b>Bow and stern lines.</b> Cleated on board, led outside the guardrails and stanchions, and coiled ready.</li>\n<li><b>Springs.</b> The midships spring ready first, then the fore and aft springs.</li>\n<li><b>Crew briefed.</b> Who steps off with which line, who takes in slack and who fends off. Agree hand signals, since the helm often cannot hear the deck.</li>\n</ul>\n<p>Brief the crew to step off, never jump. Wait until the boat is close and almost stopped, then step from the widest part of the boat, near the shrouds (the wires holding the mast), line in hand. Nobody puts a hand or foot between boat and quay, or tries to stop a moving yacht by pushing.</p>\n</section>\n<section id=\"approach\">\n<h2>The approach: angle, wind and prop walk</h2>\n<p>Approach slowly, with just enough speed to steer, at about 20 to 30 degrees to the quay. Aim a little ahead of where you want to stop. A few metres off, turn parallel and stop her alongside.</p>\n<h3>Wind onto the quay</h3>\n<p>Easy coming in, harder leaving. Approach at a shallower angle, stop parallel a metre or two off and let the wind push you in. Check the fenders, because she will land with some weight.</p>\n<h3>Wind off the quay</h3>\n<p>The bow blows away the moment you slow down. Approach at a steeper angle with a little more speed, and get the midships spring ashore quickly. Leaving is simple: let go and drift off.</p>\n<h3>Prop walk</h3>\n<p>Prop walk is the sideways kick of the propeller in reverse. On most charter yachts, with a right-handed propeller, the stern kicks to port when you go astern. Port side to, that helps: the kick brings the stern in as you stop. Starboard side to, it pulls the stern away, so come in at a shallower angle and use less astern. Check your boat in open water first.</p>\n</section>\n<section id=\"first-line\">\n<h2>Stopping and the first line</h2>\n<p>A yacht carries way (keeps moving) for longer than you expect. Come in at walking pace or less and stop her with a short burst of astern. If the approach looks wrong, go round and try again.</p>\n<p>The first line ashore should stop the boat moving forward: the midships spring, led aft to a cleat or bollard. With it made fast and the engine slow ahead, the boat holds herself against the quay while the crew add bow and stern lines without hurry.</p>\n<p>A touch of rudder sets the angle while you motor against the spring. Steering away from the quay brings the stern in. Steering towards it pushes the stern out. If you are staying, add fore and aft springs and adjust everything so she lies parallel.</p>\n</section>\n<section id=\"leaving\">\n<h2>Leaving: springing off</h2>\n<p>With the wind pushing you on, or boats close ahead and astern, use a spring to swing one end out first. Rig it as a slip line: led around the cleat or bollard ashore and back on board, so you can let go and pull it in from the boat. Brief the crew, then remove the other lines.</p>\n<h3>Springing the stern out</h3>\n<ol>\n<li>Rig a fore spring as a slip line, from the bow led aft. Put a fender right at the bow.</li>\n<li>Motor gently ahead with the wheel turned to steer towards the quay. The spring holds the bow in and the stern swings out.</li>\n<li>When the stern is well clear, go into neutral, slip the spring and reverse away, allowing for prop walk.</li>\n</ol>\n<h3>Springing the bow out</h3>\n<ol>\n<li>Rig an aft spring as a slip line, from the stern led forward. Put a fender on the quarter (the back corner of the boat).</li>\n<li>Motor gently astern with the rudder centred. The spring stops the boat going back and the bow swings out.</li>\n<li>When the bow is clear, go into neutral, slip the spring and motor ahead, wheel straight at first so the stern does not swing into the quay.</li>\n</ol>\n<p>Going ahead sends strong propeller wash over the rudder, so springing the stern out is the more powerful method in a stronger onshore wind.</p>\n<aside class=\"note warn\"><b>Watch out</b><p>Once the slip line is released, pull it in quickly and keep it out of the water. A trailing rope can wrap the propeller in seconds, just when you need the engine most.</p></aside>\n</section>\n<section id=\"rafting\">\n<h2>Rafting up</h2>\n<p>When the quay is full, you may tie up alongside a boat that is already berthed. Good manners keep a raft friendly.</p>\n<ul>\n<li><b>Ask first.</b> Ask the crew of the boat you want to lie against, and rig fenders at the height of their topsides.</li>\n<li><b>Bigger boats inside.</b> Heavier boats should be nearest the quay.</li>\n<li><b>Stagger the masts.</b> If the boats roll, spreaders (the struts on the mast) level with each other can clash.</li>\n<li><b>Lines to the boat and the shore.</b> Rig breast lines and springs to the inner boat, then take your own bow and stern lines ashore, so the raft does not hang on the inner boat's cleats.</li>\n<li><b>Cross by the foredeck.</b> Walk over the foredeck, never through someone's cockpit, and quietly at night.</li>\n<li><b>Plan the morning.</b> If an inner boat leaves first, agree the plan the evening before.</li>\n</ul>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On our courses you come alongside fuel docks, pontoons and town quays in different winds, port and starboard side to, until each crew member has helmed and handled the lines. You also spring off by the bow and by the stern, and raft up when a harbour is busy, so leaving a tight berth becomes routine.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#when\">When to go alongside</a></li><li><a href=\"#lines\">Lines and their names</a></li><li><a href=\"#prepare\">Prepare</a></li><li><a href=\"#approach\">Angle, wind and prop walk</a></li><li><a href=\"#first-line\">Stopping and the first line</a></li><li><a href=\"#leaving\">Springing off</a></li><li><a href=\"#rafting\">Rafting up</a></li><li><a href=\"#practise\">Practise it</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">International Bareboat Skipper</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en/courses/bareboat-skipper\">See the course</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"A harbour town lit at dusk above the sea\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Mediterranean mooring, step by step</span><span class=\"card-meta\">How to moor stern-to in the Mediterranean with lazy lines or your own anchor: crew briefing, prop walk, the approach, crossed anchors and leaving.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/anchoring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=900&q=80&auto=format&fit=crop\" alt=\"Boats anchored in a turquoise cove\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Anchoring: the spot, the scope, the hold</span><span class=\"card-meta\">How to anchor a yacht: choosing a sheltered bay with good holding, how much chain to use, setting the anchor, checking it holds and taking shore lines.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Two sailors at the wheel under sail\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Tacking and gybing, step by step</span><span class=\"card-meta\">How to tack and gybe a sailing yacht: the calls, crew jobs, winches without riding turns, a controlled gybe, getting out of irons and tips for catamarans.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/reefing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777404380697-6b0725b148a7?w=900&q=80&auto=format&fit=crop\" alt=\"Two crew working at the mast in a fresh breeze\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reefing: when and how to shorten sail</span><span class=\"card-meta\">When and how to reef a sailing yacht: signs it is time, slab reefing step by step, in-mast furling mains, rolling in the genoa, sail balance and shaking out.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}