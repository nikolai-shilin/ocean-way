.5A6 6 0 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/position-fixing\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/position-fixing\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/position-fixing\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/position-fixing\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Weather and navigation</li></ol></nav>\n        <h1 class=\"display\">Where are we? Position fixing and dead reckoning</h1>\n        <p class=\"lead\">A chartplotter tells you where you are until it doesn't. This guide covers the chart, dead reckoning, bearing fixes, transits and compass corrections, so you can always find your position on paper.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Coastal skipper</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#chart-basics\">Chart basics</a></li><li><a href=\"#why-paper\">Why paper still matters</a></li><li><a href=\"#dead-reckoning\">Dead reckoning</a></li><li><a href=\"#estimated-position\">Estimated position</a></li><li><a href=\"#bearing-fix\">Three-point bearing fix</a></li><li><a href=\"#transits-depth\">Transits and depth</a></li><li><a href=\"#compass\">Variation and deviation</a></li><li><a href=\"#methods\">Choosing a method</a></li><li><a href=\"#logbook\">Keeping a logbook</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>One minute of latitude is one nautical mile; measure on the side scale.</li><li>DR uses course and log distance; an EP adds leeway and current.</li><li>A small cocked hat means a good fix.</li><li>True, Variation, Magnetic, Deviation, Compass: add west, subtract east.</li></ul></div>\n          <section id=\"chart-basics\">\n<h2>Chart basics</h2>\n<p>Every position on a chart is given by two numbers. <b>Latitude</b> is how far north or south of the equator you are, from 0° to 90°. <b>Longitude</b> is how far east or west of Greenwich, from 0° to 180°. Each degree is divided into 60 minutes. Most of the Mediterranean lies between about 30° and 46° North.</p>\n<p>One minute of latitude equals one nautical mile (1,852 metres). So to measure distance, use the latitude scale on the left or right side of the chart, level with where you are measuring. Never use the longitude scale along the top and bottom: a minute of longitude gets shorter as you move away from the equator.</p>\n<p><b>Chart datum</b> is the low-water level the printed depths are measured from. With very little tide in most of the Mediterranean, depths on the chart are close to what you will find. Also check the note on which horizontal datum the chart uses. Modern charts use WGS84, the same as GPS, but some older charts do not, and positions can then be offset.</p>\n</section>\n<section id=\"why-paper\">\n<h2>Why paper still matters</h2>\n<p>A chartplotter is a superb tool, and you should use it. But it depends on power, a dry screen, a satellite signal and a chart that is correct. Any of these can fail. Batteries go flat. Some remote bays are charted from old surveys, and the electronic chart can be offset from reality. GPS signals can also be jammed or spoofed, and interference has been reported repeatedly in parts of the eastern Mediterranean in recent years.</p>\n<p>A paper chart with your position marked every hour means that if the screen goes blank, you know where you are and where the dangers are. It is also the best way to understand what the plotter is telling you.</p>\n</section>\n<section id=\"dead-reckoning\">\n<h2>Dead reckoning</h2>\n<p>Dead reckoning (DR) is working out your position from where you were, which way you steered and how far you went. You need three things:</p>\n<ul>\n<li>your last known position (a fix), with the time;</li>\n<li>the course you steered, converted to true;</li>\n<li>the distance run, from the log (the instrument that measures distance through the water).</li>\n</ul>\n<p>Example: at 1000 you fixed your position off Hydra, the log read 12.4 and you steered 090°T. At 1100 the log reads 18.4, so you have run 6 miles. Draw a line from the fix along 090°, measure 6 miles on the latitude scale, and mark it with the time. That is your DR position.</p>\n</section>\n<section id=\"estimated-position\">\n<h2>Estimated position</h2>\n<p>A DR ignores everything that pushes the boat sideways. An estimated position (EP) adds it back. Mark it with a small triangle and the time.</p>\n<p><b>Leeway</b> is the sideways slip caused by the wind. Close-hauled (sailing as close to the wind as you can) in a fresh breeze, a cruising yacht may make 5–10° of leeway. With the wind behind, it is close to zero. Watch the angle between your wake and the centreline to judge it. Apply it away from the wind: if the wind is on the port (left) side, add leeway to your heading; on the starboard (right) side, subtract it.</p>\n<p><b>Current.</b> Tidal streams are weak in most of the Mediterranean, but water still moves. Currents run through straits and channels, and a meltemi blowing for several days sets up a surface drift. They are often under a knot, but stronger in some places. Check the pilot book. If you know the set (direction) and rate, draw it from your water track for the time elapsed.</p>\n</section>\n<section id=\"bearing-fix\">\n<h2>The three-point bearing fix</h2>\n<p>A fix is a position you have measured, not estimated. The classic method uses a hand-bearing compass, a small compass you hold to your eye.</p>\n<ol>\n<li>Pick three objects that are on the chart and easy to identify: a lighthouse, a church, the end of a headland. They should be well spread, ideally 60° or more apart.</li>\n<li>Take the bearings quickly. Take objects ahead or astern first and those on the beam (off the side) last, because beam bearings change fastest.</li>\n<li>Note the time and the log reading.</li>\n<li>Convert each bearing to true by applying variation.</li>\n<li>Draw each line on the chart towards the object.</li>\n</ol>\n<p>The three lines almost never meet at a point. They form a small triangle called the <b>cocked hat</b>. A small cocked hat means a good fix. A large one means a mistake: a wrongly identified object or a misread bearing. Take the bearings again. For safety, assume you are at the corner of the triangle nearest to danger.</p>\n</section>\n<section id=\"transits-depth\">\n<h2>Transits and depth contours</h2>\n<p><b>A transit</b> is two charted objects in line, such as a beacon and a chapel. When they line up, you are exactly on the line through them. No compass is needed, so there is no compass error. Many harbours have leading marks or lights built for this. A transit is also a quick way to check your steering compass.</p>\n<p><b>Depth</b> is a useful cross-check. If your fix puts you on the 20-metre contour but the echo sounder shows 45 metres, something is wrong. Know whether your sounder shows depth below the transducer, below the keel or below the surface.</p>\n</section>\n<section id=\"compass\">\n<h2>Variation and deviation</h2>\n<p>Charts are drawn to true north. Your compass points to magnetic north, and it is also pulled aside by the boat's own metal and electrics. So you correct in two steps:</p>\n<ul>\n<li><b>Variation</b> is the difference between true and magnetic north. It depends on place and year, and it is printed on the compass rose of the chart. In the Aegean it is small and east, around 5°E, and changing slowly.</li>\n<li><b>Deviation</b> is the error caused by the boat itself. It changes with the boat's heading and is shown on the boat's deviation card.</li>\n</ul>\n<p>Remember the order: <b>True, Variation, Magnetic, Deviation, Compass</b> (\"True Virgins Make Dull Companions\"). Going from true to compass, add west and subtract east.</p>\n<p>Worked example: you want to steer 045°T. Variation is 5°E, so subtract: 040°M. The deviation card says 3°W on this heading, so add: 043°C. You steer 043 on the compass. Going the other way, from compass to true, you reverse the signs.</p>\n</section>\n<section id=\"methods\">\n<h2>Choosing a method</h2>\n<table class=\"tbl\"><thead><tr><th>Technique</th><th>You need</th><th>Accuracy</th><th>Best for</th></tr></thead><tbody>\n<tr><td>GPS</td><td>Power, satellite signal</td><td>Metres, if the chart is right</td><td>Everyday navigation</td></tr>\n<tr><td>Three-point fix</td><td>Hand-bearing compass, three charted objects</td><td>Good near land; worse with distance</td><td>Coastal sailing, checking GPS</td></tr>\n<tr><td>Transit</td><td>Two charted objects in line</td><td>Very good along the line</td><td>Harbour approaches, compass checks</td></tr>\n<tr><td>Depth contour</td><td>Echo sounder, chart</td><td>Rough line only</td><td>Cross-checking, poor visibility</td></tr>\n<tr><td>DR / EP</td><td>Log, compass, last fix</td><td>Gets worse over time</td><td>Between fixes, open water</td></tr>\n</tbody></table>\n</section>\n<section id=\"logbook\">\n<h2>Keep a logbook every hour</h2>\n<p>At sea, write up the log every hour, and at every change of course or sail. Record the time, log reading, course steered, speed, wind direction and force, barometer, and your position with how you got it (GPS, fix or EP). Note events too: reefing, engine on, sightings.</p>\n<p>If everything electronic fails, your last log entry is the start point for a new DR. It is also the boat's official record of the passage.</p>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On our courses you plot DR and EP on paper alongside the chartplotter, take three-point fixes along the coast and compare them with the GPS. Each hour you write up the log, so the routine stays with you after the course.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#chart-basics\">Chart basics</a></li><li><a href=\"#why-paper\">Why paper still matters</a></li><li><a href=\"#dead-reckoning\">Dead reckoning</a></li><li><a href=\"#estimated-position\">Estimated position</a></li><li><a href=\"#bearing-fix\">Three-point bearing fix</a></li><li><a href=\"#transits-depth\">Transits and depth</a></li><li><a href=\"#compass\">Variation and deviation</a></li><li><a href=\"#methods\">Choosing a method</a></li><li><a href=\"#logbook\">Keeping a logbook</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Yachtmaster Coastal</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"A wave breaking in clear water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reading the weather: Beaufort, forecasts, meltemi</span><span class=\"card-meta\">Learn the Beaufort scale, where to get Mediterranean sailing forecasts, how to read gusts, and how the meltemi, sirocco and bora affect a 40 ft yacht.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tides\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1505118380757-91f5f5632de0?w=900&q=80&auto=format&fit=crop\" alt=\"Waves meeting a sandy shore from above\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Coastal skipper</span><span class=\"card-title\">Tides: heights, streams and the rule of twelfths</span><span class=\"card-meta\">How tides work for sailors: springs and neaps, chart datum, drying heights, tide tables, the rule of twelfths, under-keel clearance and tidal streams.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/passage-planning\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1764726411645-744d48aa4497?w=900&q=80&auto=format&fit=crop\" alt=\"A sextant, watch and dividers on a chart\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Coastal skipper</span><span class=\"card-title\">Planning a passage</span><span class=\"card-meta\">How to plan a yacht passage: charts and pilot books, route and waypoints, clearing bearings, timing for daylight and the meltemi, bolt holes and the hourly log.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"A sailing yacht close-hauled on open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Points of sail: how a yacht sails close to the wind</span><span class=\"card-meta\">Learn the points of sail from close-hauled to running: the no-go zone, sail trim on each point, tacking and gybing, apparent wind and reading telltales.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/tacking-gybing\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1777880652269-ff1dd5e65fbb?w=900&q=80&auto=format&fit=crop\" alt=\"Two sailors at the wheel under sail\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Tacking and gybing, step by step</span><span class=\"card-meta\">How to tack and gybe a sailing yacht: the calls, crew jobs, winches without riding turns, a controlled gybe, getting out of irons and tips for catamarans.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}