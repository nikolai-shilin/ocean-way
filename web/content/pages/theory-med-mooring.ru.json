></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/ru\" aria-label=\"Ocean Way, главная\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Главное меню\">\n      <a class=\"navl\" href=\"/ru#courses\">Курсы</a>\n      <a class=\"navl\" href=\"/ru#passages\">Переходы</a>\n      <a class=\"navl on\" href=\"/ru/theory\">Теория</a>\n      <a class=\"navl\" href=\"/ru#fleet\">Флот</a>\n      <a class=\"navl\" href=\"#\">Цены</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Язык: Русский\">RU</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/med-mooring\" hreflang=\"en\" lang=\"en\">English<span>EN</span></a></li><li><a href=\"/ru/theory/med-mooring\" hreflang=\"ru\" lang=\"ru\" aria-current=\"true\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/med-mooring\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/med-mooring\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Тема\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Избранное\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Аккаунт\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Навигационная цепочка\"><ol><li><a href=\"/ru\">Главная</a></li><li><a href=\"/ru/theory\">Теория</a></li><li aria-current=\"page\">Гавань и якорная стоянка</li></ol></nav>\n        <h1 class=\"display\">Средиземноморская швартовка шаг за шагом</h1>\n        <p class=\"lead\">В большинстве гаваней Средиземноморья яхты стоят кормой к причалу. Рассказываем, как подготовиться, зайти и встать на муринг или на собственный якорь — спокойно и без суеты.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Инструкторы Ocean Way</span><span class=\"meta\">Обновлено 1 нояб 2026</span><span class=\"meta\">6 минут чтения</span><span class=\"lvl\">Бербоут-шкипер</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>На этой странице<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#two-ways\">Два способа швартовки</a></li><li><a href=\"#prepare\">Подготовка</a></li><li><a href=\"#read-berth\">Ветер, просвет и заброс кормы</a></li><li><a href=\"#sequence\">Шаг за шагом</a></li><li><a href=\"#crossed-anchors\">Перехлёст цепей</a></li><li><a href=\"#leaving\">Отход от причала</a></li><li><a href=\"#crosswind\">Советы при боковом ветре</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">Коротко</span><ul><li>Перед заходом подготовьте кранцы с обоих бортов, два кормовых швартова, отпорный крюк и проинструктируйте экипаж.</li><li>Узнайте, как у вашей яхты забрасывает корму, и заходите задним ходом медленно, при боковом ветре целясь в наветренную часть просвета.</li><li>Проведите муринг вдоль борта на нос или отдайте якорь в 3–4 корпусах от причала и травите цепь по прямой.</li><li>Не допускайте, чтобы концы оказывались в воде рядом с винтом.</li></ul></div>\n          <section id=\"two-ways\">\n<h2>Два способа встать кормой</h2>\n<p>В большинстве средиземноморских гаваней яхты не стоят лагом к понтону. Вы швартуетесь <b>кормой</b>: корма яхты закреплена у причала, а нос удерживается концом или якорем. Так на небольшом пространстве помещается много яхт, а сойти на берег можно по пасарелле (сходням).</p>\n<p>Есть два варианта:</p>\n<ul>\n<li><b>Стационарный муринг.</b> В большинстве марин и на многих городских набережных Хорватии и Греции по дну проложены тяжёлые донные концы. От каждого места у причала вниз к якорной цепи уходит более тонкий конец — муринг. Вы подбираете его с кормы и проводите на нос.</li>\n<li><b>Собственный якорь.</b> На многих городских набережных греческих островов и местами в Турции муринга нет. Вы отдаёте якорь подальше от причала и заходите задним ходом, вытравливая цепь по ходу.</li>\n</ul>\n<p>Подход в обоих случаях одинаковый. Отличается только то, что держит нос.</p>\n</section>\n<section id=\"prepare\">\n<h2>Подготовьтесь до захода</h2>\n<p>Большинство проблем при швартовке начинается с неготового экипажа. Подготовьте всё заранее, далеко от гавани, на открытой воде, где есть время.</p>\n<ul>\n<li><b>Кранцы с обоих бортов</b>, в самой широкой части корпуса и ближе к корме. Вы можете оказаться между двумя яхтами и не всегда знаете заранее, на какой борт придётся нагрузка.</li>\n<li><b>Два кормовых швартова</b>, по одному с каждого борта: закреплены на утке, уложены в бухту и проведены снаружи лееров, чтобы их можно было чисто бросить или подать на берег.</li>\n<li><b>Отпорный крюк</b> наготове на корме, чтобы подхватить муринг.</li>\n<li><b>Брашпиль</b> (якорная лебёдка) включён, а якорь готов к отдаче, если вы встаёте на собственный.</li>\n<li><b>Роли распределены.</b> Кто работает с каждым кормовым швартовом, кто берёт муринг или управляет брашпилем, кто отталкивается от соседей. Договоритесь о простых жестах: за шумом двигателя рулевой не слышит человека на носу.</li>\n</ul>\n<p>Если в марине есть маринеро (сотрудник марины), свяжитесь с мариной по VHF или по телефону до подхода. Обычно вам укажут место и подадут муринг.</p>\n</section>\n<section id=\"read-berth\">\n<h2>Оцените ветер, просвет и заброс кормы</h2>\n<p>Прежде чем заходить, остановитесь напротив места и осмотритесь. Откуда дует ветер и насколько он силён? Хватит ли просвета на вашу ширину плюс кранцы? Не мешают ли швартовы или якорные цепи соседей?</p>\n<p>Затем подумайте о <b>забросе кормы от винта</b>. Винт, вращающийся на задний ход, толкает корму не только назад, но и вбок. На большинстве чартерных яхт винт правого вращения, и на заднем ходу корму забрасывает влево, на левый борт. Проверьте это на своей яхте на открытой воде: включите задний ход при штурвале в нулевом положении и посмотрите, куда уходит корма.</p>\n<p>Используйте это. Если корму забрасывает влево, заходите так, чтобы заброс помогал выровняться в конце, или начинайте разворот раньше, чтобы яхту не прижало к соседу. При боковом ветре заходите с наветренной стороны и цельтесь чуть наветреннее просвета: как только вы сбросите ход, нос начнёт сносить под ветер.</p>\n</section>\n<section id=\"sequence\">\n<h2>Заход шаг за шагом</h2>\n<p>Ниже основная последовательность для муринга; дополнительные шаги для собственного якоря отмечены отдельно.</p>\n<ol>\n<li>Выровняйтесь на некотором расстоянии от причала, кормой к своему месту, и медленно начните движение задним ходом. Наберите управляемость (достаточный поток воды на руле) до того, как подойдёте к линии яхт.</li>\n<li><b>Свой якорь:</b> отдайте якорь примерно в 3–4 корпусах от причала, на линии своего места. Равномерно травите цепь, пока идёте назад, чтобы она легла на дно прямой линией. Не давайте ей ложиться кучей и не стопорите её, пока почти не зашли.</li>\n<li>Идите назад медленно, короткими включениями хода и нейтралью. Подходите не быстрее, чем готовы удариться о причал.</li>\n<li>Примерно в метре от причала остановите яхту коротким передним ходом. Экипаж сходит на берег или подаёт на берег сначала наветренный кормовой швартов, затем второй.</li>\n<li><b>Муринг:</b> подхватите его отпорным крюком на корме и передайте вперёд. Проведите его вдоль борта снаружи леерных стоек до носа.</li>\n<li>Выбирайте муринг руками, перехватывая, пока он не натянется, затем закрепите его на носовой утке.</li>\n<li><b>Свой якорь:</b> аккуратно обтяните цепь брашпилем, пока она не начнёт держать нос, а якорь не заберёт.</li>\n<li>Отрегулируйте кормовые швартовы так, чтобы корма стояла достаточно далеко от причала и не касалась его при рывках яхты, но достаточно близко, чтобы сойти по пасарелле. Двигатель в нейтраль, затем заглушите.</li>\n</ol>\n<p>Делайте всё медленно. Яхту, идущую назад со скоростью пешехода, легко остановить. Идущую на трёх узлах — нет.</p>\n<aside class=\"note warn\"><b>Осторожно</b><p>Конец рядом с винтом может намотаться на него за секунды и заглушить двигатель именно тогда, когда он нужен. Не допускайте, чтобы кормовые швартовы оказывались в воде. Подняв муринг, поставьте двигатель в нейтраль и быстро проведите муринг вперёд, чтобы он утонул подальше от кормы. Никогда не давайте резкий передний ход, пока за кормой висит хоть один конец.</p></aside>\n</section>\n<section id=\"crossed-anchors\">\n<h2>Перехлёст цепей</h2>\n<p>При швартовке на собственный якорь самая частая проблема — положить свою цепь поверх цепи соседа. Когда один из вас уходит, якорь поднимается вместе с чужой цепью.</p>\n<p>Чтобы этого избежать, до захода посмотрите, под каким углом лежат цепи соседей, отдавайте якорь строго напротив своего места, а не наискось, и по возможности заходите после того, как яхты по обе стороны от вас уже встали. Если кто-то положил цепь поверх вашей, скажите об этом вежливо и сразу.</p>\n<p>Если вы всё же подняли чужую цепь, остановите брашпиль. Заведите конец под чужую цепь, закрепите оба его конца на борту, затем немного потравите якорь, чтобы он освободился. Отдайте один конец и дайте чужой цепи упасть обратно.</p>\n</section>\n<section id=\"leaving\">\n<h2>Отход от причала</h2>\n<p>Перед началом проинструктируйте экипаж. На муринге заведите кормовые швартовы на слип (вдвое, через рым на причале и обратно на борт), чтобы отдать их с яхты. Отдайте муринг на носу и подождите, пока он уйдёт глубоко под воду. Затем выберите кормовые швартовы и плавно выходите передним ходом.</p>\n<p>На собственном якоре отдайте кормовые швартовы и выбирайте цепь брашпилем, пока рулевой даёт малый передний ход, чтобы снять с неё нагрузку. Держите яхту на линии цепи, пока якорь не оторвётся от грунта.</p>\n</section>\n<section id=\"crosswind\">\n<h2>Советы при боковом ветре</h2>\n<ul>\n<li>Сначала подайте на берег наветренный кормовой швартов. Он не даст корме уйти под ветер.</li>\n<li>Чуть больше скорости — больше контроля. Не ползите так медленно, что носом начнёт управлять ветер.</li>\n<li>На собственном якоре отдавайте его чуть наветреннее своего места. Тогда цепь будет удерживать нос против ветра, пока вы идёте назад.</li>\n<li>Если что-то пошло не так, выйдите, перестройтесь и попробуйте снова. Во втором заходе нет ничего стыдного.</li>\n</ul>\n</section>\n<section id=\"practise\">\n<h2>Отработайте на воде</h2>\n<p>На наших курсах вы отрабатываете это в настоящих гаванях, на муринге и на собственном якоре, пока каждый член экипажа не побывает в каждой роли. Начинаете при слабом ветре и переходите к местам с боковым ветром, когда порядок действий станет привычным.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"На этой странице\"><span class=\"kicker\">На этой странице</span><ol class=\"toc-list\"><li><a href=\"#two-ways\">Два способа швартовки</a></li><li><a href=\"#prepare\">Подготовка</a></li><li><a href=\"#read-berth\">Ветер, просвет и заброс кормы</a></li><li><a href=\"#sequence\">Шаг за шагом</a></li><li><a href=\"#crossed-anchors\">Перехлёст цепей</a></li><li><a href=\"#leaving\">Отход от причала</a></li><li><a href=\"#crosswind\">Советы при боковом ветре</a></li><li><a href=\"#practise\">Отработайте на практике</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Отработайте на курсе</span><div class=\"card-title\">International Bareboat Skipper</div><p>Научитесь этому на воде с инструктором, за неделю жизни на яхте.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/ru/courses/bareboat-skipper\">Смотреть курс</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Теория</span><h2 class=\"h2\" style=\"margin-top:12px\">Читайте также</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/ru/theory\">Вся теория</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"Ещё теория\"><a class=\"card\" href=\"/ru/theory/anchoring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=900&q=80&auto=format&fit=crop\" alt=\"Яхты на якоре в бирюзовой бухте\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Постановка на якорь: место, длина цепи, держание</span><span class=\"card-meta\">Как поставить яхту на якорь: выбор защищённой бухты с хорошим грунтом, сколько вытравить цепи, как заглубить якорь, проверить, что он держит, и завести береговые концы.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/points-of-sail\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1540946485063-a40da27545f8?w=900&q=80&auto=format&fit=crop\" alt=\"Парусная яхта идёт бейдевиндом в открытом море\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Курсы относительно ветра: как яхта ходит круто к ветру</span><span class=\"card-meta\">Курсы относительно ветра от бейдевинда до фордевинда: мёртвая зона, настройка парусов на каждом курсе, повороты оверштаг и фордевинд, вымпельный ветер и колдунчики.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"Шхуна под всеми парусами\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Новичкам</span><span class=\"card-title\">Шесть узлов, которые нужны каждому в экипаже</span><span class=\"card-meta\">Шесть морских узлов, нужных каждому члену экипажа: беседочный, выбленочный, два полуштыка с оборотом, крепление на утке, восьмёрка и прямой узел, шаг за шагом.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"Моторная яхта идёт открытым морем\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Правила расхождения в море: что шкиперы применяют каждый день</span><span class=\"card-meta\">МППСС, которые шкипер яхты применяет каждый день: наблюдение, безопасная скорость, опасность столкновения, кто уступает дорогу под парусом и под мотором, обгон, ход под парусами с мотором и фарватеры.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"Яхта под звёздным ночным небом\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Навигационные огни и дневные знаки</span><span class=\"card-meta\">Топовый, бортовые и кормовой огни, трёхцветный фонарь, якорный огонь и дневные знаки по части C МППСС, а также как распознать ночью рыболовные суда, буксиры и большие суда.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a><a class=\"card\" href=\"/ru/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"Волна разбивается в прозрачной воде\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Бербоут-шкипер</span><span class=\"card-title\">Читаем погоду: Бофорт, прогнозы, мельтеми</span><span class=\"card-meta\">Шкала Бофорта, где брать прогнозы погоды для Средиземноморья, как читать порывы и как мельтеми, сирокко и бора влияют на 40-футовую яхту.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 минут чтения</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Прототип вёрстки. Цены, даты и люди условные. Фото: Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">О нас</a><a href=\"#\">Telegram</a><a href=\"#\">Конфиденциальность</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}