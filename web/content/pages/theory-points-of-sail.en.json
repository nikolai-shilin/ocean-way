 0 0 12 3z\"/></symbol>\n  <symbol id=\"i-tool\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18v3h3l6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-2.5z\"/></symbol>\n  <symbol id=\"i-clip\" viewBox=\"0 0 24 24\"><rect x=\"5\" y=\"4\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M9 4V3h6v1M9 10h6M9 14h6M9 18h3\"/></symbol>\n  <symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12.5 4.5 4.5L19 7.5\"/></symbol>\n  <symbol id=\"i-minus\" viewBox=\"0 0 24 24\"><path d=\"M6 12h12\"/></symbol>\n  <symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 11v6M12 7.5v.5\"/></symbol>\n  <symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6-4.9-4.6 6.6-.8z\"/></symbol>\n  <symbol id=\"i-down\" viewBox=\"0 0 24 24\"><path d=\"M12 4v12M6 10l6 6 6-6M5 20h14\"/></symbol>\n  <symbol id=\"i-cert\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"12\" rx=\"2\"/><path d=\"M7 8h10M7 11h6M15 16v5l2-1.5 2 1.5v-5\"/></symbol>\n  <symbol id=\"i-family\" viewBox=\"0 0 24 24\"><circle cx=\"7\" cy=\"6\" r=\"2.5\"/><circle cx=\"17\" cy=\"6\" r=\"2.5\"/><circle cx=\"12\" cy=\"12\" r=\"2\"/><path d=\"M3 20c0-4 2-7 4-7s4 3 4 7M13 20c0-4 2-7 4-7s4 3 4 7\"/></symbol>\n</svg>\n\n", "header": "<header class=\"site-head\">\n    <a class=\"logo\" href=\"/en\" aria-label=\"Ocean Way, home\"><svg viewBox=\"2 2 116 116\" aria-hidden=\"true\"><defs><clipPath id=\"logo-clip\"><circle cx=\"60\" cy=\"60\" r=\"47.01\"/></clipPath></defs><g clip-path=\"url(#logo-clip)\" fill=\"currentColor\"><line x1=\"0\" y1=\"72.3\" x2=\"120\" y2=\"54.6\" stroke=\"currentColor\" stroke-width=\"11\"/><path d=\"M28 59 C36 36 72 23.5 118 32 L118 51 C84 41 47 43.5 28 59Z\"/></g><circle cx=\"60\" cy=\"60\" r=\"52.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"11\"/></svg></a>\n    <nav class=\"site-nav\" aria-label=\"Main\">\n      <a class=\"navl\" href=\"/en#courses\">Courses</a>\n      <a class=\"navl\" href=\"/en#passages\">Passages</a>\n      <a class=\"navl on\" href=\"/en/theory\">Theory</a>\n      <a class=\"navl\" href=\"/en#fleet\">Fleet</a>\n      <a class=\"navl\" href=\"#\">Prices</a>\n    </nav>\n    <div class=\"site-tools\">\n      <details class=\"lang\" translate=\"no\"><summary class=\"round\" aria-label=\"Language: English\">EN</summary><ul class=\"lang-menu\"><li><a href=\"/en/theory/points-of-sail\" hreflang=\"en\" lang=\"en\" aria-current=\"true\">English<span>EN</span></a></li><li><a href=\"/ru/theory/points-of-sail\" hreflang=\"ru\" lang=\"ru\">Русский<span>RU</span></a></li><li><a href=\"/de/theory/points-of-sail\" hreflang=\"de\" lang=\"de\">Deutsch<span>DE</span></a></li><li><a href=\"/es/theory/points-of-sail\" hreflang=\"es\" lang=\"es\">Español<span>ES</span></a></li></ul></details>\n      \n      \n      \n      \n      \n      \n      \n      \n      <button class=\"round\" type=\"button\" id=\"themeBtn\" aria-label=\"Theme\"><svg class=\"i\"><use href=\"#i-theme\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Saved\"><svg class=\"i\"><use href=\"#i-heart\"/></svg></button>\n      <button class=\"round\" type=\"button\" aria-label=\"Account\"><svg class=\"i\"><use href=\"#i-user\"/></svg></button>\n    </div>\n  </header>", "main": "\n    <article>\n      <header class=\"art-head\">\n        <nav class=\"crumbs\" aria-label=\"Breadcrumb\"><ol><li><a href=\"/en\">Home</a></li><li><a href=\"/en/theory\">Theory</a></li><li aria-current=\"page\">Sailing basics</li></ol></nav>\n        <h1 class=\"display\">Points of sail: how a yacht sails close to the wind</h1>\n        <p class=\"lead\">A yacht cannot sail straight into the wind, but it can sail at almost any other angle. Here are the points of sail, how to trim for each, and how tacking differs from gybing.</p>\n        <div class=\"byline\"><span class=\"meta\" style=\"color:var(--ink)\">Ocean Way instructors</span><span class=\"meta\">Updated 1 Nov 2026</span><span class=\"meta\">6 min read</span><span class=\"lvl\">Beginner</span></div>\n      </header>\n      <div class=\"art-grid\">\n        <div class=\"art-body\">\n          <details class=\"art-mobile-toc band\"><summary>On this page<svg class=\"i\"><use href=\"#i-chev\"/></svg></summary><ol class=\"toc-list\"><li><a href=\"#wind\">The wind and the no-go zone</a></li><li><a href=\"#points\">The points of sail</a></li><li><a href=\"#trim\">Heading up and bearing away</a></li><li><a href=\"#tacking-gybing\">Tacking and gybing</a></li><li><a href=\"#apparent-wind\">True and apparent wind</a></li><li><a href=\"#telltales\">Reading the telltales</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol></details>\n          <div class=\"band summary\"><span class=\"kicker\">In short</span><ul><li>No sail works within about 45° of the wind: this is the no-go zone.</li><li>As you head up, sheet in; as you bear away, ease out.</li><li>Tacking turns the bow through the wind; gybing turns the stern, and the boom swings right across.</li><li>Telltales show the airflow: trim or steer until both stream back.</li></ul></div>\n          <section id=\"wind\">\n<h2>Where the wind comes from</h2>\n<p>Everything on a sailing yacht starts with the wind direction. Before you touch a sheet (a line that controls a sail), find where the wind is coming from. Feel it on your face and ears, look at the wind indicator at the top of the mast, and watch the ripples on the water.</p>\n<p>A sail cannot drive a yacht straight into the wind. There is a sector, roughly 45° either side of the wind, where the sails simply flap and the boat slows down. This is the no-go zone. The exact angle varies with the boat and the sea: a modern cruising yacht in flat water may point a little higher, while a heavy boat in a short chop will not sail as close. If you turn into the no-go zone and stop, you are \"in irons\": stuck head to wind with no steering.</p>\n<p>Every other direction is open to you. The names for the angles between your course and the wind are the points of sail.</p>\n<figure class=\"dgfig\"><div class=\"frame\"><svg class=\"dg\" viewBox=\"0 0 640 480\" role=\"img\" aria-label=\"Points of sail around the wind, with the no-go zone about 45 degrees either side of the wind\"><path class=\"dg-nogo\" d=\"M320,250 L187.4,117.4 A187.5,187.5 0 0 1 452.6,117.4 Z\"/><text class=\"dg-label dg-muted\" x=\"320\" y=\"94\" text-anchor=\"middle\">No-go zone</text><circle class=\"dg-ring\" cx=\"320\" cy=\"250\" r=\"150\"/><g class=\"dg-boat \" transform=\"translate(426.1 143.9) rotate(45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"2.1\" y2=\"9.9\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"123.9\" text-anchor=\"start\">Close-hauled</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 143.9) rotate(-45)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-2.1\" y2=\"9.9\"/></g><g class=\"dg-boat \" transform=\"translate(455.9 186.6) rotate(65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"6.3\" y2=\"8.6\"/></g><text class=\"dg-label\" x=\"486.8\" y=\"176.2\" text-anchor=\"start\">Close reach</text><g class=\"dg-boat dg-faint\" transform=\"translate(184.1 186.6) rotate(-65)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-6.3\" y2=\"8.6\"/></g><g class=\"dg-boat \" transform=\"translate(470.0 250.0) rotate(90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"10.6\" y2=\"5.6\"/></g><text class=\"dg-label\" x=\"504.0\" y=\"254.0\" text-anchor=\"start\">Beam reach</text><g class=\"dg-boat dg-faint\" transform=\"translate(170.0 250.0) rotate(-90)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-10.6\" y2=\"5.6\"/></g><g class=\"dg-boat \" transform=\"translate(426.1 356.1) rotate(135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"13.6\" y2=\"1.3\"/></g><text class=\"dg-label\" x=\"450.1\" y=\"384.1\" text-anchor=\"start\">Broad reach</text><g class=\"dg-boat dg-faint\" transform=\"translate(213.9 356.1) rotate(-135)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"-13.6\" y2=\"1.3\"/></g><g class=\"dg-boat \" transform=\"translate(320.0 400.0) rotate(180)\"><path class=\"dg-hull\" d=\"M0,-17 C6.5,-8 6.5,8 4,15 L-4,15 C-6.5,8 -6.5,-8 0,-17Z\"/><line class=\"dg-sail\" x1=\"0\" y1=\"-5\" x2=\"14.9\" y2=\"-3.7\"/></g><text class=\"dg-label\" x=\"320.0\" y=\"456.0\" text-anchor=\"middle\">Running</text><line class=\"dg-wind\" x1=\"320\" y1=\"18\" x2=\"320\" y2=\"64\"/><path class=\"dg-windhead\" d=\"M313,56 L320,70 L327,56Z\"/><text class=\"dg-label\" x=\"332\" y=\"34\">Wind</text><text class=\"dg-label dg-muted\" x=\"496\" y=\"290\" text-anchor=\"start\">Port tack</text><text class=\"dg-label dg-muted\" x=\"144\" y=\"290\" text-anchor=\"end\">Starboard tack</text></svg></div><figcaption class=\"disclaimer\">Points of sail with the wind from the top. No yacht can sail inside the no-go zone, about 45° either side of the wind; boats on the right have the wind over their port side (port tack), the faint ones on the left are on starboard tack.</figcaption></figure>\n</section>\n<section id=\"points\">\n<h2>The points of sail</h2>\n<p>Each point of sail describes the angle between the bow (the front of the boat) and the wind. The side the wind comes over matters too: with the wind on the starboard (right) side you are on starboard tack, and with it on the port (left) side you are on port tack. The names below apply on either tack.</p>\n<h3>Close-hauled</h3>\n<p>About 45° to the wind, just outside the no-go zone. Both sails are pulled in tight, close to the centreline of the boat. The yacht heels (leans over) most on this point, the motion is livelier and spray may come over the bow. You steer with small movements, keeping the sails just full.</p>\n<h3>Close reach</h3>\n<p>Around 60° to the wind. Ease (let out) the sheets a little from close-hauled. The boat heels less and usually speeds up.</p>\n<h3>Beam reach</h3>\n<p>The wind is at 90°, straight across the side of the boat. The sails are eased about halfway out. For most cruising yachts this is a fast and comfortable point of sail, and a good one to learn on.</p>\n<h3>Broad reach</h3>\n<p>Around 135°, with the wind coming from behind the beam, over the back quarter of the boat. The sails are well out. The boat sits more upright and the wind feels lighter than it really is. In a swell she may start to roll.</p>\n<h3>Running</h3>\n<p>The wind is from directly behind, at about 180°. The mainsail is eased right out, and the headsail (the sail at the front) often hangs limp in its shadow. You can set the headsail out on the opposite side to the mainsail, which is called goose-winging. Running is where an accidental gybe is most likely, so many skippers prefer a broad reach and change direction in steps.</p>\n<table class=\"tbl\"><thead><tr><th>Point of sail</th><th>Angle to the wind</th><th>Sails</th><th>Feels like</th></tr></thead><tbody>\n<tr><td>Close-hauled</td><td>About 45°</td><td>Pulled in tight</td><td>Heeled, lively, wet</td></tr>\n<tr><td>Close reach</td><td>About 60°</td><td>Eased a little</td><td>Fast, less heel</td></tr>\n<tr><td>Beam reach</td><td>90°</td><td>Eased halfway</td><td>Steady, comfortable</td></tr>\n<tr><td>Broad reach</td><td>About 135°</td><td>Well out</td><td>Upright, may roll</td></tr>\n<tr><td>Running</td><td>About 180°</td><td>Fully out</td><td>Quiet on deck, rolling</td></tr>\n</tbody></table>\n</section>\n<section id=\"trim\">\n<h2>Heading up and bearing away</h2>\n<p>Turning towards the wind is called heading up. Turning away from it is bearing away. Sail trim follows a simple rule: as you head up, sheet in; as you bear away, ease out. Each change of course needs a change of trim.</p>\n<p>A reliable test is to ease the sheet until the luff (the front edge of the sail) starts to flutter, then pull it in just until the flutter stops. That is roughly the right setting for your course.</p>\n<p>Two faults are common. Sheets pulled in too tight on a reach make the boat heel and slow down, even though the sail looks full and quiet. Sheets eased too far let the sail flap, which costs speed and wears the cloth. On a broad reach or a run, also check that the boom is not pressing against the shrouds (the wires that hold the mast up from the sides).</p>\n</section>\n<section id=\"tacking-gybing\">\n<h2>Tacking and gybing</h2>\n<p>To change from one tack to the other, you turn either the bow or the stern through the wind.</p>\n<p><b>Tacking</b> means turning the bow through the wind. You use it to make progress upwind, zigzagging from close-hauled on one tack to close-hauled on the other. The headsail sheet is released on the old side and pulled in on the new side. The boom moves only a short way, because the mainsail is already in tight. The helm (the person steering) calls \"Ready about\", the crew answers \"Ready\", and the helm calls \"Tacking\" or \"Lee-oh\" as they turn.</p>\n<p><b>Gybing</b> means turning the stern (the back of the boat) through the wind. You use it when sailing downwind. This time the wind gets behind the mainsail and swings the boom across the whole width of the boat. In a controlled gybe, the helm calls \"Ready to gybe\", the crew pulls the mainsheet in to bring the boom towards the centre, the helm turns, and the mainsheet is eased out again on the new side.</p>\n<aside class=\"note warn\"><b>Watch out</b><p>An accidental gybe happens when you steer too far downwind and the wind catches the back of the mainsail. The boom then slams across with no warning. It can seriously injure anyone in its path and damage the rig. On a run, keep your head below the boom's path, keep the wind a little on the side opposite the boom, and rig a preventer (a line holding the boom forward) when the skipper asks for one.</p></aside>\n</section>\n<section id=\"apparent-wind\">\n<h2>True and apparent wind</h2>\n<p>The true wind is what you feel standing still on the quay. Once the boat moves, its own speed creates a breeze, and the two combine into the apparent wind: the wind you feel on deck and the wind the sails actually use. Sailing upwind, the apparent wind feels stronger and comes from further forward than the true wind. Sailing downwind, it feels lighter. This is why a gentle broad reach can turn into a hard beat when you head up. The wind indicator and the telltales always show the apparent wind.</p>\n</section>\n<section id=\"telltales\">\n<h2>Reading the telltales</h2>\n<p>Telltales are short strips of wool or ribbon on both sides of the headsail, a little back from the luff. They show how the air flows over the sail, and they react well before the sail itself starts to flutter.</p>\n<ul>\n<li><b>Both streaming straight back:</b> the sail is well trimmed. Keep going.</li>\n<li><b>The windward one lifts or spins</b> (on the side the wind comes from): the sail is too far out for your course. Sheet in, or bear away a little.</li>\n<li><b>The leeward one lifts or spins</b> (on the side away from the wind): the sail is in too tight. Ease the sheet, or head up a little.</li>\n</ul>\n<p>Close-hauled, the sheet is already in tight, so you correct with the helm: bear away when the windward telltale lifts, head up when the leeward one does. On a reach, hold your course and trim the sheet. Many mainsails also have telltales on the leech (the back edge). When they stream back, the mainsail is not pulled in too hard.</p>\n</section>\n<section id=\"practise\">\n<h2>Practise it on the water</h2>\n<p>On the Introduction to Yachting course you sail every point of sail, taking turns on the helm and on the sheets until trimming by the telltales becomes a habit. You practise tacking and controlled gybes many times in moderate wind before you do them in a stronger breeze.</p>\n</section>\n\n          <div class=\"art-mobile-course\"><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Introduction to Yachting</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></div>\n        </div>\n        <aside class=\"art-side\" aria-label=\"On this page\"><span class=\"kicker\">On this page</span><ol class=\"toc-list\"><li><a href=\"#wind\">The wind and the no-go zone</a></li><li><a href=\"#points\">The points of sail</a></li><li><a href=\"#trim\">Heading up and bearing away</a></li><li><a href=\"#tacking-gybing\">Tacking and gybing</a></li><li><a href=\"#apparent-wind\">True and apparent wind</a></li><li><a href=\"#telltales\">Reading the telltales</a></li><li><a href=\"#practise\">Practise it on the water</a></li></ol><div class=\"band art-course\"><span class=\"kicker\">Practise it on</span><div class=\"card-title\">Introduction to Yachting</div><p>Learn this on the water with an instructor, in a week living aboard.</p><a class=\"pill pill-primary pill-wide pill-sm\" href=\"/en#courses\">See the courses</a></div></aside>\n      </div>\n    </article>\n    <section class=\"sec\" style=\"margin-top:96px\">\n      <div class=\"sec-head row-head\"><div><span class=\"kicker\">Theory</span><h2 class=\"h2\" style=\"margin-top:12px\">Keep reading</h2></div><div class=\"row-nav\"><a class=\"pill pill-quiet\" href=\"/en/theory\">All theory</a></div></div>\n      <div class=\"hscroll\" tabindex=\"0\" aria-label=\"More theory\"><a class=\"card\" href=\"/en/theory/knots\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1563296291-14f26f10c20f?w=900&q=80&auto=format&fit=crop\" alt=\"A schooner with all sails set\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Beginner</span><span class=\"card-title\">Six knots every crew member uses</span><span class=\"card-meta\">Six sailing knots every crew member needs: bowline, clove hitch, round turn and two half hitches, cleat hitch, figure-of-eight and reef knot, step by step.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/right-of-way\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1605281317010-fe5ffe798166?w=900&q=80&auto=format&fit=crop\" alt=\"A motor yacht crossing open water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Right of way at sea: the rules skippers use daily</span><span class=\"card-meta\">The COLREGs a yacht skipper uses daily: lookout, safe speed, risk of collision, give-way rules for sail and power, overtaking, motorsailing and channels.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/navigation-lights\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1534447677768-be436bb09401?w=900&q=80&auto=format&fit=crop\" alt=\"A yacht under a starry night sky\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Navigation lights and day shapes</span><span class=\"card-meta\">Masthead, side and stern lights, tricolour, anchor light and day shapes under COLREG Part C, plus how to read fishing boats, tows and ships at night.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/med-mooring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1570077188670-e3a8d69ac5ff?w=900&q=80&auto=format&fit=crop\" alt=\"A harbour town lit at dusk above the sea\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Mediterranean mooring, step by step</span><span class=\"card-meta\">How to moor stern-to in the Mediterranean with lazy lines or your own anchor: crew briefing, prop walk, the approach, crossed anchors and leaving.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/anchoring\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1506929562872-bb421503ef21?w=900&q=80&auto=format&fit=crop\" alt=\"Boats anchored in a turquoise cove\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Anchoring: the spot, the scope, the hold</span><span class=\"card-meta\">How to anchor a yacht: choosing a sheltered bay with good holding, how much chain to use, setting the anchor, checking it holds and taking shore lines.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a><a class=\"card\" href=\"/en/theory/weather\"><div class=\"photo\"><div class=\"clip\"><img src=\"https://images.unsplash.com/photo-1500375592092-40eb2168fd21?w=900&q=80&auto=format&fit=crop\" alt=\"A wave breaking in clear water\" loading=\"lazy\"></div></div><div class=\"card-body\"><span class=\"lvl\">Bareboat skipper</span><span class=\"card-title\">Reading the weather: Beaufort, forecasts, meltemi</span><span class=\"card-meta\">Learn the Beaufort scale, where to get Mediterranean sailing forecasts, how to read gusts, and how the meltemi, sirocco and bora affect a 40 ft yacht.</span><div class=\"facts\"><span class=\"fact\"><svg class=\"i\"><use href=\"#i-clip\"/></svg>6 min read</span></div></div></a></div>\n    </section>\n  ", "footer": "<footer class=\"site-foot\">\n    <div class=\"foot-row\">\n      <span class=\"meta\">Ocean Way · Layout prototype. Prices, dates and people are sample content. Photos via Unsplash.</span>\n      <nav class=\"foot-links\"><a href=\"#\">About</a><a href=\"#\">Telegram</a><a href=\"#\">Privacy</a></nav>\n    </div>\n  </footer>", "scripts": ["\nconst root = document.documentElement;\ndocument.getElementById('themeBtn').addEventListener('click', () => { if (root.dataset.theme === 'night') delete root.dataset.theme; else root.dataset.theme = 'night'; });\nif (new URLSearchParams(location.search).get('theme') === 'night') root.dataset.theme = 'night';\n(() => {\n  const links = [...document.querySelectorAll('.art-side .toc-list a')]; if (!links.length) return;\n  const secs = links.map((a) => document.getElementById(a.getAttribute('href').slice(1)));\n  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) links.forEach((a, i) => a.classList.toggle('on', secs[i] === e.target)); }), { rootMargin: '-20% 0px -70% 0px' });\n  secs.forEach((s) => s && io.observe(s));\n})();\n"], "tail": "", "styles": "theory"}