{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ocean-way-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "prototypes",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3200",
        "--directory",
        "prototypes"
      ],
      "port": 3200
    },
    {
      "name": "ocean-way-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "-p",
        "3101"
      ],
      "port": 3101
    }
  ]
}
